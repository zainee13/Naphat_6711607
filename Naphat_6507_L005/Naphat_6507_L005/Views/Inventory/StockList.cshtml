@model List<Naphat_6507_L005.ViewModels.StockItemViewModel>
@{
    ViewData["Title"] = "รายการสต็อก";
    Layout = "_Layout";

    var bookings = ViewBag.ActiveBookings as List<(string BookingId, string Text)> ?? new();
    var filter = ViewBag.FilterBookingId as string;
    ViewData["ReturnTo"] = "StockList";
    ViewData["FilterBookingId"] = filter;
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1><span class="material-symbols-outlined align-middle me-2" style="color:#8b5cf6;">list_alt</span>รายการสต็อก</h1>
            <p>กรอกจำนวนแล้วกดรับเข้าหรือเบิกออกในแถวได้เลย</p>
        </div>
        <a asp-controller="Inventory" asp-action="AddStock" asp-route-bookingId="@filter" class="btn btn-sm"
           style="background:#8b5cf6; color:#fff; border:none; border-radius:8px; padding:0.5rem 1rem; font-weight:600;">
            <span class="material-symbols-outlined align-middle me-1" style="font-size:0.9rem;">add</span> เพิ่มสินค้า
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="section-card">
    <div class="section-card-header">
        <h2><span class="material-symbols-outlined" style="color:#8b5cf6;">inventory_2</span> สินค้าทั้งหมด (@Model.Count)</h2>
        <!-- กรองตามการจอง -->
        <form asp-controller="Inventory" asp-action="StockList" method="get" class="d-flex gap-2">
            <select name="bookingId" class="form-select form-select-sm" style="width:auto; border-radius:8px;" aria-label="กรองตามการจอง" onchange="this.form.submit()">
                <option value="">ทุกห้อง</option>
                @foreach (var b in bookings)
                {
                    <option value="@b.BookingId" selected="@(b.BookingId == filter)">@b.Text</option>
                }
            </select>
            <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">กรอง</button></noscript>
        </form>
    </div>
    <partial name="_StockTable" model="Model" />
</div>
