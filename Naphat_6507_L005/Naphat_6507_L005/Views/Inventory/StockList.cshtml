@{
    ViewData["Title"] = "รายการสต็อก";
    Layout = "_Layout";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><span class="material-symbols-outlined align-middle me-2" style="color:#8b5cf6;">inventory_2</span>รายการสต็อกสินค้า</h1>
            <p>ตรวจสอบและอัปเดตสต็อกแบบ Real-time</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Inventory" asp-action="AddStock"
               class="btn btn-sm"
               style="background:linear-gradient(135deg,#8b5cf6,#7c3aed); color:#fff; border:none; border-radius:8px; padding:0.5rem 1rem; font-weight:600;">
                <span class="material-symbols-outlined align-middle me-1" style="font-size:0.9rem;">add</span>
                เพิ่มสินค้า
            </a>
        </div>
    </div>
</div>

<!-- Filter -->
<div class="filter-card mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small fw-semibold">ค้นหาสินค้า</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><span class="material-symbols-outlined" style="font-size:0.9rem;">search</span></span>
                <input type="text" class="form-control" placeholder="ชื่อสินค้า หรือรหัส..." />
            </div>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-semibold">ห้อง</label>
            <select class="form-select form-select-sm">
                <option>ทั้งหมด</option>
                <option>BN-A01</option><option>WN-B12</option><option>LC-C05</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-semibold">สถานะ</label>
            <select class="form-select form-select-sm">
                <option>ทั้งหมด</option>
                <option>ปกติ</option><option>ต่ำ</option><option>วิกฤต</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <button class="btn btn-sm w-100" style="background:#8b5cf6; color:#fff; border:none; border-radius:8px;">กรอง</button>
        </div>
    </div>
</div>

<div class="section-card">
    <div class="table-responsive">
        <table class="table-custom w-100">
            <thead>
                <tr>
                    <th>รหัสสินค้า</th>
                    <th>ชื่อสินค้า</th>
                    <th>ห้อง</th>
                    <th>ประเภท</th>
                    <th>คงเหลือ</th>
                    <th>ต่ำสุด</th>
                    <th>สถานะ</th>
                    <th>อัปเดตล่าสุด</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in new[] {
                    ("PRD-0001","iPhone 15 Pro Max","BN-A01","อิเล็กทรอนิกส์","250","50","ปกติ","normal","13 ก.ย. 11:00"),
                    ("PRD-0002","ข้าวสารถุง 5 กก.","LC-C05","อาหาร","1,200","200","ปกติ","normal","13 ก.ย. 09:30"),
                    ("PRD-0003","น้ำมันเครื่องยนต์","WN-B12","อุตสาหกรรม","85","100","สต็อกต่ำ","low-stock","13 ก.ย. 08:00"),
                    ("PRD-0004","เสื้อผ้าแฟชั่น","BN-A07","สินค้าทั่วไป","450","80","ปกติ","normal","12 ก.ย. 16:45"),
                    ("PRD-0005","ยางรถยนต์","LK-D03","ยานยนต์","12","50","วิกฤต","critical","12 ก.ย. 15:00"),
                    ("PRD-0006","ตู้เย็น LG","BN-A01","เครื่องใช้ไฟฟ้า","68","30","ปกติ","normal","12 ก.ย. 14:30"),
                    ("PRD-0007","กล่องกระดาษ","WN-B12","บรรจุภัณฑ์","18","100","วิกฤต","critical","11 ก.ย. 17:00"),
                    ("PRD-0008","อาหารทะเลแช่แข็ง","LC-C05","อาหาร","340","100","ปกติ","normal","11 ก.ย. 10:00"),
                })
                {
                    <tr>
                        <td><span class="fw-semibold" style="color:#8b5cf6; font-size:0.78rem;">@item.Item1</span></td>
                        <td style="font-size:0.875rem; font-weight:500;">@item.Item2</td>
                        <td><span class="badge" style="background:#f3e8ff; color:#7c3aed; font-size:0.72rem;">@item.Item3</span></td>
                        <td style="font-size:0.78rem; color:#6c757d;">@item.Item4</td>
                        <td>
                            <span class="fw-bold" style="color:@(item.Item8=="critical"?"#ef4444": item.Item8=="low-stock"?"#f59e0b":"#374151");">
                                @item.Item5
                            </span>
                        </td>
                        <td style="font-size:0.82rem; color:#9ca3af;">@item.Item6</td>
                        <td><span class="badge-status badge-@item.Item8">@item.Item7</span></td>
                        <td style="font-size:0.72rem; color:#9ca3af;">@item.Item9</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm" style="background:#f3e8ff; color:#7c3aed; border:none; border-radius:6px; font-size:0.7rem;"
                                        onclick="alert('แก้ไขสินค้า @item.Item1')">
                                    <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">edit</span>
                                </button>
                                <button class="btn btn-sm" style="background:#eff6ff; color:#1d4ed8; border:none; border-radius:6px; font-size:0.7rem;"
                                        onclick="alert('เพิ่มสต็อก @item.Item1')">
                                    <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">add</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
