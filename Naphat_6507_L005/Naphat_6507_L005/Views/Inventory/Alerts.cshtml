@{
    ViewData["Title"] = "แจ้งเตือนสต็อกต่ำ";
    Layout = "_Layout";
}

<div class="page-header">
    <h1><span class="material-symbols-outlined align-middle me-2" style="color:#f59e0b;">notification_important</span>แจ้งเตือนสต็อกต่ำ</h1>
    <p>สินค้าที่ต้องเติมสต็อกโดยด่วน</p>
</div>

<!-- Critical Alert -->
<div class="p-4 mb-4" style="background:linear-gradient(135deg,#fef2f2,#fff5f5); border:1px solid #fecaca; border-radius:12px; display:flex; align-items:center; gap:1rem;">
    <span class="material-symbols-outlined" style="font-size:2rem; color:#ef4444;">emergency</span>
    <div>
        <div class="fw-bold" style="color:#991b1b; font-size:1rem;">⚠️ สินค้า 3 รายการ อยู่ในระดับวิกฤต!</div>
        <div style="font-size:0.82rem; color:#b91c1c;">ต้องเติมสต็อกภายใน 24 ชั่วโมง เพื่อไม่ให้กระทบการบริการลูกค้า</div>
    </div>
</div>

<!-- Critical Items -->
<div class="section-card mb-4">
    <div class="section-card-header">
        <h2 style="color:#ef4444;"><span class="material-symbols-outlined">emergency</span> วิกฤต (ต้องเร่งดำเนินการ)</h2>
        <span class="badge rounded-pill" style="background:#fee2e2; color:#991b1b; padding:0.35rem 0.75rem; font-size:0.75rem;">3 รายการ</span>
    </div>
    <div class="row g-3">
        @foreach (var c in new[] {
            ("PRD-0005","ยางรถยนต์","LK-D03","12","50","24%"),
            ("PRD-0007","กล่องกระดาษ A4","WN-B12","18","100","18%"),
            ("PRD-0022","ถุงมือยาง","BN-A01","5","30","17%"),
        })
        {
            <div class="col-12 col-md-4">
                <div style="background:#fff5f5; border:1.5px solid #fca5a5; border-radius:12px; padding:1.25rem;">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-semibold" style="font-size:0.78rem; color:#ef4444;">@c.Item1</span>
                        <span class="badge-status badge-critical">วิกฤต</span>
                    </div>
                    <div class="fw-bold mb-1" style="color:#14213d;">@c.Item2</div>
                    <div style="font-size:0.78rem; color:#6c757d; margin-bottom:0.75rem;">
                        ห้อง: @c.Item3
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span style="font-size:0.75rem; color:#6c757d;">คงเหลือ / ขั้นต่ำ</span>
                        <span style="font-size:0.78rem; font-weight:700; color:#ef4444;">@c.Item4 / @c.Item5</span>
                    </div>
                    <div style="height:6px; background:#fee2e2; border-radius:3px; margin-bottom:0.75rem; overflow:hidden;">
                        <div style="width:@c.Item6; height:100%; background:#ef4444; border-radius:3px;"></div>
                    </div>
                    <button class="btn btn-sm w-100" style="background:#ef4444; color:#fff; border:none; border-radius:8px; font-size:0.78rem; font-weight:600;"
                            onclick="alert('สั่งเติมสต็อก: @c.Item2')">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">add_shopping_cart</span>
                        สั่งเติมสต็อก
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Low Stock Items -->
<div class="section-card">
    <div class="section-card-header">
        <h2 style="color:#f59e0b;"><span class="material-symbols-outlined">warning</span> สต็อกต่ำ (ควรเติมเร็วๆ นี้)</h2>
        <span class="badge rounded-pill" style="background:#fef3c7; color:#92400e; padding:0.35rem 0.75rem; font-size:0.75rem;">14 รายการ</span>
    </div>
    <div class="table-responsive">
        <table class="table-custom w-100">
            <thead>
                <tr><th>รหัส</th><th>ชื่อสินค้า</th><th>ห้อง</th><th>คงเหลือ</th><th>ขั้นต่ำ</th><th>%</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in new[] {
                    ("PRD-0003","น้ำมันเครื่อง","WN-B12","85","100","85%"),
                    ("PRD-0011","ถุงบรรจุ","BN-A07","45","80","56%"),
                    ("PRD-0019","กระดาษห่อสินค้า","LC-C05","60","100","60%"),
                    ("PRD-0031","เชือกรัด","BN-A01","20","50","40%"),
                    ("PRD-0045","สก็อตเทป","WN-B12","35","80","44%"),
                })
                {
                    var pct = int.Parse(item.Item4) * 100 / int.Parse(item.Item5);
                    <tr>
                        <td><span style="font-size:0.78rem; color:#f59e0b; font-weight:600;">@item.Item1</span></td>
                        <td style="font-size:0.875rem;">@item.Item2</td>
                        <td><span class="badge" style="background:#fef3c7; color:#92400e; font-size:0.72rem;">@item.Item3</span></td>
                        <td class="fw-bold" style="color:#f59e0b;">@item.Item4</td>
                        <td style="color:#9ca3af; font-size:0.82rem;">@item.Item5</td>
                        <td style="width:100px;">
                            <div style="height:6px; background:#f3f4f6; border-radius:3px; overflow:hidden;">
                                <div style="width:@item.Item6; height:100%; background:#f59e0b; border-radius:3px;"></div>
                            </div>
                        </td>
                        <td>
                            <button class="btn btn-sm" style="background:#fef3c7; color:#92400e; border:none; border-radius:6px; font-size:0.72rem;"
                                    onclick="alert('สั่งเติมสต็อก: @item.Item2')">
                                เติมสต็อก
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
