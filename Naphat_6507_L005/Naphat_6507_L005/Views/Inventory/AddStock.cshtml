@model Naphat_6507_L005.ViewModels.StockFormViewModel
@{
    bool isNew = Model.StockId == 0;
    ViewData["Title"] = isNew ? "เพิ่มสินค้า" : "แก้ไขสินค้า";
    Layout = "_Layout";

    var bookings = ViewBag.ActiveBookings as List<(string BookingId, string Text)> ?? new();
}

<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Inventory" asp-action="StockList" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;">
            <span class="material-symbols-outlined align-middle" style="font-size:1rem;">arrow_back</span> ย้อนกลับ
        </a>
        <h1 class="h3 mb-0">
            <span class="material-symbols-outlined align-middle me-2" style="color:#8b5cf6;">@(isNew ? "add_box" : "edit_note")</span>
            @(isNew ? "เพิ่มสินค้า" : "แก้ไขสินค้า " + Model.ItemName)
        </h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="section-card p-4">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
            }

            <form asp-controller="Inventory" asp-action="AddStock" method="post">
                <input type="hidden" asp-for="StockId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="BookingId">ห้อง / การจอง *</label>
                    <select class="form-select" asp-for="BookingId" required>
                        <option value="">เลือกการจองที่ใช้งานอยู่</option>
                        @foreach (var b in bookings)
                        {
                            <option value="@b.BookingId">@b.Text</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="ItemName">ชื่อสินค้า *</label>
                    <input type="text" class="form-control" asp-for="ItemName" maxlength="200" required />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="Category">หมวดหมู่</label>
                        <input type="text" class="form-control" asp-for="Category" maxlength="100" placeholder="เช่น อาหารแห้ง, อะไหล่" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="Unit">หน่วย</label>
                        <input type="text" class="form-control" asp-for="Unit" maxlength="50" placeholder="เช่น กล่อง, พาเลท, ชิ้น" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="Quantity">@(isNew ? "จำนวนเริ่มต้น" : "จำนวนที่นับได้จริง") *</label>
                        <input type="number" class="form-control" asp-for="Quantity" min="0" step="1" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="MinQuantity">จำนวนขั้นต่ำ (แจ้งเตือน) *</label>
                        <input type="number" class="form-control" asp-for="MinQuantity" min="0" step="1" required />
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 pt-2 border-top">
                    <button type="submit" class="btn flex-fill" style="background:#8b5cf6; color:#fff; border:none; border-radius:10px; padding:0.6rem; font-weight:600;">
                        <span class="material-symbols-outlined align-middle me-1" style="font-size:1.1rem;">save</span> @(isNew ? "เพิ่มสินค้า" : "บันทึกการแก้ไข")
                    </button>
                    <a asp-controller="Inventory" asp-action="StockList" class="btn btn-outline-secondary" style="border-radius:10px; padding:0.6rem 1.25rem;">ยกเลิก</a>
                </div>
            </form>
        </div>
    </div>
</div>
