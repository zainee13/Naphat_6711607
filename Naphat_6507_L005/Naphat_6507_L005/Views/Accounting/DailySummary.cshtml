@model List<Naphat_6507_L005.ViewModels.DailySummaryRowViewModel>
@{
    ViewData["Title"] = "สรุปรายรับ";
    Layout = "_Layout";

    // ยอดรวมทั้งช่วงส่งมาจาก AccountingController.DailySummary
    decimal totalRent = ViewBag.TotalRent;
    decimal totalDeposit = ViewBag.TotalDeposit;
    decimal totalRefund = ViewBag.TotalRefund;
    decimal totalNet = ViewBag.TotalNet;
    int totalCount = ViewBag.TotalCount;
}

<div class="page-header">
    <div>
        <h1><span class="material-symbols-outlined align-middle me-2" style="color:#10b981;">bar_chart</span>สรุปรายรับ</h1>
        <p>รายรับจากการชำระที่อนุมัติแล้ว หักการคืนเงิน ช่วง @ViewBag.RangeText</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<!-- เลือกช่วงวันที่ -->
<form asp-controller="Accounting" asp-action="DailySummary" method="get" class="section-card p-3 mb-4 d-flex flex-wrap align-items-end gap-2">
    <div>
        <label class="form-label fw-semibold mb-1" style="font-size:0.85rem;" for="from">ตั้งแต่วันที่</label>
        <input type="date" class="form-control form-control-sm" id="from" name="from" value="@ViewBag.From" />
    </div>
    <div>
        <label class="form-label fw-semibold mb-1" style="font-size:0.85rem;" for="to">ถึงวันที่</label>
        <input type="date" class="form-control form-control-sm" id="to" name="to" value="@ViewBag.To" />
    </div>
    <button type="submit" class="btn btn-sm" style="background:#10b981; color:#fff; border:none; border-radius:8px; padding:0.4rem 1rem; font-weight:600;">ดูสรุป</button>
</form>

<!-- ยอดรวมทั้งช่วง -->
<div class="row g-3 mb-4">
    @foreach (var s in new[] {
        ("home_work", "ค่าเช่า", "฿" + totalRent.ToString("N0"), "#3b82f6"),
        ("savings", "เงินประกัน", "฿" + totalDeposit.ToString("N0"), "#8b5cf6"),
        ("currency_exchange", "คืนเงิน", "−฿" + totalRefund.ToString("N0"), "#ef4444"),
        ("account_balance", "สุทธิ (" + totalCount + " รายการ)", "฿" + totalNet.ToString("N0"), "#10b981"),
    })
    {
        <div class="col-6 col-lg-3">
            <div class="kpi-card" style="padding:1rem;">
                <div class="d-flex align-items-center gap-3">
                    <span class="material-symbols-outlined" style="font-size:1.75rem; color:@s.Item4;">@s.Item1</span>
                    <div>
                        <div class="kpi-value" style="font-size:1.3rem;">@s.Item3</div>
                        <div class="kpi-label" style="font-size:0.72rem;">@s.Item2</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ตารางรายวัน -->
<div class="section-card">
    <div class="section-card-header">
        <h2><span class="material-symbols-outlined" style="color:#10b981;">calendar_month</span> รายวัน</h2>
    </div>
    <div class="table-responsive">
        <table class="table-custom w-100">
            <thead>
                <tr><th>วันที่</th><th class="text-end">รายการ</th><th class="text-end">ค่าเช่า</th><th class="text-end">เงินประกัน</th><th class="text-end">คืนเงิน</th><th class="text-end">สุทธิ</th></tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var d in Model)
                    {
                        <tr style="font-size:0.875rem;">
                            <td>@d.DateText</td>
                            <td class="text-end">@d.Count</td>
                            <td class="text-end">฿@d.Rent.ToString("N0")</td>
                            <td class="text-end">฿@d.Deposit.ToString("N0")</td>
                            <td class="text-end" style="color:#b91c1c;">@(d.Refund > 0 ? "−฿" + d.Refund.ToString("N0") : "-")</td>
                            <td class="text-end fw-semibold">฿@d.Net.ToString("N0")</td>
                        </tr>
                    }
                    <tr style="font-size:0.875rem; font-weight:700; border-top:2px solid #374151;">
                        <td>รวม</td>
                        <td class="text-end">@totalCount</td>
                        <td class="text-end">฿@totalRent.ToString("N0")</td>
                        <td class="text-end">฿@totalDeposit.ToString("N0")</td>
                        <td class="text-end" style="color:#b91c1c;">@(totalRefund > 0 ? "−฿" + totalRefund.ToString("N0") : "-")</td>
                        <td class="text-end">฿@totalNet.ToString("N0")</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="6" style="text-align:center; color:#9ca3af; padding:2rem;">ไม่มีรายรับหรือการคืนเงินในช่วงนี้</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
