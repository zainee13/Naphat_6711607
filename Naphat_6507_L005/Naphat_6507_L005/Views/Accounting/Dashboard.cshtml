@{
    ViewData["Title"] = "ภาพรวมบัญชี";
    Layout = "_Layout";
}

<div class="page-header">
    <h1><span class="material-symbols-outlined align-middle me-2" style="color:#10b981;">dashboard</span>ภาพรวมบัญชีการเงิน</h1>
    <p>ตรวจสอบยอดเงินและหลักฐานการชำระเงินจากลูกค้า</p>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    @foreach (var kpi in new[] {
        ("payments","รายรับวันนี้","฿185,000","↑ 12%","#10b981","#d1fae5","#065f46"),
        ("receipt_long","รอตรวจสอบ","8 รายการ","ใหม่ 3 รายการ","#f59e0b","#fef3c7","#92400e"),
        ("task_alt","ออก Invoice แล้ว","24","เดือนนี้","#3b82f6","#dbeafe","#1e40af"),
        ("currency_exchange","รอคืนเงิน","3 รายการ","฿45,000","#ef4444","#fee2e2","#991b1b"),
    })
    {
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:@kpi.Item5;">
                    <span class="material-symbols-outlined">@kpi.Item1</span>
                </div>
                <div class="kpi-value">@kpi.Item3</div>
                <div class="kpi-label">@kpi.Item2</div>
                <div class="kpi-change" style="color:@kpi.Item5;">@kpi.Item4</div>
            </div>
        </div>
    }
</div>

<!-- Pending Payments -->
<div class="section-card">
    <div class="section-card-header">
        <h2><span class="material-symbols-outlined" style="color:#10b981;">pending_actions</span> หลักฐานการชำระเงินรอตรวจสอบ</h2>
        <span class="badge rounded-pill" style="background:#fef3c7; color:#92400e; font-size:0.75rem; padding:0.4rem 0.8rem;">8 รายการ</span>
    </div>
    <div class="table-responsive">
        <table class="table-custom w-100">
            <thead>
                <tr>
                    <th>รหัสการจอง</th>
                    <th>ลูกค้า</th>
                    <th>ห้อง</th>
                    <th>ยอดเงิน</th>
                    <th>วิธีชำระ</th>
                    <th>แนบสลิป</th>
                    <th>วันที่แจ้ง</th>
                    <th>ดำเนินการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in new[] {
                    ("BK-2026-002","นภัส นาวาหัสดินกุล","WN-B12","฿642,000","โอนธนาคาร","✅","13 ก.ย. 2569 09:15"),
                    ("BK-2026-005","บริษัท ABC จำกัด","BN-A07","฿90,000","QR Code","✅","13 ก.ย. 2569 10:40"),
                    ("BK-2026-007","คุณสมชาย","LC-C05","฿240,000","โอนธนาคาร","✅","13 ก.ย. 2569 11:20"),
                    ("BK-2026-009","ร้าน XYZ","BN-A01","฿200,000","บัตรเครดิต","✅","13 ก.ย. 2569 12:05"),
                })
                {
                    <tr>
                        <td><span class="fw-semibold" style="color:#3b82f6; font-size:0.82rem;">@p.Item1</span></td>
                        <td style="font-size:0.875rem;">@p.Item2</td>
                        <td>
                            <span class="badge" style="background:#eff6ff; color:#1d4ed8; font-size:0.72rem;">@p.Item3</span>
                        </td>
                        <td class="fw-bold">@p.Item4</td>
                        <td style="font-size:0.82rem; color:#6c757d;">@p.Item5</td>
                        <td style="text-align:center;">
                            <button class="btn btn-sm" style="background:#f0fdf4; color:#065f46; border:1px solid #bbf7d0; border-radius:6px; font-size:0.72rem; padding:0.2rem 0.5rem;">
                                <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">visibility</span> ดูสลิป
                            </button>
                        </td>
                        <td style="font-size:0.78rem; color:#6c757d;">@p.Item7</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm" style="background:#d1fae5; color:#065f46; border:none; border-radius:6px; font-size:0.72rem;"
                                        onclick="alert('อนุมัติการชำระเงิน @p.Item1 แล้ว')">
                                    ✓ อนุมัติ
                                </button>
                                <button class="btn btn-sm" style="background:#fee2e2; color:#991b1b; border:none; border-radius:6px; font-size:0.72rem;"
                                        onclick="alert('ปฏิเสธ @p.Item1')">
                                    ✗ ปฏิเสธ
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
