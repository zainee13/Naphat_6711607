@model List<Naphat_6507_L005.ViewModels.InvoiceListItemViewModel>
@{
    ViewData["Title"] = "ใบแจ้งหนี้ / ใบเสร็จ";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h1><span class="material-symbols-outlined align-middle me-2" style="color:#10b981;">receipt_long</span>ใบแจ้งหนี้ / ใบเสร็จ</h1>
        <p>เอกสารของการชำระที่อนุมัติแล้ว เปิดดูและพิมพ์ได้</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="section-card">
    <div class="section-card-header">
        <h2><span class="material-symbols-outlined" style="color:#10b981;">description</span> การชำระที่อนุมัติแล้ว</h2>
    </div>
    <div class="table-responsive">
        <table class="table-custom w-100">
            <thead>
                <tr><th>การชำระ</th><th>การจอง / ห้อง</th><th>ลูกค้า</th><th>ยอด</th><th>อนุมัติเมื่อ</th><th>ใบแจ้งหนี้</th><th>ใบเสร็จ</th><th>ดำเนินการ</th></tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var row in Model)
                    {
                        <tr>
                            <td class="fw-semibold" style="font-size:0.85rem; color:#10b981;">@row.PaymentNo</td>
                            <td style="font-size:0.85rem;">@row.BookingId<br /><span style="color:#6c757d; font-size:0.78rem;">ห้อง @row.RoomId</span></td>
                            <td style="font-size:0.85rem;">@row.CustomerName</td>
                            <td class="fw-semibold" style="font-size:0.85rem;">฿@row.Amount.ToString("N0")</td>
                            <td style="font-size:0.78rem; color:#6c757d;">@row.ApprovedDate</td>
                            <td style="font-size:0.82rem;">@(row.InvoiceId ?? "-")</td>
                            <td style="font-size:0.82rem;">@(row.ReceiptId ?? "-")</td>
                            <td>
                                @if (row.ReceiptId != null)
                                {
                                    <a class="btn btn-sm" style="background:#ecfdf5; color:#065f46; border:none; border-radius:6px; font-size:0.78rem;"
                                       asp-controller="Accounting" asp-action="Document" asp-route-id="@row.ReceiptId" target="_blank">
                                        <span class="material-symbols-outlined align-middle" style="font-size:0.9rem;">print</span> ดูเอกสาร
                                    </a>
                                }
                                else
                                {
                                    <form asp-controller="Accounting" asp-action="IssueDocuments" asp-route-id="@row.PaymentId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm" style="background:#fef3c7; color:#92400e; border:none; border-radius:6px; font-size:0.78rem;">
                                            <span class="material-symbols-outlined align-middle" style="font-size:0.9rem;">note_add</span> ออกเอกสาร
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" style="text-align:center; color:#9ca3af; padding:2rem;">ยังไม่มีการชำระที่อนุมัติ</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
