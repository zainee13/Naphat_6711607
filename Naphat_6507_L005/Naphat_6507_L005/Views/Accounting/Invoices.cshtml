@{
    ViewData["Title"] = "ใบแจ้งหนี้ / ใบเสร็จ";
    Layout = "_Layout";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><span class="material-symbols-outlined align-middle me-2" style="color:#10b981;">receipt_long</span>ใบแจ้งหนี้ / ใบเสร็จรับเงิน</h1>
            <p>ออกเอกสารทางการเงินให้กับลูกค้า</p>
        </div>
        <button class="btn btn-sm"
                style="background:linear-gradient(135deg,#10b981,#059669); color:#fff; border:none; border-radius:8px; padding:0.5rem 1rem; font-weight:600;"
                onclick="alert('เปิดฟอร์มออก Invoice ใหม่')">
            <span class="material-symbols-outlined align-middle me-1" style="font-size:0.9rem;">add</span>
            ออก Invoice ใหม่
        </button>
    </div>
</div>

<!-- Tabs -->
<div class="section-card">
    <ul class="nav nav-pills mb-3" style="gap:0.5rem;">
        <li class="nav-item">
            <button class="nav-link active" onclick="switchTab('invoice')"
                    style="background:linear-gradient(135deg,#10b981,#059669); color:#fff; border-radius:8px;">
                ใบแจ้งหนี้ (Invoice)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" onclick="switchTab('receipt')"
                    style="background:#f3f4f6; color:#374151; border-radius:8px;">
                ใบเสร็จรับเงิน (Receipt)
            </button>
        </li>
    </ul>

    <div id="tab_invoice">
        <div class="table-responsive">
            <table class="table-custom w-100">
                <thead>
                    <tr>
                        <th>เลข Invoice</th>
                        <th>ลูกค้า</th>
                        <th>การจอง</th>
                        <th>ยอด</th>
                        <th>วันที่ออก</th>
                        <th>ครบกำหนด</th>
                        <th>สถานะ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in new[] {
                        ("INV-2026-024","นภัส นาวาหัสดินกุล","BK-2026-002","฿642,000","1 ก.ย. 2569","16 ก.ย. 2569","รอชำระ","pending"),
                        ("INV-2026-023","บริษัท ABC จำกัด","BK-2026-005","฿90,000","28 ส.ค. 2569","7 ก.ย. 2569","ชำระแล้ว","paid"),
                        ("INV-2026-020","คุณสมชาย ใจดี","BK-2026-007","฿240,000","20 ส.ค. 2569","30 ส.ค. 2569","ชำระแล้ว","paid"),
                        ("INV-2026-018","ร้าน XYZ","BK-2026-009","฿200,000","15 ส.ค. 2569","25 ส.ค. 2569","เกินกำหนด","cancelled"),
                    })
                    {
                        <tr>
                            <td><span class="fw-semibold" style="color:#10b981; font-size:0.82rem;">@inv.Item1</span></td>
                            <td style="font-size:0.875rem;">@inv.Item2</td>
                            <td style="font-size:0.82rem; color:#6c757d;">@inv.Item3</td>
                            <td class="fw-bold">@inv.Item4</td>
                            <td style="font-size:0.82rem; color:#6c757d;">@inv.Item5</td>
                            <td style="font-size:0.82rem; color:@(inv.Item8=="cancelled"?"#ef4444":"#374151");">@inv.Item6</td>
                            <td><span class="badge-status badge-@inv.Item8">@inv.Item7</span></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm" style="background:#f0fdf4; color:#065f46; border:1px solid #bbf7d0; border-radius:6px; font-size:0.7rem;"
                                            onclick="alert('พิมพ์ / ดาวน์โหลด @inv.Item1')">
                                        <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">print</span>
                                    </button>
                                    <button class="btn btn-sm" style="background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; border-radius:6px; font-size:0.7rem;"
                                            onclick="alert('ส่งอีเมลหา @inv.Item2')">
                                        <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">mail</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="tab_receipt" class="d-none">
        <div class="table-responsive">
            <table class="table-custom w-100">
                <thead>
                    <tr>
                        <th>เลข Receipt</th>
                        <th>ลูกค้า</th>
                        <th>Invoice อ้างอิง</th>
                        <th>ยอด</th>
                        <th>วันที่ออก</th>
                        <th>วิธีชำระ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rec in new[] {
                        ("REC-2026-019","บริษัท ABC จำกัด","INV-2026-023","฿90,000","7 ก.ย. 2569","QR Code"),
                        ("REC-2026-016","คุณสมชาย ใจดี","INV-2026-020","฿240,000","30 ส.ค. 2569","โอนธนาคาร"),
                    })
                    {
                        <tr>
                            <td><span class="fw-semibold" style="color:#10b981; font-size:0.82rem;">@rec.Item1</span></td>
                            <td style="font-size:0.875rem;">@rec.Item2</td>
                            <td style="font-size:0.82rem; color:#6c757d;">@rec.Item3</td>
                            <td class="fw-bold">@rec.Item4</td>
                            <td style="font-size:0.82rem; color:#6c757d;">@rec.Item5</td>
                            <td style="font-size:0.82rem;">@rec.Item6</td>
                            <td>
                                <button class="btn btn-sm" style="background:#f0fdf4; color:#065f46; border:1px solid #bbf7d0; border-radius:6px; font-size:0.7rem;"
                                        onclick="alert('พิมพ์ / ดาวน์โหลด @rec.Item1')">
                                    <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">print</span>
                                    พิมพ์
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
function switchTab(tab) {
    document.getElementById('tab_invoice').classList.add('d-none');
    document.getElementById('tab_receipt').classList.add('d-none');
    document.getElementById('tab_' + tab).classList.remove('d-none');
}
</script>
}
