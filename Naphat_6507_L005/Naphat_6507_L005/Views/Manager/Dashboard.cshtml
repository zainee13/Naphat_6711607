@model List<Naphat_6507_L005.ViewModels.ManagerRoomViewModel>
@using Naphat_6507_L005.ViewModels
@{
    ViewData["Title"] = "ภาพรวมธุรกิจ";
    Layout = "_Layout";

    // ตัวเลขทั้งหมดส่งมาจาก ManagerController.Dashboard
    decimal rentThisMonth = ViewBag.RentThisMonth;
    int usedPercent = ViewBag.UsedPercent;
    int roomUsed = ViewBag.RoomUsed;
    int roomTotal = ViewBag.RoomTotal;
    int newBookings = ViewBag.NewBookings;
    int activeTenants = ViewBag.ActiveTenants;
    var revenue = (List<MonthlyRevenueViewModel>)ViewBag.Revenue;
    var sizeSummary = (List<RoomSizeSummaryViewModel>)ViewBag.SizeSummary;
    var work = (List<PendingWorkViewModel>)ViewBag.Work;
}

@section Styles {
    <link rel="stylesheet" href="~/css/manager.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1><span class="material-symbols-outlined align-middle me-2" style="color:#ef4444;">insights</span>ภาพรวมธุรกิจ</h1>
        <p>รายรับ การใช้ห้อง และงานค้างของทุกฝ่าย (ดูอย่างเดียว)</p>
    </div>
</div>

<!-- ตัวเลขสรุป -->
<div class="row g-3 mb-4">
    @foreach (var s in new[] {
        ("payments", "ค่าเช่าเดือนนี้", "฿" + rentThisMonth.ToString("N0"), (string)ViewBag.RentChangeText, "#10b981"),
        ("meeting_room", "ห้องที่มีผู้ใช้", usedPercent + "%", roomUsed + " จาก " + roomTotal + " ห้อง", "#ef4444"),
        ("event_available", "การจองใหม่เดือนนี้", newBookings.ToString("N0"), "ไม่นับที่ยกเลิก", "#3b82f6"),
        ("groups", "ผู้เช่าที่ใช้งานอยู่", activeTenants.ToString("N0"), "ราย", "#8b5cf6"),
    })
    {
        <div class="col-6 col-lg-3">
            <div class="kpi-card" style="padding:1rem;">
                <div class="d-flex align-items-center gap-3">
                    <span class="material-symbols-outlined" style="font-size:1.75rem; color:@s.Item5;">@s.Item1</span>
                    <div>
                        <div class="kpi-value" style="font-size:1.3rem;">@s.Item3</div>
                        <div class="kpi-label" style="font-size:0.72rem;">@s.Item2</div>
                        <div style="font-size:0.7rem; color:@s.Item5;">@s.Item4</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- งานค้างของแต่ละฝ่าย -->
<div class="section-card mb-4">
    <div class="section-card-header">
        <h2><span class="material-symbols-outlined" style="color:#f59e0b;">pending_actions</span> งานค้างของแต่ละฝ่าย</h2>
    </div>
    <div class="p-3">
        <div class="mg-work">
            @foreach (var w in work)
            {
                <div class="mg-work-item @(w.Count == 0 ? "is-zero" : "")">
                    <span class="material-symbols-outlined" style="color:@w.Color;" aria-hidden="true">@w.Icon</span>
                    <div>
                        <div class="mg-work-count">@w.Count</div>
                        <div class="mg-work-text">@w.Text</div>
                        <div class="mg-work-dept">ฝ่าย@(w.Department)</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- ค่าเช่า 6 เดือนล่าสุด -->
    <div class="col-lg-7">
        <div class="section-card h-100">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined" style="color:#10b981;">bar_chart</span> ค่าเช่า 6 เดือนล่าสุด</h2>
                <a asp-controller="Manager" asp-action="Revenue" style="font-size:0.8rem;">ดูรายงานเต็ม</a>
            </div>
            <div class="p-3">
                <ul class="mg-bars">
                    @foreach (var m in revenue)
                    {
                        <li class="mg-bar-row">
                            <span class="mg-bar-label">@m.MonthText</span>
                            <span class="mg-bar-track"><span class="mg-bar-fill @(m.Rent == 0 ? "is-zero" : "")" style="width:@(m.BarPercent)%;"></span></span>
                            <span class="mg-bar-value">฿@m.Rent.ToString("N0")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- การใช้ห้องตามขนาด -->
    <div class="col-lg-5">
        <div class="section-card h-100">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined" style="color:#ef4444;">warehouse</span> การใช้ห้องตามขนาด</h2>
                <a asp-controller="Manager" asp-action="Rooms" style="font-size:0.8rem;">ดูทุกห้อง</a>
            </div>
            <div class="p-3">
                @foreach (var g in sizeSummary)
                {
                    <div class="mg-size-row">
                        <strong>@g.SizeText</strong>
                        <div class="mg-stack" aria-label="@g.SizeText ว่าง @g.Available ถูกจอง @g.Booked มีผู้เช่า @g.Occupied">
                            <span class="is-occupied" style="width:@(g.Occupied * 100 / g.Total)%;"></span>
                            <span class="is-booked" style="width:@(g.Booked * 100 / g.Total)%;"></span>
                        </div>
                        <span class="mg-size-count">ใช้ @(g.Booked + g.Occupied)/@g.Total (@g.UsedPercent%)</span>
                    </div>
                }
                <ul class="mg-legend mt-3">
                    <li><i class="is-available"></i>ว่าง</li>
                    <li><i class="is-booked"></i>ถูกจอง</li>
                    <li><i class="is-occupied"></i>มีผู้เช่า</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- สัญญาใกล้หมด -->
<div class="section-card">
    <div class="section-card-header">
        <h2><span class="material-symbols-outlined" style="color:#ef4444;">event_busy</span> สัญญาที่จะหมดภายใน 30 วัน</h2>
    </div>
    <div class="table-responsive">
        <table class="table-custom w-100">
            <thead>
                <tr><th>ห้อง</th><th>ผู้เช่า</th><th>การจอง</th><th>หมดสัญญา</th><th>เหลือ</th></tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold" style="font-size:0.875rem;">@r.RoomId</td>
                            <td style="font-size:0.85rem;">@r.TenantName</td>
                            <td style="font-size:0.8rem; color:#6c757d;">@r.BookingId</td>
                            <td style="font-size:0.85rem;">@r.EndDateText</td>
                            <td class="@(r.DaysLeft <= 7 ? "mg-days-soon" : "")" style="font-size:0.85rem;">@(r.DaysLeft < 0 ? "เลยกำหนด " + (-r.DaysLeft) + " วัน" : r.DaysLeft + " วัน")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" style="text-align:center; color:#9ca3af; padding:2rem;">ไม่มีสัญญาที่จะหมดใน 30 วัน</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
