@model List<Naphat_6507_L005.Models.User>
@{
    ViewData["Title"] = "จัดการผู้ใช้";
    Layout = "_Layout";

    // ตัวเลขสรุปและตัวกรองส่งมาจาก AdminController.Users
    var roleText = Naphat_6507_L005.Controllers.AdminController.RoleText;
    var filterRole = ViewBag.FilterRole as string;
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><span class="material-symbols-outlined align-middle me-2" style="color:#06b6d4;">manage_accounts</span>จัดการผู้ใช้งาน</h1>
            <p>เพิ่ม ลบ แก้ไข และกำหนดสิทธิ์ผู้ใช้ในระบบ</p>
        </div>
        <a class="btn btn-sm" asp-controller="Admin" asp-action="AddUser"
           style="background:linear-gradient(135deg,#06b6d4,#0891b2); color:#fff; border:none; border-radius:8px; padding:0.5rem 1rem; font-weight:600;">
            <span class="material-symbols-outlined align-middle me-1" style="font-size:0.9rem;">person_add</span>
            เพิ่มผู้ใช้ใหม่
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<!-- Stats -->
<div class="row g-3 mb-4">
    @foreach (var s in new[] {
        ("people","ผู้ใช้ทั้งหมด",((int)ViewBag.CountAll).ToString("N0"),"ใช้งานอยู่ " + ViewBag.CountActive,"#06b6d4"),
        ("person","ลูกค้า",((int)ViewBag.CountCustomer).ToString("N0"),"บัญชีลูกค้า","#3b82f6"),
        ("groups","พนักงาน",((int)ViewBag.CountStaff).ToString("N0"),"ทุกฝ่าย รวม Admin","#10b981"),
        ("no_accounts","ถูกระงับ",((int)ViewBag.CountInactive).ToString("N0"),"เข้าสู่ระบบไม่ได้","#ef4444"),
    })
    {
        <div class="col-6 col-lg-3">
            <div class="kpi-card" style="padding:1rem;">
                <div class="d-flex align-items-center gap-3">
                    <span class="material-symbols-outlined" style="font-size:1.75rem; color:@s.Item5;">@s.Item1</span>
                    <div>
                        <div class="kpi-value" style="font-size:1.3rem;">@s.Item3</div>
                        <div class="kpi-label" style="font-size:0.72rem;">@s.Item2</div>
                        <div style="font-size:0.7rem; color:@s.Item5;">@s.Item4</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- User Table -->
<div class="section-card">
    <div class="section-card-header">
        <h2><span class="material-symbols-outlined" style="color:#06b6d4;">list_alt</span> รายชื่อผู้ใช้ทั้งหมด</h2>
        <!-- ค้นหา / กรองบทบาท: ฟอร์ม GET ส่งไป AdminController.Users -->
        <form asp-controller="Admin" asp-action="Users" method="get" class="d-flex flex-wrap gap-2">
            <input type="search" name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="ชื่อผู้ใช้ / ชื่อ / อีเมล" aria-label="ค้นหาผู้ใช้" style="width:190px; border-radius:8px;" />
            <select name="role" class="form-select form-select-sm" style="width:auto; border-radius:8px;" aria-label="กรองตามบทบาท">
                <option value="">ทุกบทบาท</option>
                @foreach (var r in roleText)
                {
                    <option value="@r.Key" selected="@(filterRole == r.Key)">@r.Value</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;">ค้นหา</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table-custom w-100">
            <thead>
                <tr><th>ชื่อผู้ใช้</th><th>ชื่อ-นามสกุล</th><th>Role</th><th>อีเมล</th><th>วันที่สร้าง</th><th>สถานะ</th><th>ดำเนินการ</th></tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var user in Model)
                    {
                        var avatarColor = "#06b6d4";
                        var roleColors = new Dictionary<string,string> {
                            {"Customer","#eff6ff|#1d4ed8"}, {"Accounting","#ecfdf5|#065f46"},
                            {"Inventory","#f3e8ff|#7c3aed"}, {"CustomerService","#fef3c7|#92400e"},
                            {"Manager","#fee2e2|#991b1b"}, {"Admin","#cffafe|#0e7490"}
                        };
                        var colorPair = roleColors.ContainsKey(user.Role) ? roleColors[user.Role].Split('|') : new[]{"#f3f4f6","#374151"};
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar" style="background:@avatarColor; color:#fff; width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:700; flex-shrink:0;">
                                        @(user.Username.Length > 0 ? user.Username.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <span class="fw-semibold" style="font-size:0.875rem; color:#06b6d4;">@user.Username</span>
                                </div>
                            </td>
                            <td style="font-size:0.875rem;">@user.Fullname</td>
                            <td>
                                <span class="badge" style="background:@colorPair[0]; color:@colorPair[1]; font-size:0.72rem; border-radius:20px; padding:0.25rem 0.65rem;">
                                    @(roleText.ContainsKey(user.Role) ? roleText[user.Role] : user.Role)
                                </span>
                            </td>
                            <td style="font-size:0.78rem; color:#6c757d;">@(user.Email ?? "-")</td>
                            <td style="font-size:0.75rem; color:#9ca3af;">@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge-status @(user.IsActive == true ? "badge-available" : "badge-occupied")">@(user.IsActive == true ? "ปกติ" : "ระงับ")</span></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a class="btn btn-sm" style="background:#f0fdf4; color:#065f46; border:none; border-radius:6px; font-size:0.7rem; display:inline-flex; align-items:center;"
                                       asp-action="EditUser" asp-controller="Admin" asp-route-id="@user.UserId" title="แก้ไข">
                                        <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">edit</span>
                                    </a>
                                    @* ลบผ่าน POST เท่านั้น (เปิดลิงก์เฉยๆ ลบไม่ได้) *@
                                    <form asp-action="DeleteUser" asp-controller="Admin" asp-route-id="@user.UserId" method="post" class="d-inline"
                                          onsubmit="return confirm('ยืนยันที่จะลบผู้ใช้ @user.Username หรือไม่?');">
                                        <button type="submit" class="btn btn-sm" style="background:#fee2e2; color:#991b1b; border:none; border-radius:6px; font-size:0.7rem; display:inline-flex; align-items:center;" title="ลบ">
                                            <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" style="text-align:center; color:#9ca3af; padding:2rem;">ไม่พบผู้ใช้ที่ตรงกับการค้นหา</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
