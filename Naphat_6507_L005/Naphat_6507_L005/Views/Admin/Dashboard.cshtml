@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="page-header">
    <h1><span class="material-symbols-outlined align-middle me-2" style="color:#06b6d4;">admin_panel_settings</span>ภาพรวมระบบ</h1>
    <p>ดูแลโครงสร้างพื้นฐาน และสถานะเซิร์ฟเวอร์</p>
</div>

<!-- System Status -->
<div class="row g-3 mb-4">
    @foreach (var s in new[] {
        ("cloud_done","Server Status","Online","Uptime 99.98%","#10b981"),
        ("speed","Response Time","142 ms","Normal","#3b82f6"),
        ("people","Active Sessions","23","ผู้ใช้ออนไลน์","#06b6d4"),
        ("database","Database","Healthy","0 Errors","#8b5cf6"),
    })
    {
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:@s.Item5;">
                    <span class="material-symbols-outlined">@s.Item1</span>
                </div>
                <div class="kpi-value" style="font-size:1.25rem;">@s.Item3</div>
                <div class="kpi-label">@s.Item2</div>
                <div class="kpi-change" style="color:@s.Item5;">@s.Item4</div>
            </div>
        </div>
    }
</div>

<div class="row g-4 mb-4">
    <!-- System Health -->
    <div class="col-12 col-lg-5">
        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined" style="color:#06b6d4;">monitor_heart</span> สุขภาพระบบ</h2>
                <span class="badge-status badge-available">ทุกระบบปกติ</span>
            </div>
            @foreach (var svc in new[] {
                ("Web Server","ปกติ","available","#10b981"),
                ("Database","ปกติ","available","#10b981"),
                ("File Storage","ปกติ","available","#10b981"),
                ("Email Service","ปกติ","available","#10b981"),
                ("Payment Gateway","ปกติ","available","#10b981"),
                ("Session Store","ปกติ","available","#10b981"),
            })
            {
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:8px; height:8px; border-radius:50%; background:@svc.Item4;"></div>
                        <span style="font-size:0.85rem;">@svc.Item1</span>
                    </div>
                    <span class="badge-status badge-@svc.Item3" style="font-size:0.7rem;">@svc.Item2</span>
                </div>
            }

            <div class="mt-3">
                <div class="d-flex justify-content-between mb-1">
                    <span style="font-size:0.78rem; color:#6c757d;">CPU Usage</span>
                    <span style="font-size:0.78rem; color:#10b981; font-weight:600;">24%</span>
                </div>
                <div style="height:6px; background:#f3f4f6; border-radius:3px; overflow:hidden; margin-bottom:0.75rem;">
                    <div style="width:24%; height:100%; background:#10b981; border-radius:3px;"></div>
                </div>

                <div class="d-flex justify-content-between mb-1">
                    <span style="font-size:0.78rem; color:#6c757d;">Memory Usage</span>
                    <span style="font-size:0.78rem; color:#3b82f6; font-weight:600;">58%</span>
                </div>
                <div style="height:6px; background:#f3f4f6; border-radius:3px; overflow:hidden; margin-bottom:0.75rem;">
                    <div style="width:58%; height:100%; background:#3b82f6; border-radius:3px;"></div>
                </div>

                <div class="d-flex justify-content-between mb-1">
                    <span style="font-size:0.78rem; color:#6c757d;">Disk Usage</span>
                    <span style="font-size:0.78rem; color:#f59e0b; font-weight:600;">72%</span>
                </div>
                <div style="height:6px; background:#f3f4f6; border-radius:3px; overflow:hidden;">
                    <div style="width:72%; height:100%; background:#f59e0b; border-radius:3px;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Activity Log -->
    <div class="col-12 col-lg-7">
        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined" style="color:#06b6d4;">history</span> Activity Log ล่าสุด</h2>
            </div>
            @foreach (var log in new[] {
                ("นภัส นาวาหัสดินกุล","Customer","Login สำเร็จ","13 ก.ย. 13:37","#3b82f6","success"),
                ("สมหญิง บัญชีดี","Accounting","อนุมัติการชำระเงิน BK-2026-002","13 ก.ย. 13:45","#10b981","success"),
                ("สมชาย คลังสินค้า","Inventory","เพิ่มสต็อก PRD-0981 (120 ชิ้น)","13 ก.ย. 11:00","#8b5cf6","success"),
                ("วรรณิสา บริการ","CS","สร้าง Ticket TK-032","13 ก.ย. 13:00","#f59e0b","info"),
                ("Unknown","—","พยายาม Login ด้วย credentials ผิด 3 ครั้ง","13 ก.ย. 12:50","#ef4444","warning"),
                ("ประยุทธ ผู้จัดการ","Manager","Export PDF Dashboard","13 ก.ย. 12:00","#ef4444","success"),
                ("ผู้ดูแลระบบ","Admin","เพิ่มผู้ใช้ใหม่: inventory2","12 ก.ย. 17:00","#06b6d4","success"),
            })
            {
                <div class="d-flex align-items-start gap-3 py-2 border-bottom">
                    <div class="avatar" style="background:@log.Item5; color:#fff; width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:700; flex-shrink:0;">
                        @(log.Item1.Length > 0 ? log.Item1[0].ToString() : "?")
                    </div>
                    <div class="flex-grow-1">
                        <div style="font-size:0.82rem; font-weight:600; color:#374151;">@log.Item3</div>
                        <div style="font-size:0.72rem; color:#9ca3af;">@log.Item1 • @log.Item2 • @log.Item4</div>
                    </div>
                    <span class="badge" style="font-size:0.65rem; background:@(log.Item6=="warning"?"#fef3c7":log.Item6=="success"?"#d1fae5":"#dbeafe"); color:@(log.Item6=="warning"?"#92400e":log.Item6=="success"?"#065f46":"#1e40af");">
                        @log.Item6
                    </span>
                </div>
            }
        </div>
    </div>
</div>
