@model List<Naphat_6507_L005.ViewModels.PromoListItemViewModel>
@{
    ViewData["Title"] = "โค้ดส่วนลด";
    Layout = "_Layout";

    var statusClass = new Dictionary<string, string>
    {
        { "ใช้งานได้", "badge-available" },
        { "ยังไม่เริ่ม", "badge-pending" },
        { "หมดอายุ", "badge-cancelled" },
        { "ปิดใช้งาน", "badge-occupied" },
    };
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><span class="material-symbols-outlined align-middle me-2" style="color:#06b6d4;">sell</span>โค้ดส่วนลด</h1>
            <p>ลดค่าเช่าเดือนแรกตอนลูกค้าจอง โค้ดที่ใช้งานได้ล่าสุดจะแสดงบนหน้าหลัก</p>
        </div>
        <a class="btn btn-sm" asp-controller="Admin" asp-action="AddPromo"
           style="background:linear-gradient(135deg,#06b6d4,#0891b2); color:#fff; border:none; border-radius:8px; padding:0.5rem 1rem; font-weight:600;">
            <span class="material-symbols-outlined align-middle me-1" style="font-size:0.9rem;">add</span>
            เพิ่มโค้ดใหม่
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="section-card">
    <div class="section-card-header">
        <h2><span class="material-symbols-outlined" style="color:#06b6d4;">list_alt</span> โค้ดทั้งหมด (@Model.Count)</h2>
    </div>
    <div class="table-responsive">
        <table class="table-custom w-100">
            <thead>
                <tr><th>โค้ด</th><th>ส่วนลด</th><th>สัญญาขั้นต่ำ</th><th>ช่วงวันที่ใช้ได้</th><th>ใช้ไปแล้ว</th><th>สถานะ</th><th>ดำเนินการ</th></tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold" style="font-size:0.875rem; color:#06b6d4;">@p.Code</span><br />
                                <span style="font-size:0.75rem; color:#6c757d;">@p.Description</span>
                            </td>
                            <td class="fw-semibold" style="font-size:0.875rem;">@p.DiscountText</td>
                            <td style="font-size:0.85rem;">@p.MinMonths เดือน</td>
                            <td style="font-size:0.78rem; color:#6c757d;">@p.PeriodText</td>
                            <td style="font-size:0.85rem;">@p.UsedCount การจอง</td>
                            <td><span class="badge-status @(statusClass.ContainsKey(p.StatusText) ? statusClass[p.StatusText] : "")">@p.StatusText</span></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a class="btn btn-sm" style="background:#f0fdf4; color:#065f46; border:none; border-radius:6px; font-size:0.7rem; display:inline-flex; align-items:center;"
                                       asp-action="EditPromo" asp-controller="Admin" asp-route-id="@p.Code" title="แก้ไข">
                                        <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">edit</span>
                                    </a>
                                    @* ลบผ่าน POST เท่านั้น ลบได้เฉพาะโค้ดที่ยังไม่มีการจองใช้ *@
                                    <form asp-action="DeletePromo" asp-controller="Admin" asp-route-id="@p.Code" method="post" class="d-inline"
                                          onsubmit="return confirm('ยืนยันลบโค้ด @p.Code ?');">
                                        <button type="submit" class="btn btn-sm" style="background:#fee2e2; color:#991b1b; border:none; border-radius:6px; font-size:0.7rem; display:inline-flex; align-items:center;" title="ลบ">
                                            <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" style="text-align:center; color:#9ca3af; padding:2rem;">ยังไม่มีโค้ดส่วนลด</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
