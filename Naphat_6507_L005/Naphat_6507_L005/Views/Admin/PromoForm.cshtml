@model Naphat_6507_L005.ViewModels.PromoFormViewModel
@{
    // ใช้ร่วมกันทั้งเพิ่มโค้ด (AddPromo) และแก้ไขโค้ด (EditPromo)
    var action = Model.IsEdit ? "EditPromo" : "AddPromo";
    ViewData["Title"] = Model.IsEdit ? "แก้ไขโค้ด " + Model.Code : "เพิ่มโค้ดส่วนลด";
    Layout = "_Layout";
}

<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Promos" asp-controller="Admin" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;">
            <span class="material-symbols-outlined align-middle" style="font-size:1rem;">arrow_back</span> ย้อนกลับ
        </a>
        <h1 class="h3 mb-0">
            <span class="material-symbols-outlined align-middle me-2" style="color:#06b6d4;">sell</span>
            @ViewData["Title"]
        </h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="section-card p-4" style="background:#fff; border-radius:16px; box-shadow:0 4px 20px rgba(0,0,0,0.06);">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
            }

            <!-- ส่งไปที่ AdminController.AddPromo / EditPromo (POST) -->
            <form asp-action="@action" asp-controller="Admin" method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="Code">โค้ด *</label>
                    @if (Model.IsEdit)
                    {
                        <input type="hidden" asp-for="Code" />
                        <input type="text" class="form-control" value="@Model.Code" disabled />
                        <small class="text-muted" style="font-size:0.75rem;">เปลี่ยนตัวโค้ดไม่ได้ เพราะการจองเก่าอ้างถึงโค้ดนี้</small>
                    }
                    else
                    {
                        <input type="text" class="form-control" asp-for="Code" maxlength="30" placeholder="เช่น MEGA35START" style="text-transform:uppercase;" required />
                        <small class="text-muted" style="font-size:0.75rem;">ภาษาอังกฤษหรือตัวเลข ไม่มีเว้นวรรค</small>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="Description">คำอธิบาย (แสดงบนหน้าหลัก)</label>
                    <input type="text" class="form-control" asp-for="Description" maxlength="200" placeholder="เช่น ลดค่าเช่าเดือนแรก 35% เมื่อทำสัญญา 6 เดือนขึ้นไป" />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="DiscountType">ประเภทส่วนลด *</label>
                        <select class="form-select" asp-for="DiscountType">
                            <option value="Percent">ลดเป็น % ของค่าเช่าเดือนแรก</option>
                            <option value="Amount">ลดเป็นบาท</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="DiscountValue">ส่วนลด (% หรือ บาท) *</label>
                        <input type="number" class="form-control" asp-for="DiscountValue" min="1" step="1" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="MinMonths">ใช้ได้เมื่อสัญญาอย่างน้อย (เดือน) *</label>
                    <select class="form-select" asp-for="MinMonths">
                        <option value="1">1 เดือน (ทุกระยะสัญญา)</option>
                        <option value="3">3 เดือน</option>
                        <option value="6">6 เดือน</option>
                        <option value="12">12 เดือน</option>
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="StartDate">ใช้ได้ตั้งแต่ (ไม่บังคับ)</label>
                        <input type="date" class="form-control" asp-for="StartDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="EndDate">หมดอายุ (ไม่บังคับ)</label>
                        <input type="date" class="form-control" asp-for="EndDate" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:0.875rem;" asp-for="IsActive">สถานะ</label>
                    <select class="form-select" asp-for="IsActive">
                        <option value="true">เปิดใช้งาน</option>
                        <option value="false">ปิดใช้งาน</option>
                    </select>
                </div>

                <div class="d-flex gap-2 mt-4 pt-2 border-top">
                    <button type="submit" class="btn flex-fill" style="background:linear-gradient(135deg,#06b6d4,#0891b2); color:#fff; border:none; border-radius:10px; padding:0.6rem; font-weight:600;">
                        <span class="material-symbols-outlined align-middle me-1" style="font-size:1.1rem;">save</span> @(Model.IsEdit ? "บันทึกการแก้ไข" : "เพิ่มโค้ด")
                    </button>
                    <a asp-action="Promos" asp-controller="Admin" class="btn btn-outline-secondary" style="border-radius:10px; padding:0.6rem 1.25rem;">
                        ยกเลิก
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
