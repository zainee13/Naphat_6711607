@{
    var bookingId = ViewBag.BookingId as string ?? "BK-2026-002";
    ViewData["Title"] = "ชำระเงินและใบแจ้งหนี้";
    Layout = "_Layout";
}

<div class="page-header mb-4">
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-0 small" style="--bs-breadcrumb-divider: '›';">
            <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Dashboard" class="text-decoration-none text-muted">หน้าหลัก</a></li>
            <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Profile" asp-route-tab="bookings" class="text-decoration-none text-muted">การจองของฉัน</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">ชำระเงิน (@bookingId)</li>
        </ol>
    </nav>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2" style="color:#0f172a;">
                <span class="material-symbols-outlined text-primary" style="font-size:2rem;">account_balance_wallet</span>
                ชำระเงินและจัดการใบแจ้งหนี้
            </h1>
            <p class="text-secondary mb-0" style="font-size:0.92rem;">
                รหัสคำขอจองสัญญา: <strong class="text-primary">@bookingId</strong>
            </p>
        </div>
        <a asp-controller="Customer" asp-action="Profile" asp-route-tab="bookings" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" style="border-radius:8px;">
            <span class="material-symbols-outlined" style="font-size:1rem;">arrow_back</span>
            <span>กลับไปรายการจอง</span>
        </a>
    </div>
</div>

<div class="row g-4">

    <!-- Left Column: Invoice Breakdown & Payment Method -->
    <div class="col-12 col-lg-7">
        <!-- Invoice Summary Card -->
        <div class="section-card mb-4" style="border-left: 4px solid #f59e0b !important;">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined text-warning">receipt_long</span> สรุปใบแจ้งยอดค่าบริการ</h2>
                <span class="badge-status badge-pending">รอการชำระเงิน</span>
            </div>

            <div class="p-3 rounded-3 mb-3" style="background:#f8fafc; border:1px solid #e2e8f0; font-size:0.9rem;">
                <div class="row mb-2">
                    <div class="col-6 text-secondary">รหัสการจอง:</div>
                    <div class="col-6 fw-bold text-primary">@bookingId</div>
                </div>
                <div class="row mb-2">
                    <div class="col-6 text-secondary">ห้องคลังสินค้า:</div>
                    <div class="col-6 fw-semibold text-dark">Unit L-01 (ไซส์ L โซน C1 - 500 ตร.ม.)</div>
                </div>
                <div class="row mb-2">
                    <div class="col-6 text-secondary">ช่วงเวลาสัญญา:</div>
                    <div class="col-6 text-dark">1 ก.พ. — 31 ก.ค. 2569 (6 เดือน)</div>
                </div>
                <div class="row mb-2">
                    <div class="col-6 text-secondary">ค่าเช่ารวม (6 เดือน):</div>
                    <div class="col-6 text-dark">฿450,000</div>
                </div>
                <div class="row mb-2">
                    <div class="col-6 text-secondary">เงินมัดจำประกันความเสียหาย:</div>
                    <div class="col-6 text-dark">฿150,000</div>
                </div>
                <div class="row mb-2">
                    <div class="col-6 text-secondary">ภาษีมูลค่าเพิ่ม (VAT 7%):</div>
                    <div class="col-6 text-dark">฿42,000</div>
                </div>
                <hr class="my-2" />
                <div class="row fw-bold align-items-center">
                    <div class="col-6 text-dark fs-6">ยอดรวมสุทธิที่ต้องชำระ:</div>
                    <div class="col-6 text-primary text-end fs-4 fw-bold">฿642,000.00</div>
                </div>
            </div>

            <div class="alert alert-warning d-flex align-items-center gap-2 mb-0 py-2 small" style="border-radius:8px;">
                <span class="material-symbols-outlined text-warning" style="font-size:1.2rem;">timer</span>
                <span>กรุณาชำระเงินและแนบหลักฐานเพื่อยืนยันการจองสัญญาก่อนการปล่อยห้องให้ผู้เช่ารายอื่น</span>
            </div>
        </div>

        <!-- Payment Channels -->
        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined">credit_card</span> เลือกช่องทางการชำระเงิน</h2>
            </div>

            <ul class="nav nav-pills nav-fill gap-2 mb-3" id="payMethodNav">
                <li class="nav-item">
                    <button class="nav-link active py-2 d-flex align-items-center justify-content-center gap-2" id="btnMethodTransfer" onclick="selectPayTab('transfer')" type="button">
                        <span class="material-symbols-outlined">account_balance</span>
                        <span>โอนผ่านธนาคาร</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-2 d-flex align-items-center justify-content-center gap-2" id="btnMethodQr" onclick="selectPayTab('qr')" type="button">
                        <span class="material-symbols-outlined">qr_code_2</span>
                        <span>พร้อมเพย์ QR</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-2 d-flex align-items-center justify-content-center gap-2" id="btnMethodCard" onclick="selectPayTab('card')" type="button">
                        <span class="material-symbols-outlined">credit_card</span>
                        <span>บัตรเครดิต</span>
                    </button>
                </li>
            </ul>

            <!-- 1. Transfer Panel -->
            <div id="method_transfer" class="pay-panel">
                <div class="p-3 rounded-3 mb-3" style="background:#eff6ff; border:1px solid #bfdbfe;">
                    <div class="fw-bold text-primary mb-2">
                        <span class="material-symbols-outlined align-middle me-1">domain</span> ข้อมูลบัญชีธนาคารสำหรับโอนเงิน
                    </div>
                    <div class="small" style="line-height:2;">
                        <div><strong>ธนาคาร:</strong> ธนาคารไทยพาณิชย์ (SCB) สาขาอโศก</div>
                        <div><strong>ชื่อบัญชี:</strong> บริษัท โลจิแมเนจ คอร์ปอเรชั่น จำกัด</div>
                        <div><strong>เลขที่บัญชี:</strong> <span class="fw-bold text-primary fs-6">123-4-56789-0</span>
                            <button class="btn btn-sm btn-outline-primary py-0 px-2 ms-2" onclick="navigator.clipboard.writeText('1234567890'); alert('คัดลอกเลขบัญชีแล้ว!');">คัดลอก</button>
                        </div>
                        <div><strong>ยอดเงินที่ต้องโอน:</strong> <span class="fw-bold text-danger fs-6">฿642,000.00</span></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">อัปโหลดสลิปหลักฐานการโอนเงิน (Slip Upload) *</label>
                    <input type="file" class="form-control" id="standaloneSlip" accept="image/*" onchange="previewStandaloneSlip(event)" />
                    <div id="slipPreviewBox" class="mt-2 text-center d-none p-2 border rounded-3 bg-light">
                        <img id="slipPreviewImgTag" src="" alt="Slip Preview" style="max-height:160px; border-radius:8px;" />
                        <div class="text-success small fw-bold mt-1">✓ แนบหลักฐานการโอนเงินเรียบร้อยแล้ว</div>
                    </div>
                </div>

                <button class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" style="border-radius:10px;" onclick="confirmPayment('โอนเงินผ่านธนาคาร')">
                    <span class="material-symbols-outlined" style="font-size:1.1rem;">upload_file</span>
                    <span>ยืนยันการแจ้งชำระเงิน</span>
                </button>
            </div>

            <!-- 2. QR Code Panel -->
            <div id="method_qr" class="pay-panel" style="display:none;">
                <div class="text-center p-4 bg-light rounded-3 border mb-3">
                    <div class="fw-bold text-dark mb-2">สแกนจ่ายผ่าน Mobile Banking ทุกธนาคาร</div>
                    <div class="d-inline-block p-3 bg-white rounded-3 shadow-sm border mb-2">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=PROMPTPAY-LOGIMANAGE-642000"
                             alt="QR Code" style="width:160px; height:160px;" />
                    </div>
                    <div class="fw-bold fs-4 text-primary mb-1">฿642,000.00</div>
                    <div class="text-muted small">สแกนเพื่อชำระยอดตามใบแจ้งหนี้ @bookingId</div>
                </div>
                <button class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" style="border-radius:10px;" onclick="confirmPayment('พร้อมเพย์ QR')">
                    <span class="material-symbols-outlined" style="font-size:1.1rem;">verified</span>
                    <span>ฉันได้สแกนชำระเงินเรียบร้อยแล้ว</span>
                </button>
            </div>

            <!-- 3. Credit Card Panel -->
            <div id="method_card" class="pay-panel" style="display:none;">
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <label class="form-label small fw-semibold">หมายเลขบัตรเครดิต / เดบิต</label>
                        <input type="text" class="form-control" placeholder="4000 1234 5678 9010" maxlength="19" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">ชื่อผู้ถือบัตร</label>
                        <input type="text" class="form-control" placeholder="NAPHAT WONGCHAROEN" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">วันหมดอายุ (MM/YY)</label>
                        <input type="text" class="form-control" placeholder="12/28" maxlength="5" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">รหัส CVV</label>
                        <input type="password" class="form-control" placeholder="•••" maxlength="3" />
                    </div>
                </div>
                <button class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" style="border-radius:10px;" onclick="confirmPayment('บัตรเครดิต')">
                    <span class="material-symbols-outlined" style="font-size:1.1rem;">credit_score</span>
                    <span>ชำระเงิน ฿642,000.00 ทันที</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Right Column: Support & Tax Invoice Information -->
    <div class="col-12 col-lg-5">
        <div class="section-card mb-4">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined">description</span> เอกสารทางภาษี &amp; การหัก ณ ที่จ่าย</h2>
            </div>
            <p class="text-secondary small mb-3">
                การเช่าคลังสินค้าเป็นค่าบริการเช่าอสังหาริมทรัพย์และบริการเก็บสินค้า ลูกค้านิติบุคคลสามารถหักภาษี ณ ที่จ่ายตามที่กฎหมายกำหนด
            </p>
            <div class="vstack gap-2 small">
                <div class="p-2 rounded-2 bg-light border d-flex justify-content-between">
                    <span>หัก ณ ที่จ่าย ค่าเช่า (5%)</span>
                    <strong class="text-dark">฿22,500.00</strong>
                </div>
                <div class="p-2 rounded-2 bg-light border d-flex justify-content-between">
                    <span>หัก ณ ที่จ่าย ค่าบริการส่วนกลาง (3%)</span>
                    <strong class="text-dark">฿0.00</strong>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top text-center">
                <button class="btn btn-sm btn-outline-primary" onclick="alert('ระบบจะสร้างแบบฟอร์ม ภ.ง.ด.53 และส่งไปยังอีเมลของท่าน');">
                    <span class="material-symbols-outlined align-middle me-1" style="font-size:0.9rem;">receipt</span>
                    ขอเอกสารหัก ณ ที่จ่ายล่วงหน้า
                </button>
            </div>
        </div>

        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined">help_center</span> ฝ่ายบริการลูกค้า &amp; การเงิน</h2>
            </div>
            <p class="text-secondary small mb-3">
                พบปัญหาในการชำระเงิน หรือต้องการใบเสนอราคาอย่างเป็นทางการ ติดต่อฝ่ายบัญชีการเงินของเราได้ทันที
            </p>
            <div class="vstack gap-2">
                <a href="tel:028889999" class="btn btn-sm btn-light border text-dark d-flex align-items-center justify-content-center gap-2">
                    <span class="material-symbols-outlined text-primary" style="font-size:1rem;">call</span>
                    <span>โทรฝ่ายการเงิน: 02-888-9999 ต่อ 102</span>
                </a>
                <a href="mailto:accounting@logimanage.co.th" class="btn btn-sm btn-light border text-dark d-flex align-items-center justify-content-center gap-2">
                    <span class="material-symbols-outlined text-primary" style="font-size:1rem;">mail</span>
                    <span>อีเมล: accounting@logimanage.co.th</span>
                </a>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
function selectPayTab(tab) {
    document.querySelectorAll('#payMethodNav .nav-link').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.pay-panel').forEach(p => p.style.display = 'none');

    if (tab === 'transfer') {
        document.getElementById('btnMethodTransfer').classList.add('active');
        document.getElementById('method_transfer').style.display = 'block';
    } else if (tab === 'qr') {
        document.getElementById('btnMethodQr').classList.add('active');
        document.getElementById('method_qr').style.display = 'block';
    } else if (tab === 'card') {
        document.getElementById('btnMethodCard').classList.add('active');
        document.getElementById('method_card').style.display = 'block';
    }
}

function previewStandaloneSlip(event) {
    const file = event.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('slipPreviewImgTag').src = e.target.result;
            document.getElementById('slipPreviewBox').classList.remove('d-none');
        };
        reader.readAsDataURL(file);
    }
}

function confirmPayment(method) {
    alert(`บันทึกข้อมูลการแจ้งชำระเงิน (${method}) เรียบร้อยแล้ว!\nระบบกำลังตรวจสอบยอดเงินและจะส่งใบเสร็จรับเงินทางอีเมล`);
    window.location.href = '@Url.Action("Profile", "Customer", new { tab = "bookings" })';
}
</script>
}
