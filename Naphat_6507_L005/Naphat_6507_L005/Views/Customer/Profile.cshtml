@model Naphat_6507_L005.ViewModels.ProfileViewModel
@using Naphat_6507_L005.ViewModels
@{
    ViewData["Title"] = "บัญชีของฉัน";
    Layout = "_Layout";

    // ข้อมูลทั้งหมดส่งมาจาก CustomerController.Profile
    var activeTab = ViewBag.ActiveTab as string ?? "bookings";
    var fullName = Model.Fullname;
    var bookings = ViewBag.Bookings as List<MyBookingViewModel> ?? new();
    var payments = ViewBag.Payments as List<PaymentHistoryViewModel> ?? new();
    var dueBooking = ViewBag.DueBooking as MyBookingViewModel;
    int dueDepositMonths = ViewBag.DueDepositMonths ?? 0;
    int dueDeposit = ViewBag.DueDeposit ?? 0;
    int dueTotal = ViewBag.DueTotal ?? 0;

    var statusText = new Dictionary<string, string>
    {
        { "pending", "รอชำระเงิน" },
        { "checking", "รอตรวจสอบการชำระ" },
        { "active", "ใช้งานอยู่" },
        { "ended", "สิ้นสุดสัญญา" },
        { "cancelled", "ยกเลิก คืนเงินแล้ว" },
    };

    var pendingCount = bookings.Count(b => b.Status == "pending");
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="pf cu">

    <!-- หัวข้อ -->
    <header class="cu-head">
        <h1>บัญชีของฉัน</h1>
        @if (fullName == "")
        {
            <p>จัดการการจอง การชำระเงิน และข้อมูลออกใบกำกับภาษี</p>
        }
        else
        {
            <p>@fullName</p>
        }
    </header>

    @if (TempData["Success"] != null)
    {
        <p class="cu-alert" role="status">@TempData["Success"]</p>
    }
    @if (TempData["Error"] != null)
    {
        <p class="cu-alert cu-alert--error" role="alert">@TempData["Error"]</p>
    }

    <!-- แท็บ: ลิงก์ ?tab= ใช้ได้ทั้งเปิดตรงและกดสลับ (JS สลับให้โดยไม่โหลดหน้าใหม่) -->
    <nav class="pf-tabs" role="tablist" aria-label="ส่วนของบัญชี">
        <a role="tab" href="?tab=bookings" data-tab="bookings" aria-selected="@(activeTab == "bookings" ? "true" : "false")">
            การจองของฉัน
            <span class="pf-count">@bookings.Count</span>
        </a>
        <a role="tab" href="?tab=payment" data-tab="payment" aria-selected="@(activeTab == "payment" ? "true" : "false")">
            ชำระเงิน
            @if (pendingCount > 0)
            {
                <span class="pf-count pf-count--due">@pendingCount รอชำระ</span>
            }
        </a>
        <a role="tab" href="?tab=info" data-tab="info" aria-selected="@(activeTab == "info" ? "true" : "false")">
            ข้อมูลส่วนตัว
        </a>
    </nav>

    <!-- ========== แท็บ: การจองของฉัน ========== -->
    <section class="pf-panel" id="panel-bookings" role="tabpanel" hidden="@(activeTab != "bookings")">
        <div class="pf-panel-head">
            <h2 class="cu-h2">การจองของฉัน</h2>
            <a class="cu-btn" asp-controller="Customer" asp-action="Search">จองห้องเพิ่ม</a>
        </div>

        <ul class="pf-bookings">
            @foreach (var booking in bookings)
            {
                <li class="pf-booking is-@booking.Status">
                    <div class="pf-booking-room">
                        <a class="pf-room-code" asp-controller="Customer" asp-action="RoomDetail" asp-route-id="@booking.Room">@booking.Room</a>
                        <span>@booking.Zone</span>
                    </div>
                    <div class="pf-booking-info">
                        <strong>@booking.Period</strong>
                        <span>@booking.Id, จองเมื่อ @booking.BookedOn</span>
                    </div>
                    <span class="pf-status pf-status--@booking.Status">@statusText[booking.Status]</span>
                    <div class="pf-booking-amt">
                        <strong>฿@booking.Rate.ToString("N0") ต่อเดือน</strong>
                        <span>สัญญา @booking.Months เดือน</span>
                    </div>
                    <div class="pf-booking-act">
                        @if (booking.Status == "pending")
                        {
                            <a class="cu-btn cu-btn--primary" asp-controller="Customer" asp-action="Profile" asp-route-tab="payment" asp-route-bookingId="@booking.Id">ชำระเงิน</a>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>

    <!-- ========== แท็บ: ชำระเงิน ========== -->
    <section class="pf-panel" id="panel-payment" role="tabpanel" hidden="@(activeTab != "payment")">
        <div class="pf-pay-layout">

            <div class="pf-pay-main">
                @if (dueBooking == null)
                {
                    <h2 class="cu-h2">ยอดที่ต้องชำระ</h2>
                    <p class="pf-saved-empty">ไม่มีรายการที่ต้องชำระในตอนนี้</p>
                }
                else
                {

                <!-- ยอดที่ต้องชำระ -->
                <h2 class="cu-h2">ยอดที่ต้องชำระ</h2>
                <div class="pf-bill">
                    <div class="pf-bill-head">
                        <div>
                            <strong class="pf-room-code">@dueBooking.Room</strong>
                            <span>@dueBooking.Id, @dueBooking.Period</span>
                        </div>
                        <span class="pf-status pf-status--pending">รอชำระเงิน</span>
                    </div>

                    <dl class="pf-calc">
                        <div>
                            <dt>ค่าเช่าเดือนแรก</dt>
                            <dd>฿@dueBooking.Rate.ToString("N0")</dd>
                        </div>
                        <div>
                            <dt>
                                เงินประกัน @dueDepositMonths เดือน
                                <span class="cu-sub">คืนเมื่อสิ้นสุดสัญญา</span>
                            </dt>
                            <dd>฿@dueDeposit.ToString("N0")</dd>
                        </div>
                        <div class="pf-total">
                            <dt>ชำระก่อนเข้าใช้</dt>
                            <dd>฿@dueTotal.ToString("N0")</dd>
                        </div>
                    </dl>

                    @if (dueBooking.Months > 1)
                    {
                        <p class="cu-next pf-next">เดือนที่ 2–@dueBooking.Months ชำระเดือนละ ฿@dueBooking.Rate.ToString("N0")</p>
                    }

                    <!-- โค้ดส่วนลด: มีแค่หน้าตา ยังไม่คิดส่วนลด -->
                    <form class="cu-promo" id="promoForm" novalidate>
                        <div class="cu-field">
                            <label for="promoInput">โค้ดส่วนลด</label>
                            <div class="cu-promo-row">
                                <input type="text" id="promoInput" autocomplete="off" placeholder="เช่น MEGA35START" />
                                <button type="submit" class="cu-btn">ใช้โค้ด</button>
                            </div>
                        </div>
                        <p class="cu-promo-msg" id="promoMessage" role="status" hidden></p>
                    </form>

                    <p class="pf-due">ชำระภายใน <strong>@ViewBag.DueDate, 23:59 น.</strong> ถ้าเลยกำหนด การจองจะถูกยกเลิก</p>
                </div>

                <!-- เลือกวิธีชำระเงิน -->
                <h3 class="pf-h3">วิธีชำระเงิน</h3>
                <div class="pf-methods" role="radiogroup" aria-label="วิธีชำระเงิน">
                    <label>
                        <input type="radio" name="payMethod" value="transfer" checked />
                        <span><i class="material-symbols-outlined" aria-hidden="true">account_balance</i>โอนเงิน</span>
                    </label>
                    <label>
                        <input type="radio" name="payMethod" value="qr" />
                        <span><i class="material-symbols-outlined" aria-hidden="true">qr_code_2</i>พร้อมเพย์ QR</span>
                    </label>
                    <label>
                        <input type="radio" name="payMethod" value="card" />
                        <span><i class="material-symbols-outlined" aria-hidden="true">credit_card</i>บัตรเครดิต / เดบิต</span>
                    </label>
                </div>

                <!-- วิธีที่ 1: โอนเงิน -->
                <form class="pf-method" id="method-transfer" asp-controller="Customer" asp-action="Pay" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="BookingId" value="@dueBooking.Id" />
                    <input type="hidden" name="PayMethod" value="transfer" />
                    <dl class="pf-bank">
                        <div><dt>ธนาคาร</dt><dd>ไทยพาณิชย์ (SCB)</dd></div>
                        <div><dt>ชื่อบัญชี</dt><dd>บริษัท โลจิแมเนจ จำกัด</dd></div>
                        <div>
                            <dt>เลขบัญชี</dt>
                            <dd>123-4-56789-0 <button type="button" class="pf-copy" id="copyButton">คัดลอก</button></dd>
                        </div>
                        <div><dt>ยอดโอน</dt><dd>฿@dueTotal.ToString("N0")</dd></div>
                    </dl>
                    <label class="cu-field">
                        <span>สลิปโอนเงิน</span>
                        <input type="file" id="slipInput" name="Slip" accept="image/*" required />
                    </label>
                    <img id="slipPreview" class="pf-slip" alt="ตัวอย่างสลิปที่แนบ" hidden />
                    <button type="submit" class="cu-btn cu-btn--primary pf-pay-btn">แจ้งชำระเงิน</button>
                </form>

                <!-- วิธีที่ 2: QR พร้อมเพย์ -->
                <form class="pf-method" id="method-qr" asp-controller="Customer" asp-action="Pay" method="post" hidden>
                    <input type="hidden" name="BookingId" value="@dueBooking.Id" />
                    <input type="hidden" name="PayMethod" value="qr" />
                    <div class="pf-qr">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=PROMPTPAY-@dueTotal" alt="QR พร้อมเพย์" width="160" height="160" />
                        <p>สแกนด้วยแอปธนาคาร ยอด <strong>฿@dueTotal.ToString("N0")</strong></p>
                    </div>
                    <button type="submit" class="cu-btn cu-btn--primary pf-pay-btn">ฉันชำระแล้ว</button>
                </form>

                <!-- วิธีที่ 3: บัตรเครดิต -->
                <form class="pf-method" id="method-card" asp-controller="Customer" asp-action="Pay" method="post" hidden>
                    <input type="hidden" name="BookingId" value="@dueBooking.Id" />
                    <input type="hidden" name="PayMethod" value="card" />
                    <div class="pf-grid">
                        <label class="cu-field pf-span-2">
                            <span>เลขบัตร</span>
                            <input type="text" inputmode="numeric" autocomplete="cc-number" maxlength="19" placeholder="0000 0000 0000 0000" required />
                        </label>
                        <label class="cu-field pf-span-2">
                            <span>ชื่อบนบัตร</span>
                            <input type="text" autocomplete="cc-name" required />
                        </label>
                        <label class="cu-field">
                            <span>หมดอายุ (ดด/ปป)</span>
                            <input type="text" inputmode="numeric" autocomplete="cc-exp" maxlength="5" placeholder="12/28" required />
                        </label>
                        <label class="cu-field">
                            <span>CVV</span>
                            <input type="password" inputmode="numeric" autocomplete="cc-csc" maxlength="4" required />
                        </label>
                    </div>
                    <button type="submit" class="cu-btn cu-btn--primary pf-pay-btn">ชำระ ฿@dueTotal.ToString("N0")</button>
                </form>

                }
            </div>

            <!-- ประวัติการชำระ -->
            <aside class="pf-history" aria-labelledby="historyTitle">
                <h2 class="cu-h2" id="historyTitle">ประวัติการชำระ</h2>
                <ul>
                    @foreach (var payment in payments)
                    {
                        var isRefund = payment.IsRefund;
                        <li class="@(isRefund ? "is-refund" : "")">
                            <div class="pf-history-top">
                                <strong>@payment.Title</strong>
                                <span>@(isRefund ? "−" : "")฿@payment.Amount.ToString("N0")</span>
                            </div>
                            <span class="pf-history-meta">@payment.No, @payment.Detail</span>
                        </li>
                    }
                </ul>
            </aside>
        </div>
    </section>

    <!-- ========== แท็บ: ข้อมูลส่วนตัว ========== -->
    <section class="pf-panel" id="panel-info" role="tabpanel" hidden="@(activeTab != "info")">
        <h2 class="cu-h2">ข้อมูลส่วนตัวและที่อยู่ออกใบกำกับภาษี</h2>

        <div class="pf-info-layout">
            <form class="pf-info" asp-controller="Customer" asp-action="SaveProfile" method="post">
                <div class="pf-grid">
                    <label class="cu-field">
                        <span>ชื่อ-นามสกุล</span>
                        <input type="text" asp-for="Fullname" autocomplete="name" required />
                    </label>
                    <label class="cu-field">
                        <span>ชื่อบริษัท (ไม่บังคับ)</span>
                        <input type="text" asp-for="Company" autocomplete="organization" />
                    </label>
                    <label class="cu-field">
                        <span>เบอร์โทร</span>
                        <input type="tel" asp-for="Phone" autocomplete="tel" pattern="0\d{8,9}" placeholder="0812345678" required />
                    </label>
                    <label class="cu-field">
                        <span>อีเมล</span>
                        <input type="email" asp-for="Email" autocomplete="email" placeholder="name@company.com" required />
                    </label>
                    <label class="cu-field">
                        <span>เลขผู้เสียภาษี / เลขบัตรประชาชน</span>
                        <input type="text" asp-for="TaxId" inputmode="numeric" pattern="\d{13}" maxlength="13" placeholder="ตัวเลข 13 หลัก" />
                    </label>
                    <label class="cu-field pf-span-2">
                        <span>ที่อยู่ออกใบกำกับภาษี</span>
                        <textarea asp-for="Address" rows="3" autocomplete="street-address"></textarea>
                    </label>
                </div>
                <div class="pf-info-actions">
                    <button type="submit" class="cu-btn cu-btn--primary">บันทึกข้อมูล</button>
                </div>
            </form>

            <!-- ข้อมูลที่บันทึกไว้ในตาราง user -->
            <aside class="pf-saved-card" aria-labelledby="savedTitle">
                <h3 id="savedTitle">ข้อมูลที่บันทึกไว้</h3>
                @if (Model.Phone == "" && Model.Email == "" && Model.Address == "")
                {
                    <p class="pf-saved-empty">ยังไม่ได้บันทึกข้อมูล กรอกฟอร์มแล้วกดบันทึก ข้อมูลจะแสดงที่นี่</p>
                }
                else
                {
                    var savedRows = new[]
                    {
                        ("ชื่อ", Model.Fullname),
                        ("บริษัท", Model.Company),
                        ("เบอร์โทร", Model.Phone),
                        ("อีเมล", Model.Email),
                        ("เลขผู้เสียภาษี", Model.TaxId),
                        ("ที่อยู่", Model.Address),
                    };
                    <dl class="pf-saved-list">
                        @foreach (var row in savedRows)
                        {
                            var isEmpty = string.IsNullOrEmpty(row.Item2);
                            <div><dt>@row.Item1</dt><dd class="@(isEmpty ? "is-empty" : "")">@(isEmpty ? "-" : row.Item2)</dd></div>
                        }
                    </dl>
                }
            </aside>
        </div>

        <p class="pf-help">ต้องการความช่วยเหลือ? โทร <a href="tel:021234567">02-123-4567</a> ทุกวัน 8:00–18:00</p>
    </section>
</div>

@section Scripts {
<script>
    // JS ใช้แค่สลับหน้าจอ การชำระเงินและบันทึกข้อมูลส่งไปที่ CustomerController (Pay / SaveProfile)

    // ===================== แท็บ =====================
    const tabLinks = document.querySelectorAll('.pf-tabs a');

    // เปิดแท็บตามชื่อ (bookings / payment / info) และเปลี่ยน ?tab= ใน URL
    function showTab(tabName) {
        tabLinks.forEach(function (link) {
            const isActive = (link.dataset.tab === tabName);
            link.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        document.querySelectorAll('.pf-panel').forEach(function (panel) {
            panel.hidden = (panel.id !== 'panel-' + tabName);
        });

        history.replaceState(null, '', '?tab=' + tabName);
    }

    tabLinks.forEach(function (link) {
        link.addEventListener('click', function (event) {
            event.preventDefault();
            showTab(link.dataset.tab);
        });
    });

    // ===================== โค้ดส่วนลด =====================
    // ยังไม่มีระบบส่วนลด แสดงข้อความแจ้งเฉยๆ
    const promoForm = document.getElementById('promoForm');
    if (promoForm) {
        promoForm.addEventListener('submit', function (event) {
            event.preventDefault();
            const code = document.getElementById('promoInput').value.trim();
            const message = document.getElementById('promoMessage');
            message.textContent = (code === '') ? 'พิมพ์โค้ดส่วนลดก่อนกดใช้โค้ด' : 'ยังใช้โค้ดส่วนลดไม่ได้ในตอนนี้';
            message.hidden = false;
        });
    }

    // ===================== วิธีชำระเงิน =====================
    // เลือกวิธีชำระ แล้วแสดงฟอร์มของวิธีนั้น
    document.querySelectorAll('input[name=payMethod]').forEach(function (radio) {
        radio.addEventListener('change', function () {
            document.getElementById('method-transfer').hidden = (radio.value !== 'transfer');
            document.getElementById('method-qr').hidden = (radio.value !== 'qr');
            document.getElementById('method-card').hidden = (radio.value !== 'card');
        });
    });

    // ปุ่มคัดลอกเลขบัญชี
    const copyButton = document.getElementById('copyButton');
    if (copyButton) {
        copyButton.addEventListener('click', function () {
            navigator.clipboard.writeText('1234567890').then(function () {
                copyButton.textContent = 'คัดลอกแล้ว';
                setTimeout(function () {
                    copyButton.textContent = 'คัดลอก';
                }, 1800);
            });
        });
    }

    // แนบสลิปแล้วแสดงรูปตัวอย่าง
    const slipInput = document.getElementById('slipInput');
    const slipPreview = document.getElementById('slipPreview');
    if (slipInput) {
        slipInput.addEventListener('change', function () {
            const file = slipInput.files[0];
            if (file) {
                slipPreview.src = URL.createObjectURL(file);
                slipPreview.hidden = false;
            } else {
                slipPreview.hidden = true;
            }
        });
    }
</script>
}
