@section Scripts {
<script>
function switchProfileTab(tabName) {
    // Hide all sections
    document.querySelectorAll('.profile-section').forEach(sec => sec.style.display = 'none');
    
    // Remove active from all tab buttons
    document.querySelectorAll('#profileTabNav .nav-link').forEach(btn => btn.classList.remove('active'));

    // Show target section
    const targetSec = document.getElementById('section-' + tabName);
    if (targetSec) targetSec.style.display = 'block';

    // Set active button
    const targetBtn = document.getElementById('tab-btn-' + tabName);
    if (targetBtn) targetBtn.classList.add('active');

    // Update URL hash
    window.location.hash = tabName;
}

function goToPaymentForBooking(bookingId) {
    document.getElementById('payBookingIdDisplay').textContent = bookingId;
    switchProfileTab('payment');
    window.scrollTo({ top: 300, behavior: 'smooth' });
}

function changeProfilePayMethod(method) {
    document.querySelectorAll('.payment-option-box').forEach(box => box.classList.remove('active'));
    document.querySelectorAll('.payment-method-panel').forEach(p => p.style.display = 'none');

    const optBox = document.getElementById('pop_' + method);
    if (optBox) optBox.classList.add('active');

    const panel = document.getElementById('panel_' + method);
    if (panel) panel.style.display = 'block';
}

function previewSlip(event) {
    const file = event.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('slipPreviewImg').src = e.target.result;
            document.getElementById('slipPreviewContainer').classList.remove('d-none');
        };
        reader.readAsDataURL(file);
    }
}

function submitPayment(method) {
    alert('บันทึกข้อมูลการชำระเงินเรียบร้อยแล้ว!\nระบบกำลังตรวจสอบยอดเงินและจะอัปเดตสถานะสัญญาการจองภายใน 15 นาที');
    switchProfileTab('bookings');
}

function saveProfileInfo(e) {
    e.preventDefault();
    alert('บันทึกข้อมูลโปรไฟล์และที่อยู่เรียบร้อยแล้ว!');
}

function filterBookings() {
    const val = document.getElementById('bookingFilterStatus').value;
    const rows = document.querySelectorAll('#bookingsTable tbody tr');
    rows.forEach(row => {
        const status = row.getAttribute('data-status');
        if (val === 'all' || status === val) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}

// Initial tab check from URL hash
document.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash && ['bookings', 'payment', 'info'].includes(hash)) {
        switchProfileTab(hash);
    }
});
</script>
}
