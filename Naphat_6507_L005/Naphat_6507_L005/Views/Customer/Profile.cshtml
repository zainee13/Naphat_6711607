@{
    ViewData["Title"] = "โปรไฟล์ของฉัน — การจองและการชำระเงิน";
    Layout = "_Layout";

    var activeTab = ViewBag.ActiveTab as string ?? "bookings";
    var defaultBookingId = ViewBag.BookingId as string ?? "BK-2026-002";
    var fullName = ViewBag.FullName as string ?? "คุณณภัทร วงศ์เจริญ";
    var initial = !string.IsNullOrEmpty(fullName) ? fullName[0].ToString() : "U";
}

<!-- Profile Header Banner -->
<div class="card border-0 text-white mb-4 shadow-sm overflow-hidden position-relative"
     style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #2563eb 100%); border-radius: 18px;">
    <div class="card-body p-4 p-md-5">
        <div class="row align-items-center g-4">
            <div class="col-auto">
                <div class="position-relative">
                    <div class="d-flex align-items-center justify-content-center text-white fw-bold shadow-lg"
                         style="width: 86px; height: 86px; border-radius: 50%; font-size: 2.2rem; background: linear-gradient(135deg, #3b82f6, #1d4ed8); border: 4px solid rgba(255,255,255,0.25);">
                        @initial
                    </div>
                    <span class="position-absolute bottom-0 end-0 bg-success border border-2 border-white rounded-circle p-2" title="ออนไลน์"></span>
                </div>
            </div>
            <div class="col">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <h1 class="h3 fw-bold mb-0 text-white">@fullName</h1>
                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold" style="font-size: 0.78rem;">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">workspace_premium</span>
                        Gold Corporate Member
                    </span>
                    <span class="badge bg-secondary-subtle text-light border border-light-subtle px-2 py-1 rounded-pill" style="font-size:0.75rem;">
                        รหัสลูกค้า: CUST-6711607
                    </span>
                </div>
                <div class="d-flex flex-wrap gap-3 text-white-50 small mb-3">
                    <div class="d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined" style="font-size: 1rem;">apartment</span>
                        <span>บริษัท สยาม โลจิสติกส์ โซลูชั่นส์ จำกัด</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined" style="font-size: 1rem;">mail</span>
                        <span>naphat.w@siamlogistics.co.th</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined" style="font-size: 1rem;">call</span>
                        <span>089-765-4321</span>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Customer" asp-action="Search" class="btn btn-sm btn-warning text-dark fw-bold px-3 py-1 d-inline-flex align-items-center gap-1" style="border-radius: 8px;">
                        <span class="material-symbols-outlined" style="font-size: 1rem;">search</span>
                        ค้นหาสินค้า / คลังสินค้าเพิ่ม
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-light px-3 py-1 d-inline-flex align-items-center gap-1" style="border-radius: 8px;" onclick="switchProfileTab('info')">
                        <span class="material-symbols-outlined" style="font-size: 1rem;">edit</span>
                        แก้ไขข้อมูลโปรไฟล์
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="kpi-card" style="padding:1.1rem; cursor:pointer;" onclick="switchProfileTab('bookings')">
            <div style="display:flex; align-items:center; gap:0.75rem;">
                <div class="kpi-icon" style="background:#eff6ff; width:44px; height:44px; border-radius:10px; margin-bottom:0;">
                    <span class="material-symbols-outlined" style="font-size:1.4rem; color:#2563eb;">book_online</span>
                </div>
                <div>
                    <div class="kpi-value" style="font-size:1.5rem;">4</div>
                    <div class="kpi-label" style="font-size:0.75rem;">การจองทั้งหมด</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="kpi-card" style="padding:1.1rem; cursor:pointer;" onclick="switchProfileTab('payment')">
            <div style="display:flex; align-items:center; gap:0.75rem;">
                <div class="kpi-icon" style="background:#fffbeb; width:44px; height:44px; border-radius:10px; margin-bottom:0;">
                    <span class="material-symbols-outlined" style="font-size:1.4rem; color:#d97706;">pending_actions</span>
                </div>
                <div>
                    <div class="kpi-value text-danger" style="font-size:1.5rem;">1</div>
                    <div class="kpi-label" style="font-size:0.75rem;">รอการชำระเงิน</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="kpi-card" style="padding:1.1rem; cursor:pointer;" onclick="switchProfileTab('bookings')">
            <div style="display:flex; align-items:center; gap:0.75rem;">
                <div class="kpi-icon" style="background:#ecfdf5; width:44px; height:44px; border-radius:10px; margin-bottom:0;">
                    <span class="material-symbols-outlined" style="font-size:1.4rem; color:#059669;">verified</span>
                </div>
                <div>
                    <div class="kpi-value" style="font-size:1.5rem;">2</div>
                    <div class="kpi-label" style="font-size:0.75rem;">สัญญาที่ใช้งานอยู่</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="kpi-card" style="padding:1.1rem;">
            <div style="display:flex; align-items:center; gap:0.75rem;">
                <div class="kpi-icon" style="background:#faf5ff; width:44px; height:44px; border-radius:10px; margin-bottom:0;">
                    <span class="material-symbols-outlined" style="font-size:1.4rem; color:#9333ea;">stars</span>
                </div>
                <div>
                    <div class="kpi-value text-purple" style="font-size:1.5rem; color:#9333ea;">1,250</div>
                    <div class="kpi-label" style="font-size:0.75rem;">แต้มสะสม LogiPoints</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Nav Tabs for Profile Sections -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
    <div class="card-body p-2">
        <ul class="nav nav-pills nav-fill gap-2" id="profileTabNav" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link py-2 px-3 fw-bold d-flex align-items-center justify-content-center gap-2 @(activeTab == "bookings" ? "active" : "")"
                        id="tab-btn-bookings" onclick="switchProfileTab('bookings')" type="button">
                    <span class="material-symbols-outlined">book_online</span>
                    <span>การจองของฉัน</span>
                    <span class="badge bg-primary rounded-pill ms-1">4</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link py-2 px-3 fw-bold d-flex align-items-center justify-content-center gap-2 @(activeTab == "payment" ? "active" : "")"
                        id="tab-btn-payment" onclick="switchProfileTab('payment')" type="button">
                    <span class="material-symbols-outlined">payments</span>
                    <span>การชำระเงิน & ใบแจ้งหนี้</span>
                    <span class="badge bg-danger rounded-pill ms-1">1 รอชำระ</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link py-2 px-3 fw-bold d-flex align-items-center justify-content-center gap-2 @(activeTab == "info" ? "active" : "")"
                        id="tab-btn-info" onclick="switchProfileTab('info')" type="button">
                    <span class="material-symbols-outlined">person</span>
                    <span>ข้อมูลส่วนตัว & ที่อยู่</span>
                </button>
            </li>
        </ul>
    </div>
</div>

<!-- ========================================== -->
<!-- SECTION 1: MY BOOKINGS TAB -->
<!-- ========================================== -->
<div id="section-bookings" class="profile-section" style="@(activeTab == "bookings" ? "" : "display:none;")">
    <div class="section-card mb-4">
        <div class="section-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 class="h5 fw-bold mb-1" style="color:#0f172a;">
                    <span class="material-symbols-outlined align-middle text-primary me-1">receipt_long</span>
                    รายการจองห้องคลังสินค้าทั้งหมด (My Bookings)
                </h2>
                <p class="text-secondary small mb-0">ตรวจสอบสถานะสัญญา วันที่เริ่มเช่า และประวัติการจอง</p>
            </div>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" id="bookingFilterStatus" onchange="filterBookings()" style="border-radius: 8px; width:auto;">
                    <option value="all">ทุกสถานะการจอง</option>
                    <option value="pending">รอการยืนยัน / รอชำระ</option>
                    <option value="confirmed">ยืนยันแล้ว / ใช้งานอยู่</option>
                    <option value="cancelled">ยกเลิก</option>
                </select>
                <a asp-controller="Customer" asp-action="Search" class="btn btn-sm btn-primary d-flex align-items-center gap-1" style="border-radius:8px;">
                    <span class="material-symbols-outlined" style="font-size:1rem;">add</span>
                    จองห้องเพิ่ม
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table-custom w-100" id="bookingsTable">
                <thead>
                    <tr>
                        <th>รหัสการจอง</th>
                        <th>ห้องคลังสินค้า</th>
                        <th>ทำเล</th>
                        <th>ช่วงเวลาสัญญา</th>
                        <th>ค่าเช่ารวม</th>
                        <th>สถานะการจอง</th>
                        <th>การชำระเงิน</th>
                        <th class="text-center">การดำเนินการ</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Item 1: Pending Payment -->
                    <tr data-status="pending">
                        <td>
                            <span class="fw-bold text-primary">BK-2026-002</span>
                            <div class="text-muted" style="font-size:0.7rem;">จองเมื่อ 10 ก.ย. 2569</div>
                        </td>
                        <td>
                            <div class="fw-bold" style="font-size:0.9rem; color:#0f172a;">WN-B12</div>
                            <small class="text-muted">คลังสินค้าขนาดใหญ่ 500 ตร.ม.</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">location_on</span> วังน้อย
                            </span>
                        </td>
                        <td style="font-size:0.85rem; color:#475569;">1 ก.พ. 2569 — 31 ก.ค. 2569 (6 เดือน)</td>
                        <td>
                            <div class="fw-bold text-dark">฿275,000</div>
                            <small class="text-muted">มัดจำ ฿150,000</small>
                        </td>
                        <td>
                            <span class="badge-status badge-pending">รอการยืนยัน</span>
                        </td>
                        <td>
                            <span class="badge-status badge-pending text-danger fw-bold">⚠️ รอชำระเงิน</span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <button class="btn btn-sm btn-danger fw-bold d-inline-flex align-items-center gap-1"
                                        style="border-radius:6px; font-size:0.75rem; padding:0.35rem 0.75rem;"
                                        onclick="goToPaymentForBooking('BK-2026-002')">
                                    <span class="material-symbols-outlined" style="font-size:0.9rem;">payments</span>
                                    ชำระเงินทันที
                                </button>
                                <a asp-controller="Customer" asp-action="RoomDetail" asp-route-id="WN-B12" class="btn btn-sm btn-outline-secondary" style="border-radius:6px; font-size:0.75rem;">
                                    ดูห้อง
                                </a>
                            </div>
                        </td>
                    </tr>

                    <!-- Item 2: Confirmed -->
                    <tr data-status="confirmed">
                        <td>
                            <span class="fw-bold text-primary">BK-2026-001</span>
                            <div class="text-muted" style="font-size:0.7rem;">จองเมื่อ 15 ธ.ค. 2568</div>
                        </td>
                        <td>
                            <div class="fw-bold" style="font-size:0.9rem; color:#0f172a;">BN-A01</div>
                            <small class="text-muted">มาตรฐานสากล 150 ตร.ม.</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">location_on</span> บางนา กม.19
                            </span>
                        </td>
                        <td style="font-size:0.85rem; color:#475569;">1 ม.ค. 2569 — 30 มิ.ย. 2569 (6 เดือน)</td>
                        <td>
                            <div class="fw-bold text-dark">฿200,000</div>
                            <small class="text-muted">ชำระครบแล้ว</small>
                        </td>
                        <td>
                            <span class="badge-status badge-confirmed">ยืนยันแล้ว</span>
                        </td>
                        <td>
                            <span class="badge-status badge-paid">ชำระแล้ว</span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <button class="btn btn-sm btn-outline-primary" style="border-radius:6px; font-size:0.75rem;" onclick="alert('เปิดดูสัญญาเช่าห้อง BN-A01 (PDF)');">
                                    <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">description</span>
                                    สัญญา
                                </button>
                                <a asp-controller="Customer" asp-action="RoomDetail" asp-route-id="BN-A01" class="btn btn-sm btn-outline-secondary" style="border-radius:6px; font-size:0.75rem;">
                                    ดูห้อง
                                </a>
                            </div>
                        </td>
                    </tr>

                    <!-- Item 3: Past Confirmed -->
                    <tr data-status="confirmed">
                        <td>
                            <span class="fw-bold text-primary">BK-2025-018</span>
                            <div class="text-muted" style="font-size:0.7rem;">จองเมื่อ 20 มิ.ย. 2568</div>
                        </td>
                        <td>
                            <div class="fw-bold" style="font-size:0.9rem; color:#0f172a;">LC-C05</div>
                            <small class="text-muted">ห้องเย็นควบคุมอุณหภูมิ 200 ตร.ม.</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">location_on</span> แหลมฉบัง
                            </span>
                        </td>
                        <td style="font-size:0.85rem; color:#475569;">1 ก.ค. 2568 — 31 ธ.ค. 2568 (6 เดือน)</td>
                        <td>
                            <div class="fw-bold text-dark">฿130,000</div>
                            <small class="text-muted">ครบกำหนดสัญญา</small>
                        </td>
                        <td>
                            <span class="badge-status badge-confirmed">เสร็จสิ้นสัญญา</span>
                        </td>
                        <td>
                            <span class="badge-status badge-paid">ชำระแล้ว</span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <button class="btn btn-sm btn-outline-secondary" style="border-radius:6px; font-size:0.75rem;" onclick="alert('ดาวน์โหลดประวัติการเช่า LC-C05 เรียบร้อย');">
                                    <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">download</span>
                                    ประวัติ
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- Item 4: Cancelled -->
                    <tr data-status="cancelled">
                        <td>
                            <span class="fw-bold text-secondary">BK-2025-009</span>
                            <div class="text-muted" style="font-size:0.7rem;">จองเมื่อ 10 ธ.ค. 2567</div>
                        </td>
                        <td>
                            <div class="fw-bold" style="font-size:0.9rem; color:#0f172a;">BN-A01</div>
                            <small class="text-muted">150 ตร.ม.</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <span class="material-symbols-outlined align-middle" style="font-size:0.8rem;">location_on</span> บางนา
                            </span>
                        </td>
                        <td style="font-size:0.85rem; color:#6c757d;">1 ม.ค. 2568 — 30 มิ.ย. 2568</td>
                        <td>
                            <div class="fw-bold text-muted">฿200,000</div>
                            <small class="text-success">คืนเงินแล้ว</small>
                        </td>
                        <td>
                            <span class="badge-status badge-cancelled">ยกเลิก</span>
                        </td>
                        <td>
                            <span class="badge-status badge-paid">คืนเงินแล้ว</span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-center">
                                <span class="text-muted small">-</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- SECTION 2: PAYMENT & BILLING TAB -->
<!-- ========================================== -->
<div id="section-payment" class="profile-section" style="@(activeTab == "payment" ? "" : "display:none;")">
    <div class="row g-4 mb-4">
        <!-- Invoice Details & Checkout Form -->
        <div class="col-12 col-lg-7">
            <!-- Active Invoice Card -->
            <div class="section-card mb-4 border border-warning" style="border-width: 2px !important; background: #fffdf7;">
                <div class="section-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h5 fw-bold mb-0 text-dark">
                            <span class="material-symbols-outlined align-middle text-warning me-1">receipt_long</span>
                            ใบแจ้งยอดรอการชำระเงิน (Pending Bill)
                        </h2>
                    </div>
                    <span class="badge bg-danger text-white px-3 py-1 rounded-pill fw-bold">⚠️ รอชำระเงิน</span>
                </div>

                <div class="p-3 mb-3 bg-white rounded-3 border" style="font-size:0.875rem;">
                    <div class="row mb-2">
                        <div class="col-6 text-secondary">รหัสการจอง:</div>
                        <div class="col-6 fw-bold text-primary" id="payBookingIdDisplay">@defaultBookingId</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6 text-secondary">ห้องคลังสินค้า:</div>
                        <div class="col-6 fw-semibold">WN-B12 (วังน้อย อยุธยา - 500 ตร.ม.)</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6 text-secondary">ระยะเวลาสัญญาเช่า:</div>
                        <div class="col-6 fw-semibold">1 ก.พ. — 31 ก.ค. 2569 (6 เดือน)</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6 text-secondary">ค่าเช่ารวม (6 เดือน):</div>
                        <div class="col-6">฿450,000</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6 text-secondary">เงินประกันความเสียหาย (มัดจำ):</div>
                        <div class="col-6">฿150,000</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6 text-secondary">ภาษีมูลค่าเพิ่ม (VAT 7%):</div>
                        <div class="col-6">฿42,000</div>
                    </div>
                    <hr />
                    <div class="row fw-bold align-items-center">
                        <div class="col-6 fs-6">ยอดสุทธิที่ต้องชำระ:</div>
                        <div class="col-6 text-danger text-end fs-4" style="font-weight:800;">฿642,000</div>
                    </div>
                </div>

                <div class="alert alert-warning d-flex align-items-center gap-2 mb-0" style="border-radius:10px; font-size:0.82rem;">
                    <span class="material-symbols-outlined text-danger" style="font-size:1.3rem;">hourglass_top</span>
                    <div>
                        กำหนดชำระภายใน: <strong>16 ก.ย. 2569 ก่อนเวลา 23:59 น.</strong> (หากเกินกำหนด คำขอจองจะถูกยกเลิกโดยอัตโนมัติ)
                    </div>
                </div>
            </div>

            <!-- Payment Methods Card -->
            <div class="section-card">
                <div class="section-card-header">
                    <h2 class="h5 fw-bold mb-0 text-dark">
                        <span class="material-symbols-outlined align-middle text-primary me-1">credit_card</span>
                        เลือกช่องทางชำระเงิน (Select Payment Method)
                    </h2>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-4">
                        <label style="cursor:pointer; width:100%;">
                            <input type="radio" name="profilePaymentMethod" value="transfer" class="d-none" checked onchange="changeProfilePayMethod('transfer')" />
                            <div class="p-3 text-center payment-option-box active" id="pop_transfer" onclick="changeProfilePayMethod('transfer')">
                                <span class="material-symbols-outlined" style="font-size:1.8rem; color:#2563eb;">account_balance</span>
                                <div class="small fw-bold mt-1">โอนผ่านธนาคาร</div>
                            </div>
                        </label>
                    </div>
                    <div class="col-4">
                        <label style="cursor:pointer; width:100%;">
                            <input type="radio" name="profilePaymentMethod" value="qr" class="d-none" onchange="changeProfilePayMethod('qr')" />
