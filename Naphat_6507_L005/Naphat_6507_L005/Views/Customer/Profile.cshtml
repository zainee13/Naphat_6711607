@{
    ViewData["Title"] = "บัญชีของฉัน";
    Layout = "_Layout";

    var activeTab = ViewBag.ActiveTab as string ?? "bookings";
    if (activeTab != "bookings" && activeTab != "payment" && activeTab != "info") activeTab = "bookings";
    var fullName = ViewBag.FullName as string ?? "";

    // การจองของผู้ใช้ (ตอนต่อฐานข้อมูล ให้ดึงจากตาราง Bookings ของ user ที่ล็อกอิน)
    // ยอดคิดสูตรเดียวกับหน้า RoomDetail/BookRoom: ค่าเช่า x เดือน + ประกัน 2 เดือน + VAT 7% ของค่าเช่า
    var bookings = new[] {
        new { Id="BK-2026-002", Room="L-01",  Zone="โซน C1",       Period="1 ธ.ค. 2569 – 31 พ.ค. 2570", Months=6, Rate=75000, Status="pending",   Booked="9 พ.ย. 2569" },
        new { Id="BK-2026-001", Room="M-01",  Zone="โซน B1",       Period="1 ก.ค. – 31 ธ.ค. 2569",      Months=6, Rate=25000, Status="active",    Booked="15 มิ.ย. 2569" },
        new { Id="BK-2025-018", Room="CR-05", Zone="โซนห้องเย็น",   Period="1 ก.ค. – 31 ธ.ค. 2568",      Months=6, Rate=40000, Status="ended",     Booked="20 มิ.ย. 2568" },
        new { Id="BK-2025-009", Room="M-01",  Zone="โซน B1",       Period="1 ม.ค. – 30 มิ.ย. 2568",     Months=6, Rate=25000, Status="cancelled", Booked="10 ธ.ค. 2567" },
    };
    Func<int, int, (int Rent, int Deposit, int Vat, int Total)> calc = (rate, months) =>
    {
        var rent = rate * months; var deposit = rate * 2; var vat = (int)Math.Round(rent * 0.07);
        return (rent, deposit, vat, rent + deposit + vat);
    };
    var statusText = new Dictionary<string, string> {
        ["pending"] = "รอชำระเงิน", ["active"] = "ใช้งานอยู่", ["ended"] = "สิ้นสุดสัญญา", ["cancelled"] = "ยกเลิก คืนเงินแล้ว"
    };

    var due = bookings.First(b => b.Status == "pending");
    var dueAmt = calc(due.Rate, due.Months);
    var pendingCount = bookings.Count(b => b.Status == "pending");

    var payments = new[] {
        ("INV-2026-001", "M-01 สัญญา 6 เดือน",  calc(25000, 6).Total, "15 มิ.ย. 2569, โอนผ่าน SCB", "paid"),
        ("INV-2025-018", "CR-05 สัญญา 6 เดือน", calc(40000, 6).Total, "20 มิ.ย. 2568, บัตรเครดิต", "paid"),
        ("REF-2025-002", "คืนเงิน M-01 (ยกเลิก)", calc(25000, 6).Total, "12 ธ.ค. 2567, โอนคืนบัญชีเดิม", "refund"),
    };
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="pf cu">

    <header class="cu-head">
        <h1>บัญชีของฉัน</h1>
        <p>@(string.IsNullOrEmpty(fullName) ? "จัดการการจอง การชำระเงิน และข้อมูลออกใบกำกับภาษี" : fullName)</p>
    </header>

    <!-- แท็บ: เป็นลิงก์จริง (?tab=) และ JS สลับให้โดยไม่โหลดหน้าใหม่ -->
    <nav class="pf-tabs" role="tablist" aria-label="ส่วนของบัญชี">
        <a role="tab" id="tab-bookings" href="?tab=bookings" data-tab="bookings" aria-controls="panel-bookings" aria-selected="@(activeTab == "bookings" ? "true" : "false")">
            การจองของฉัน <span class="pf-count">@bookings.Length</span>
        </a>
        <a role="tab" id="tab-payment" href="?tab=payment" data-tab="payment" aria-controls="panel-payment" aria-selected="@(activeTab == "payment" ? "true" : "false")">
            ชำระเงิน @if (pendingCount > 0) { <span class="pf-count pf-count--due">@pendingCount รอชำระ</span> }
        </a>
        <a role="tab" id="tab-info" href="?tab=info" data-tab="info" aria-controls="panel-info" aria-selected="@(activeTab == "info" ? "true" : "false")">
            ข้อมูลส่วนตัว
        </a>
    </nav>

    <!-- ========== การจองของฉัน ========== -->
    <section class="pf-panel" id="panel-bookings" role="tabpanel" aria-labelledby="tab-bookings" @(activeTab == "bookings" ? "" : "hidden")>
        <div class="pf-panel-head">
            <h2 class="cu-h2">การจองของฉัน</h2>
            <a class="cu-btn" asp-controller="Customer" asp-action="Search">จองห้องเพิ่ม</a>
        </div>

        <ul class="pf-bookings">
            @foreach (var b in bookings)
            {
                var amt = calc(b.Rate, b.Months);
                <li class="pf-booking is-@b.Status">
                    <div class="pf-booking-room">
                        <a class="pf-room-code" asp-controller="Customer" asp-action="RoomDetail" asp-route-id="@b.Room">@b.Room</a>
                        <span>@b.Zone</span>
                    </div>
                    <div class="pf-booking-info">
                        <strong>@b.Period</strong>
                        <span>@b.Id, จองเมื่อ @b.Booked</span>
                    </div>
                    <span class="pf-status pf-status--@b.Status">@statusText[b.Status]</span>
                    <div class="pf-booking-amt">
                        <strong>฿@amt.Total.ToString("N0")</strong>
                        <span>@b.Months เดือน รวมประกันและ VAT</span>
                    </div>
                    <div class="pf-booking-act">
                        @if (b.Status == "pending")
                        {
                            <a class="cu-btn cu-btn--primary" href="?tab=payment" data-tab="payment">ชำระเงิน</a>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>

    <!-- ========== ชำระเงิน ========== -->
    <section class="pf-panel" id="panel-payment" role="tabpanel" aria-labelledby="tab-payment" @(activeTab == "payment" ? "" : "hidden")>
        <div class="pf-pay-layout">

            <div class="pf-pay-main">
                <h2 class="cu-h2">ยอดที่ต้องชำระ</h2>
                <div class="pf-bill">
                    <div class="pf-bill-head">
                        <div>
                            <strong class="pf-room-code">@due.Room</strong>
                            <span>@due.Id, @due.Period</span>
                        </div>
                        <span class="pf-status pf-status--pending">รอชำระเงิน</span>
                    </div>
                    <dl class="pf-calc" id="payCalc" data-rate="@due.Rate" data-months="@due.Months">
                        <div><dt>ค่าเช่า @due.Months เดือน</dt><dd>฿@dueAmt.Rent.ToString("N0")</dd></div>
                        <div><dt>เงินประกัน 2 เดือน</dt><dd>฿@dueAmt.Deposit.ToString("N0")</dd></div>
                        <div><dt>VAT 7%</dt><dd id="payVat">฿@dueAmt.Vat.ToString("N0")</dd></div>
                        <div class="pf-total"><dt>ยอดชำระ</dt><dd class="js-pay-total">฿@dueAmt.Total.ToString("N0")</dd></div>
                    </dl>

                    <!-- โค้ดส่วนลด -->
                    <form class="cu-promo" id="promoForm" novalidate>
                        <div class="cu-field">
                            <label for="promoInput">โค้ดส่วนลด</label>
                            <div class="cu-promo-row">
                                <input type="text" id="promoInput" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="เช่น MEGA35START" aria-describedby="promoMsg" />
                                <button type="submit" class="cu-btn">ใช้โค้ด</button>
                            </div>
                        </div>
                        <p class="cu-promo-msg" id="promoMsg" role="status" hidden></p>
                    </form>
                    <p class="pf-due">ชำระภายใน <strong>16 พ.ย. 2569, 23:59 น.</strong> ถ้าเลยกำหนด การจองจะถูกยกเลิก</p>
                </div>

                <h3 class="pf-h3">วิธีชำระเงิน</h3>
                <div class="pf-methods" role="radiogroup" aria-label="วิธีชำระเงิน">
                    <label><input type="radio" name="payMethod" value="transfer" checked /><span><i class="material-symbols-outlined" aria-hidden="true">account_balance</i>โอนเงิน</span></label>
                    <label><input type="radio" name="payMethod" value="qr" /><span><i class="material-symbols-outlined" aria-hidden="true">qr_code_2</i>พร้อมเพย์ QR</span></label>
                    <label><input type="radio" name="payMethod" value="card" /><span><i class="material-symbols-outlined" aria-hidden="true">credit_card</i>บัตรเครดิต / เดบิต</span></label>
                </div>

                <!-- โอนเงิน -->
                <form class="pf-method" data-method="transfer" id="payTransfer">
                    <dl class="pf-bank">
                        <div><dt>ธนาคาร</dt><dd>ไทยพาณิชย์ (SCB)</dd></div>
                        <div><dt>ชื่อบัญชี</dt><dd>บริษัท โลจิแมเนจ จำกัด</dd></div>
                        <div><dt>เลขบัญชี</dt><dd><span id="bankNo">123-4-56789-0</span> <button type="button" class="pf-copy" data-copy="1234567890">คัดลอก</button></dd></div>
                        <div><dt>ยอดโอน</dt><dd class="js-pay-total">฿@dueAmt.Total.ToString("N0")</dd></div>
                    </dl>
                    <label class="cu-field">
                        <span>สลิปโอนเงิน</span>
                        <input type="file" id="slipInput" accept="image/*" required />
                    </label>
                    <img id="slipPreview" class="pf-slip" alt="ตัวอย่างสลิปที่แนบ" hidden />
                    <button type="submit" class="cu-btn cu-btn--primary pf-pay-btn">แจ้งชำระเงิน</button>
                </form>

                <!-- QR -->
                <form class="pf-method" data-method="qr" hidden>
                    <div class="pf-qr">
                        <img id="payQr" src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=PROMPTPAY-@dueAmt.Total" alt="QR พร้อมเพย์" width="160" height="160" />
                        <p>สแกนด้วยแอปธนาคาร ยอด <strong class="js-pay-total">฿@dueAmt.Total.ToString("N0")</strong></p>
                    </div>
                    <button type="submit" class="cu-btn cu-btn--primary pf-pay-btn">ฉันชำระแล้ว</button>
                </form>

                <!-- บัตร -->
                <form class="pf-method" data-method="card" hidden>
                    <div class="pf-grid">
                        <label class="cu-field pf-span-2"><span>เลขบัตร</span><input type="text" inputmode="numeric" autocomplete="cc-number" maxlength="19" placeholder="0000 0000 0000 0000" required /></label>
                        <label class="cu-field pf-span-2"><span>ชื่อบนบัตร</span><input type="text" autocomplete="cc-name" required /></label>
                        <label class="cu-field"><span>หมดอายุ (ดด/ปป)</span><input type="text" inputmode="numeric" autocomplete="cc-exp" maxlength="5" placeholder="12/28" required /></label>
                        <label class="cu-field"><span>CVV</span><input type="password" inputmode="numeric" autocomplete="cc-csc" maxlength="4" required /></label>
                    </div>
                    <button type="submit" class="cu-btn cu-btn--primary pf-pay-btn">ชำระ <span class="js-pay-total">฿@dueAmt.Total.ToString("N0")</span></button>
                </form>

                <p class="pf-done" id="payDone" role="status" hidden>ได้รับแจ้งชำระเงินแล้ว เจ้าหน้าที่จะตรวจสอบและอัปเดตสถานะภายใน 15 นาที</p>
            </div>

            <aside class="pf-history" aria-labelledby="pf-history-title">
                <h2 class="cu-h2" id="pf-history-title">ประวัติการชำระ</h2>
                <ul>
                    @foreach (var p in payments)
                    {
                        <li class="@(p.Item5 == "refund" ? "is-refund" : "")">
                            <div class="pf-history-top">
                                <strong>@p.Item2</strong>
                                <span>@(p.Item5 == "refund" ? "−" : "")฿@p.Item3.ToString("N0")</span>
                            </div>
                            <span class="pf-history-meta">@p.Item1, @p.Item4</span>
                        </li>
                    }
                </ul>
            </aside>
        </div>
    </section>

    <!-- ========== ข้อมูลส่วนตัว ========== -->
    <section class="pf-panel" id="panel-info" role="tabpanel" aria-labelledby="tab-info" @(activeTab == "info" ? "" : "hidden")>
        <h2 class="cu-h2">ข้อมูลส่วนตัวและที่อยู่ออกใบกำกับภาษี</h2>
        <form class="pf-info" id="infoForm">
            <div class="pf-grid">
                <label class="cu-field"><span>ชื่อ-นามสกุล</span><input type="text" autocomplete="name" value="@fullName" required /></label>
                <label class="cu-field"><span>ชื่อบริษัท (ไม่บังคับ)</span><input type="text" autocomplete="organization" /></label>
                <label class="cu-field"><span>เบอร์โทร</span><input type="tel" autocomplete="tel" inputmode="tel" pattern="0\d{8,9}" placeholder="0812345678" required /></label>
                <label class="cu-field"><span>อีเมล</span><input type="email" autocomplete="email" placeholder="name@company.com" required /></label>
                <label class="cu-field"><span>เลขผู้เสียภาษี / เลขบัตรประชาชน</span><input type="text" inputmode="numeric" pattern="\d{13}" maxlength="13" placeholder="ตัวเลข 13 หลัก" /></label>
                <label class="cu-field pf-span-2"><span>ที่อยู่ออกใบกำกับภาษี</span><textarea rows="3" autocomplete="street-address"></textarea></label>
            </div>
            <div class="pf-info-actions">
                <button type="submit" class="cu-btn cu-btn--primary">บันทึกข้อมูล</button>
                <p class="pf-saved" id="infoSaved" role="status" hidden>บันทึกข้อมูลแล้ว</p>
            </div>
        </form>
        <p class="pf-help">ต้องการความช่วยเหลือ? โทร <a href="tel:021234567">02-123-4567</a> ทุกวัน 8:00–18:00</p>
    </section>
</div>

@section Scripts {
<script>
(function () {
    // ----- แท็บ -----
    const tabs = document.querySelectorAll('.pf-tabs [role=tab]');
    function show(name, push) {
        tabs.forEach(t => t.setAttribute('aria-selected', t.dataset.tab === name ? 'true' : 'false'));
        document.querySelectorAll('.pf-panel').forEach(p => p.hidden = p.id !== 'panel-' + name);
        if (push) history.replaceState(null, '', '?tab=' + name);
    }
    document.querySelectorAll('[data-tab]').forEach(a => a.addEventListener('click', e => {
        e.preventDefault();
        show(a.dataset.tab, true);
        if (!a.closest('.pf-tabs')) document.querySelector('.pf-tabs').scrollIntoView({ block: 'start' });
    }));
    // เดินด้วยลูกศรซ้ายขวาบนแท็บ
    document.querySelector('.pf-tabs').addEventListener('keydown', e => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const list = [...tabs], i = list.indexOf(document.activeElement);
        if (i < 0) return;
        const next = list[(i + (e.key === 'ArrowRight' ? 1 : list.length - 1)) % list.length];
        next.focus(); show(next.dataset.tab, true);
    });

    // ----- โค้ดส่วนลด: มีแค่หน้าตา ยังไม่คิดส่วนลด (รอทำตอนต่อ backend) -----
    const promoInput = document.getElementById('promoInput'), promoMsg = document.getElementById('promoMsg');
    document.getElementById('promoForm').addEventListener('submit', e => {
        e.preventDefault();
        promoMsg.textContent = promoInput.value.trim()
            ? 'ยังใช้โค้ดส่วนลดไม่ได้ในตอนนี้'
            : 'พิมพ์โค้ดส่วนลดก่อนกดใช้โค้ด';
        promoMsg.classList.remove('is-ok');
        promoMsg.hidden = false;
        promoInput.focus();
    });

    // ----- วิธีชำระเงิน -----
    const done = document.getElementById('payDone');
    document.querySelectorAll('input[name=payMethod]').forEach(r => r.addEventListener('change', () => {
        document.querySelectorAll('.pf-method').forEach(f => f.hidden = f.dataset.method !== r.value);
        done.hidden = true;
    }));

    document.querySelectorAll('.pf-copy').forEach(b => b.addEventListener('click', () => {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(b.dataset.copy).then(() => {
            b.textContent = 'คัดลอกแล้ว';
            setTimeout(() => b.textContent = 'คัดลอก', 1800);
        });
    }));

    const slip = document.getElementById('slipInput'), preview = document.getElementById('slipPreview');
    slip.addEventListener('change', () => {
        const f = slip.files[0];
        if (f) { preview.src = URL.createObjectURL(f); preview.hidden = false; }
        else preview.hidden = true;
    });

    // ยังไม่บันทึกลงฐานข้อมูล: แสดงข้อความยืนยันในหน้าเท่านั้น
    document.querySelectorAll('.pf-method').forEach(f => f.addEventListener('submit', e => {
        e.preventDefault();
        if (!f.reportValidity()) return;
        f.hidden = true;
        done.hidden = false;
        done.focus?.();
    }));

    const info = document.getElementById('infoForm'), saved = document.getElementById('infoSaved');
    info.addEventListener('submit', e => {
        e.preventDefault();
        if (!info.reportValidity()) return;
        saved.hidden = false;
        setTimeout(() => saved.hidden = true, 2500);
    });
})();
</script>
}
