@{
    ViewData["Title"] = "หน้าหลัก";
    Layout = "_Layout";
}

<!-- Executive Hero Banner -->
<div class="customer-hero-banner mb-4">
    <div class="customer-hero-overlay">
        <div class="row align-items-center g-4">
            <div class="col-12 col-xl-8">
                <span class="customer-hero-tag">
                    <span class="material-symbols-outlined" style="font-size:1rem;">verified</span>
                    LOGIMANAGE ENTERPRISE WAREHOUSE SOLUTIONS
                </span>
                <h1 class="customer-hero-title">
                    ระบบเช่าและบริหารคลังสินค้า<br />มาตรฐานสากล สำหรับธุรกิจยุคใหม่
                </h1>
                <p class="customer-hero-subtitle">
                    พื้นที่คลังสินค้าพร้อมใช้งานทันที ทำเลยุทธศาสตร์ รองรับรถบรรทุกทุกขนาด พร้อมระบบ AI CCTV 24 ชม. และสัญญาเช่ายืดหยุ่นสำหรับ SME และองค์กรธุรกิจ
                </p>

                <!-- Quick Search Bar inside Hero -->
                <div class="customer-quick-search mt-4">
                    <form asp-controller="Customer" asp-action="Search" method="get" class="row g-2 align-items-center">
                        <div class="col-12 col-md-5">
                            <label class="form-label text-dark small fw-bold mb-1 d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined text-primary" style="font-size:1.1rem;">aspect_ratio</span>
                                ขนาดคลังสินค้าที่ต้องการ
                            </label>
                            <select name="size" class="form-select border-0 bg-light py-2" style="border-radius:8px; font-weight:500;">
                                <option value="all">ทุกขนาดห้อง (30 - 1,200 ตร.ม.)</option>
                                <option value="s">📦 ไซส์ S (30 - 80 ตร.ม.) — SME &amp; ออนไลน์</option>
                                <option value="m">🏭 ไซส์ M (100 - 250 ตร.ม.) — ขนาดยอดนิยม วางพาเลท</option>
                                <option value="l">🚚 ไซส์ L (300 - 500 ตร.ม.) — คลังใหญ่ มี Dock Leveler</option>
                                <option value="xl">⚡ ไซส์ XL (600 - 1,200 ตร.ม.) — เมกะแวร์เฮ้าส์</option>
                                <option value="cold">❄️ ห้องเย็นควบคุมอุณหภูมิ (-18°C ถึง +5°C)</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-dark small fw-bold mb-1 d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined text-primary" style="font-size:1.1rem;">payments</span>
                                งบประมาณรายเดือน
                            </label>
                            <select name="price" class="form-select border-0 bg-light py-2" style="border-radius:8px; font-weight:500;">
                                <option value="all">ทุกช่วงราคา</option>
                                <option value="under20k">ต่ำกว่า 20,000 บาท/เดือน</option>
                                <option value="20k-50k">20,000 - 50,000 บาท/เดือน</option>
                                <option value="50k-100k">50,000 - 100,000 บาท/เดือน</option>
                                <option value="over100k">100,000 บาทขึ้นไป</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2" style="height:42px; border-radius:8px;">
                                <span class="material-symbols-outlined" style="font-size:1.2rem;">search</span>
                                <span>ค้นหาคลังว่าง</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-12 col-xl-4 d-none d-xl-block">
                <div class="p-4 rounded-4" style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); backdrop-filter:blur(10px);">
                    <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
                        <div class="rounded-circle p-2 bg-primary bg-opacity-25 text-info">
                            <span class="material-symbols-outlined" style="font-size:1.8rem;">verified_user</span>
                        </div>
                        <div>
                            <div class="text-white fw-bold">คลังสินค้าโครงการมาตรฐาน</div>
                            <div class="text-light small opacity-75">ผ่านการรับรองความปลอดภัยสากล</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mb-2 small text-light">
                        <span><span class="material-symbols-outlined align-middle me-1" style="font-size:1rem; color:#38bdf8;">check_circle</span>ยูนิตว่างพร้อมส่งมอบ</span>
                        <strong class="text-white">7 ยูนิต</strong>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mb-2 small text-light">
                        <span><span class="material-symbols-outlined align-middle me-1" style="font-size:1rem; color:#38bdf8;">check_circle</span>ระบบรักษาความปลอดภัย</span>
                        <strong class="text-white">AI CCTV 24 ชม.</strong>
                    </div>
                    <div class="d-flex align-items-center justify-content-between small text-light">
                        <span><span class="material-symbols-outlined align-middle me-1" style="font-size:1rem; color:#38bdf8;">check_circle</span>บริการสัญญาเช่า</span>
                        <strong class="text-white">ทำสัญญาออนไลน์ 100%</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Enterprise Trust Metrics -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi-card h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#eff6ff; width:48px; height:48px;">
                    <span class="material-symbols-outlined" style="color:#2563eb; font-size:1.6rem;">domain</span>
                </div>
                <div>
                    <div class="kpi-value fs-4">50,000+ ตร.ม.</div>
                    <div class="kpi-label">พื้นที่คลังรวมทุกโครงการ</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#ecfdf5; width:48px; height:48px;">
                    <span class="material-symbols-outlined" style="color:#059669; font-size:1.6rem;">local_shipping</span>
                </div>
                <div>
                    <div class="kpi-value fs-4">18 ล้อ &amp; 40ft</div>
                    <div class="kpi-label">Dock Leveler เทียบตู้คอนเทนเนอร์</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#fffbeb; width:48px; height:48px;">
                    <span class="material-symbols-outlined" style="color:#d97706; font-size:1.6rem;">security</span>
                </div>
                <div>
                    <div class="kpi-value fs-4">24 / 7 ชม.</div>
                    <div class="kpi-label">รปภ. และ CCTV แยกแต่ละห้อง</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#faf5ff; width:48px; height:48px;">
                    <span class="material-symbols-outlined" style="color:#9333ea; font-size:1.6rem;">thumb_up</span>
                </div>
                <div>
                    <div class="kpi-value fs-4">99.8%</div>
                    <div class="kpi-label">ความพึงพอใจลูกค้าธุรกิจ &amp; SME</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Size Solution Categories -->
<div class="section-card mb-4">
    <div class="section-card-header">
        <div>
            <h2><span class="material-symbols-outlined">category</span> เลือกระดับขนาดห้องคลังสินค้าที่เหมาะกับธุรกิจ</h2>
            <p class="text-secondary small mb-0">คลังสินค้าของเราแบ่งขนาดชัดเจน รองรับตั้งแต่วางพาเลทเริ่มต้นจนถึงศูนย์กระจายสินค้า</p>
        </div>
        <a asp-controller="Customer" asp-action="Search" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
            <span>ดูห้องว่างทั้งหมด</span>
            <span class="material-symbols-outlined" style="font-size:1rem;">arrow_forward</span>
        </a>
    </div>

    <div class="row g-3">
        <!-- Size S -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="customer-feature-tile h-100 d-flex flex-column">
                <div class="customer-feature-icon" style="background:#eff6ff; color:#2563eb;">
                    <span class="material-symbols-outlined" style="font-size:1.8rem;">inventory_2</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="badge bg-primary-subtle text-primary fw-bold" style="font-size:0.75rem;">ไซส์ S (30 - 80 ตร.ม.)</span>
                    <small class="text-muted">ความสูง 6 ม.</small>
                </div>
                <h3 class="h6 fw-bold text-dark mt-1">SME &amp; ธุรกิจออนไลน์</h3>
                <p class="text-secondary small mb-3 flex-grow-1">
                    ประตูม้วนไฟฟ้า สะดวกต่อการโหลดสินค้าด้วยรถกระบะ/4 ล้อ เหมาะสำหรับสต็อกพร้อมส่ง
                </p>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <div>
                        <small class="text-muted d-block" style="font-size:0.7rem;">เริ่มต้นเพียง</small>
                        <strong class="text-primary" style="font-size:0.95rem;">฿12,000 / ด.</strong>
                    </div>
                    <a asp-controller="Customer" asp-action="Search" asp-route-size="s" class="btn btn-light btn-sm px-2 py-1">
                        ดูห้องไซส์ S
                    </a>
                </div>
            </div>
        </div>

        <!-- Size M -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="customer-feature-tile h-100 d-flex flex-column" style="border: 2px solid #93c5fd;">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="customer-feature-icon" style="background:#dbeafe; color:#1d4ed8; margin-bottom:0;">
                        <span class="material-symbols-outlined" style="font-size:1.8rem;">shelves</span>
                    </div>
                    <span class="badge bg-primary text-white fw-bold" style="font-size:0.7rem;">ขนาดยอดนิยม</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="badge bg-primary-subtle text-primary fw-bold" style="font-size:0.75rem;">ไซส์ M (100 - 250 ตร.ม.)</span>
                    <small class="text-muted">ความสูง 8 ม.</small>
                </div>
                <h3 class="h6 fw-bold text-dark mt-1">Commercial Pallet</h3>
                <p class="text-secondary small mb-3 flex-grow-1">
                    พื้นอีพ็อกซี่รับน้ำหนัก 3 ตัน/ตร.ม. โฟล์คลิฟต์เข้าสะดวก ติดตั้ง Racking ได้ วางพาเลท 60-120 ตัว
                </p>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <div>
                        <small class="text-muted d-block" style="font-size:0.7rem;">เริ่มต้นเพียง</small>
                        <strong class="text-primary" style="font-size:0.95rem;">฿25,000 / ด.</strong>
                    </div>
                    <a asp-controller="Customer" asp-action="Search" asp-route-size="m" class="btn btn-primary btn-sm px-2 py-1">
                        ดูห้องไซส์ M
                    </a>
                </div>
            </div>
        </div>

        <!-- Size L -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="customer-feature-tile h-100 d-flex flex-column">
                <div class="customer-feature-icon" style="background:#ecfdf5; color:#059669;">
                    <span class="material-symbols-outlined" style="font-size:1.8rem;">rv_hookup</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="badge bg-success-subtle text-success fw-bold" style="font-size:0.75rem;">ไซส์ L (300 - 500 ตร.ม.)</span>
                    <small class="text-muted">ความสูง 10 ม.</small>
                </div>
                <h3 class="h6 fw-bold text-dark mt-1">Logistics &amp; มี Dock</h3>
                <p class="text-secondary small mb-3 flex-grow-1">
                    รองรับรถพ่วง 18 ล้อ พร้อม Dock Leveler ชานชาลาปรับระดับอัตโนมัติ โหลดตู้สินค้าเร็ว
                </p>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <div>
                        <small class="text-muted d-block" style="font-size:0.7rem;">เริ่มต้นเพียง</small>
                        <strong class="text-primary" style="font-size:0.95rem;">฿55,000 / ด.</strong>
                    </div>
                    <a asp-controller="Customer" asp-action="Search" asp-route-size="l" class="btn btn-light btn-sm px-2 py-1">
                        ดูห้องไซส์ L
                    </a>
                </div>
            </div>
        </div>

        <!-- Size XL & Cold Storage -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="customer-feature-tile h-100 d-flex flex-column">
                <div class="customer-feature-icon" style="background:#fef3c7; color:#d97706;">
                    <span class="material-symbols-outlined" style="font-size:1.8rem;">ac_unit</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="badge bg-warning-subtle text-warning-emphasis fw-bold" style="font-size:0.75rem;">XL &amp; ห้องเย็น</span>
                    <small class="text-muted">-18°C ถึง +5°C</small>
                </div>
                <h3 class="h6 fw-bold text-dark mt-1">Mega &amp; Cold Chain</h3>
                <p class="text-secondary small mb-3 flex-grow-1">
                    ห้องเย็นควบคุมอุณหภูมิสำหรับอาหาร/เวชภัณฑ์ หรือเมกะแวร์เฮ้าส์ 1,200 ตร.ม. พร้อมออฟฟิศในตัว
                </p>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <div>
                        <small class="text-muted d-block" style="font-size:0.7rem;">เริ่มต้นเพียง</small>
                        <strong class="text-primary" style="font-size:0.95rem;">฿40,000 / ด.</strong>
                    </div>
                    <a asp-controller="Customer" asp-action="Search" asp-route-size="cold" class="btn btn-light btn-sm px-2 py-1">
                        ดูห้องควบคุมพิเศษ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section: บริการของเรา (Icon-Centric & Concise) -->
<div class="section-card mb-4">
    <div class="section-card-header">
        <div>
            <h2><span class="material-symbols-outlined text-primary">hub</span> บริการของเรา</h2>
            <p class="text-secondary small mb-0">บริการคลังสินค้าและระบบบริหารพื้นที่จัดเก็บสินค้าครบวงจร</p>
        </div>
        <a asp-controller="Customer" asp-action="Search" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
            <span>ดูห้องว่างทั้งหมด</span>
            <span class="material-symbols-outlined" style="font-size:1rem;">arrow_forward</span>
        </a>
    </div>

    <div class="row g-3 text-center">
        <!-- 1. เช่าคลังสินค้า -->
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100 d-flex flex-column align-items-center justify-content-center" style="background:#ffffff; border:1px solid #e2e8f0; transition: transform 0.15s ease;">
                <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary mb-2" style="width:54px; height:54px; display:flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:1.9rem;">warehouse</span>
                </div>
                <strong class="text-dark small d-block mb-1">เช่าคลังสินค้า</strong>
                <span class="text-muted" style="font-size:0.75rem;">ไซส์ S ถึง XL &amp; ห้องเย็น</span>
            </div>
        </div>

        <!-- 2. จองออนไลน์ 100% -->
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100 d-flex flex-column align-items-center justify-content-center" style="background:#ffffff; border:1px solid #e2e8f0; transition: transform 0.15s ease;">
                <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success mb-2" style="width:54px; height:54px; display:flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:1.9rem;">history_edu</span>
                </div>
                <strong class="text-dark small d-block mb-1">จองออนไลน์ 100%</strong>
                <span class="text-muted" style="font-size:0.75rem;">สัญญาดิจิทัล 24 ชม.</span>
            </div>
        </div>

        <!-- 3. ชานชาลาเทียบตู้ 18 ล้อ -->
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100 d-flex flex-column align-items-center justify-content-center" style="background:#ffffff; border:1px solid #e2e8f0; transition: transform 0.15s ease;">
                <div class="rounded-circle p-2 bg-warning bg-opacity-10 text-warning mb-2" style="width:54px; height:54px; display:flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:1.9rem;">rv_hookup</span>
                </div>
                <strong class="text-dark small d-block mb-1">เทียบตู้คอนเทนเนอร์</strong>
                <span class="text-muted" style="font-size:0.75rem;">Dock Leveler &amp; 18 ล้อ</span>
            </div>
        </div>

        <!-- 4. บริการโฟล์คลิฟต์ -->
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100 d-flex flex-column align-items-center justify-content-center" style="background:#ffffff; border:1px solid #e2e8f0; transition: transform 0.15s ease;">
                <div class="rounded-circle p-2 bg-info bg-opacity-10 text-info mb-2" style="width:54px; height:54px; display:flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:1.9rem;">forklift</span>
                </div>
                <strong class="text-dark small d-block mb-1">บริการโฟล์คลิฟต์</strong>
                <span class="text-muted" style="font-size:0.75rem;">พร้อมคนขับช่วยขนถ่าย</span>
            </div>
        </div>

        <!-- 5. ความปลอดภัย 24/7 -->
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100 d-flex flex-column align-items-center justify-content-center" style="background:#ffffff; border:1px solid #e2e8f0; transition: transform 0.15s ease;">
                <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger mb-2" style="width:54px; height:54px; display:flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:1.9rem;">security</span>
                </div>
                <strong class="text-dark small d-block mb-1">ความปลอดภัย 24/7</strong>
                <span class="text-muted" style="font-size:0.75rem;">AI CCTV แยกห้อง + รปภ.</span>
            </div>
        </div>

        <!-- 6. ใบกำกับภาษี & บิลลิ่ง -->
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100 d-flex flex-column align-items-center justify-content-center" style="background:#ffffff; border:1px solid #e2e8f0; transition: transform 0.15s ease;">
                <div class="rounded-circle p-2 mb-2" style="width:54px; height:54px; display:flex; align-items:center; justify-content:center; background:#f3e8ff; color:#7e22ce;">
                    <span class="material-symbols-outlined" style="font-size:1.9rem;">receipt_long</span>
                </div>
                <strong class="text-dark small d-block mb-1">ใบกำกับภาษี &amp; บิล</strong>
                <span class="text-muted" style="font-size:0.75rem;">QR Code &amp; นิติบุคคล</span>
            </div>
        </div>
    </div>
</div>

<!-- Section: แก้ปัญหาอะไรให้ธุรกิจ (Pain Points Solved) + Member/Guest Card -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-8">
        <div class="section-card h-100 mb-0">
            <div class="section-card-header">
                <div>
                    <h2><span class="material-symbols-outlined text-success">task_alt</span> เราช่วยแก้ปัญหาอะไร?</h2>
