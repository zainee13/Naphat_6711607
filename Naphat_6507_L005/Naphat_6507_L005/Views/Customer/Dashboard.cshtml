@{
    ViewData["Title"] = "ข่าวสารและโปรโมชันพิเศษ";
    Layout = "_Layout";
}

<div class="customer-dashboard">
    <div class="customer-dashboard-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-4">
        <div>
            <div class="customer-eyebrow">
                <span class="material-symbols-outlined">verified</span>
                LOGIMANAGE PRIVILEGES &amp; OFFERS
            </div>
            <h1>ข่าวสารและโปรโมชันพิเศษ</h1>
            <p>ข้อเสนอสุดคุ้มและสิทธิพิเศษสำหรับสมาชิก LogiManage เท่านั้น</p>
        </div>
        <a asp-controller="Customer" asp-action="Search" class="btn customer-primary-action d-inline-flex align-items-center gap-2">
            <span class="material-symbols-outlined">search</span>
            ค้นหาคลังสินค้าทันที
            <span aria-hidden="true">→</span>
        </a>
    </div>

    <section class="customer-promo-hero" aria-label="โปรโมชันประจำเดือน">
        <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=1600&amp;q=85" alt="คลังสินค้าอัจฉริยะ LogiManage" />
        <div class="customer-promo-overlay">
            <span class="customer-promo-label">โปรโมชันประจำเดือน · Limited Offer</span>
            <h2>เช่าคลังสินค้า Smart Warehouse รับส่วนลดสูงสุด 20% เดือนแรก</h2>
            <p>สำหรับสัญญาเช่าตั้งแต่ 6 เดือนขึ้นไป ในทำเลยุทธศาสตร์ พร้อมระบบรักษาความปลอดภัย 24 ชม. และแท่นโหลดสินค้าอัตโนมัติ</p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Customer" asp-action="Search" class="btn customer-light-action">รับสิทธิ์โปรโมชัน</a>
                <a asp-controller="Customer" asp-action="Search" class="btn customer-outline-light-action">ดูห้องที่ร่วมรายการ</a>
            </div>
        </div>
    </section>

    <section class="customer-campaigns">
        <div class="d-flex justify-content-between align-items-end gap-3 mb-4">
            <h2 class="customer-section-title"><span class="material-symbols-outlined">local_offer</span>สิทธิพิเศษและแคมเปญแนะนำ</h2>
            <span class="customer-update-note">อัปเดตล่าสุดสัปดาห์นี้</span>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4">
                <article class="customer-campaign-card">
                    <div class="customer-campaign-image">
                        <img src="https://images.unsplash.com/photo-1553413077-190dd305871c?w=900&amp;q=85" alt="คลังสินค้าสำหรับธุรกิจใหม่" />
                        <span class="customer-campaign-tag customer-tag-coral">ดีลพิเศษธุรกิจใหม่</span>
                    </div>
                    <div class="customer-campaign-body">
                        <h3>ฟรี! ค่าส่วนกลางและประกัน 3 เดือนแรก</h3>
                        <p>สิทธิพิเศษเมื่อจองคลังขนาด 500 ตร.ม. ขึ้นไป ช่วยประหยัดต้นทุนเริ่มต้นธุรกิจได้ทันที</p>
                        <a asp-controller="Customer" asp-action="Search" asp-route-size="l" class="btn customer-campaign-button customer-campaign-button-fill"><span class="material-symbols-outlined">redeem</span>ดูห้องที่ร่วมรายการ</a>
                    </div>
                </article>
            </div>

            <div class="col-12 col-md-4">
                <article class="customer-campaign-card">
                    <div class="customer-campaign-visual customer-visual-blue">
                        <span class="customer-campaign-tag customer-tag-glass">อุปกรณ์จัดเก็บครบครัน</span>
                        <span class="material-symbols-outlined customer-visual-icon">shelves</span>
                        <strong>Racking &amp; Forklift Ready</strong>
                    </div>
                    <div class="customer-campaign-body">
                        <h3>บริการชั้นวาง &amp; รถโฟล์คลิฟท์ประจำอาคาร</h3>
                        <p>บริการเสริมชั้นวางอุตสาหกรรมและรถโฟล์คลิฟท์ ช่วยให้เริ่มจัดเก็บสินค้าได้ทันที</p>
                        <a asp-controller="Customer" asp-action="Search" class="btn customer-campaign-button customer-campaign-button-outline"><span class="material-symbols-outlined">info</span>ดูพื้นที่พร้อมบริการ</a>
                    </div>
                </article>
            </div>

            <div class="col-12 col-md-4">
                <article class="customer-campaign-card">
                    <div class="customer-campaign-visual customer-visual-green">
                        <span class="customer-campaign-tag customer-tag-green">แนะนำเพื่อน</span>
                        <span class="material-symbols-outlined customer-visual-icon">group_add</span>
                        <strong>Referral Program</strong>
                    </div>
                    <div class="customer-campaign-body">
                        <h3>ชวนพันธมิตรมาเช่าคลัง รับ Cash Back ฿5,000</h3>
                        <p>ทั้งคุณและเพื่อนจะได้รับเครดิตค่าเช่างวดถัดไปทันทีเมื่อทำสัญญาสำเร็จ</p>
                        <a asp-controller="Customer" asp-action="Profile" class="btn customer-campaign-button customer-campaign-button-fill"><span class="material-symbols-outlined">share</span>ดูสิทธิ์สมาชิก</a>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="customer-dashboard-cta d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
        <div>
            <div class="customer-cta-kicker"><span class="material-symbols-outlined">travel_explore</span>พื้นที่พร้อมใช้งานครอบคลุมทุกภูมิภาค</div>
            <h2>กำลังมองหาพื้นที่คลังสินค้าที่เหมาะกับคุณอยู่ใช่ไหม?</h2>
            <p>มียูนิตว่างพร้อมส่งมอบกว่า 50 แห่งทั่วประเทศ พร้อมสัญญาเช่ายืดหยุ่น</p>
        </div>
        <a asp-controller="Customer" asp-action="Search" class="btn customer-cta-button">ไปที่หน้าค้นหาคลังสินค้า <span aria-hidden="true">→</span></a>
    </section>
</div>
