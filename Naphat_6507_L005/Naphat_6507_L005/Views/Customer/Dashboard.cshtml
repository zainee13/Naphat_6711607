@{
    ViewData["Title"] = "หน้าหลัก — ค้นหาและเช่าคลังสินค้า";
    Layout = "_Layout";
}

<!-- Hero Promotion Banner -->
<div class="card border-0 text-white mb-4 overflow-hidden position-relative shadow-lg"
     style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #06b6d4 100%); border-radius: 18px;">
    <div class="row g-0 align-items-center">
        <div class="col-lg-7 p-4 p-md-5">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill"
                 style="background: rgba(255,255,255,0.2); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.3); font-size: 0.85rem;">
                <span class="material-symbols-outlined" style="font-size: 1.1rem; color: #fde047;">bolt</span>
                <span class="fw-semibold">SPECIAL PROMOTION 2026</span>
            </div>
            <h1 class="display-6 fw-bold mb-3" style="line-height: 1.25;">
                ขยายธุรกิจไร้ขีดจำกัด<br />
                <span style="color: #fde047; text-shadow: 0 2px 8px rgba(0,0,0,0.2);">ลดค่าเช่าสูงสุด 35%</span> เดือนแรก!
            </h1>
            <p class="mb-4 text-white-50" style="font-size: 1rem; max-width: 520px; line-height: 1.6;">
                พื้นที่คลังสินค้ามาตรฐานระดับสากล ติดตั้งระบบรักษาความปลอดภัย AI 24 ชม. 
                พร้อมฟรีค่าประกันสินค้าคุ้มครองสูงสุด 1 ล้านบาท เมื่อทำสัญญาจองภายในเดือนนี้
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Customer" asp-action="Search" class="btn btn-warning btn-lg fw-bold px-4 py-2 d-inline-flex align-items-center gap-2 shadow"
                   style="border-radius: 10px; color: #1e293b; background: linear-gradient(135deg, #fde047, #eab308); border: none;">
                    <span class="material-symbols-outlined">search</span>
                    ค้นหาสินค้าและคลังสินค้า
                </a>
                <a asp-controller="Customer" asp-action="Profile" class="btn btn-outline-light btn-lg px-4 py-2 d-inline-flex align-items-center gap-2"
                   style="border-radius: 10px; backdrop-filter: blur(4px);">
                    <span class="material-symbols-outlined">account_circle</span>
                    โปรไฟล์ (การจอง & ชำระเงิน)
                </a>
            </div>
        </div>
        <div class="col-lg-5 text-center p-4 d-none d-lg-block">
            <div class="position-relative d-inline-block">
                <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&q=80"
                     alt="Promo Warehouse"
                     class="img-fluid rounded-4 shadow-lg"
                     style="max-height: 280px; object-fit: cover; border: 4px solid rgba(255,255,255,0.3); transform: rotate(1.5deg);" />
                <div class="badge bg-danger position-absolute top-0 end-0 p-3 rounded-pill shadow-lg"
                     style="font-size: 1rem; transform: translate(15%, -20%); border: 3px solid #fff;">
                    🔥 FLASH SALE!
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Search Card (ค้นหาสินค้า & คลังสินค้า) -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:16px; background:#ffffff;">
    <div class="card-body p-4">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="material-symbols-outlined text-primary" style="font-size:1.5rem;">search</span>
            <h2 class="h5 fw-bold mb-0" style="color:#0f172a;">ค้นหาสินค้าและห้องคลังสินค้า (Search Warehouses)</h2>
        </div>
        <form asp-controller="Customer" asp-action="Search" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">location_on</span>
                        ทำเลที่ตั้งคลังสินค้า
                    </label>
                    <select class="form-select" name="location" style="border-radius:8px;">
                        <option value="">ทุกทำเล (บางนา, วังน้อย, แหลมฉบัง, ลาดกระบัง)</option>
                        <option value="บางนา">บางนา กม.19 (กรุงเทพฯ - สมุทรปราการ)</option>
                        <option value="วังน้อย">วังน้อย (อยุธยา - สู่ภาคเหนือ/อีสาน)</option>
                        <option value="แหลมฉบัง">แหลมฉบัง (ชลบุรี - ท่าเรือส่งออก)</option>
                        <option value="ลาดกระบัง">ลาดกระบัง (สุวรรณภูมิ & ICD)</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">square_foot</span>
                        ขนาดพื้นที่จัดเก็บ
                    </label>
                    <select class="form-select" name="size" style="border-radius:8px;">
                        <option value="">ทุกขนาดพื้นที่</option>
                        <option value="s">50 - 100 ตร.ม. (SME)</option>
                        <option value="m">101 - 300 ตร.ม. (ขนาดยอดนิยม)</option>
                        <option value="l">301 - 500 ตร.ม. (ธุรกิจขนาดใหญ่)</option>
                        <option value="xl">500+ ตร.ม. (ศูนย์กระจายสินค้า)</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">payments</span>
                        งบประมาณ / เดือน
                    </label>
                    <select class="form-select" name="price" style="border-radius:8px;">
                        <option value="">ทุกช่วงราคา</option>
                        <option value="under20k">ต่ำกว่า 20,000 บาท</option>
                        <option value="20k-50k">20,000 - 50,000 บาท</option>
                        <option value="50k-100k">50,000 - 100,000 บาท</option>
                        <option value="over100k">100,000 บาทขึ้นไป</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-bold d-flex align-items-center justify-content-center gap-1 shadow-sm"
                            style="border-radius:8px; height:38px; background:linear-gradient(135deg, #2563eb, #1d4ed8); border:none;">
                        <span class="material-symbols-outlined" style="font-size:1.1rem;">search</span>
                        ค้นหา
                    </button>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-2 border-top">
                <span class="text-secondary small fw-semibold">คำค้นยอดนิยม:</span>
                <a asp-controller="Customer" asp-action="Search" class="badge bg-light text-dark border text-decoration-none py-1 px-2" style="border-radius:20px;">❄️ ห้องเย็นแหลมฉบัง</a>
                <a asp-controller="Customer" asp-action="Search" class="badge bg-light text-dark border text-decoration-none py-1 px-2" style="border-radius:20px;">🚚 วังน้อย 500 ตร.ม.</a>
                <a asp-controller="Customer" asp-action="Search" class="badge bg-light text-dark border text-decoration-none py-1 px-2" style="border-radius:20px;">📦 บางนา มาตรฐานสากล</a>
                <a asp-controller="Customer" asp-action="Search" class="badge bg-light text-dark border text-decoration-none py-1 px-2" style="border-radius:20px;">🏷️ ยูนิตลดราคา Flash Sale</a>
            </div>
        </form>
    </div>
</div>

<!-- Profile Quick Access Card -->
<div class="alert border-0 shadow-sm d-flex flex-wrap align-items-center justify-content-between p-3 mb-4"
     style="background: #ffffff; border-left: 5px solid #2563eb !important; border-radius: 12px;">
    <div class="d-flex align-items-center gap-3">
        <div class="d-flex align-items-center justify-content-center rounded-circle shadow-sm"
             style="width: 44px; height: 44px; background: #eff6ff; color: #2563eb;">
            <span class="material-symbols-outlined" style="font-size:1.4rem;">account_circle</span>
        </div>
        <div>
            <div class="fw-bold text-dark">จัดการการจองของฉัน และ การชำระเงิน ได้ในหน้าโปรไฟล์</div>
            <div class="text-secondary small">ตรวจสอบสถานะสัญญาจองคลังสินค้า, ชำระเงินผ่าน QR หรือสลิปธนาคาร, และดาวน์โหลดใบเสร็จรับเงิน</div>
        </div>
    </div>
    <a asp-controller="Customer" asp-action="Profile" class="btn btn-sm btn-outline-primary fw-bold px-3 py-2 d-inline-flex align-items-center gap-1" style="border-radius: 8px;">
        <span>ไปยังหน้าโปรไฟล์</span>
        <span class="material-symbols-outlined" style="font-size: 1rem;">arrow_forward</span>
    </a>
</div>

<!-- Coupons & Special Offers Section -->
<div id="coupon-section" class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h4 fw-bold mb-1" style="color: #0f172a;">
                <span class="material-symbols-outlined align-middle text-warning me-1">sell</span>
                คูปองส่วนลดพิเศษ (Claim Coupons)
            </h2>
            <p class="text-secondary small mb-0">กดคัดลอกโค้ดเพื่อนำไปกรอกในหน้าจองเพื่อรับส่วนลดทันที</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 14px; background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); border-left: 5px solid #f97316 !important;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-orange text-white" style="background:#ea580c; font-size:0.75rem;">ลูกค้าใหม่</span>
                        <small class="text-muted">หมดเขต 30 เม.ย.</small>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-1">ลดทันที 30%</h3>
                    <p class="text-secondary small mb-3">สำหรับค่าเช่าคลังสินค้าเดือนแรก เมื่อเช่าสัญญา 6 เดือนขึ้นไป</p>
                    <div class="d-flex align-items-center justify-content-between bg-white p-2 rounded-3 border">
                        <code class="fw-bold fs-6 text-primary">NEWCUSTOMER30</code>
                        <button class="btn btn-sm btn-outline-primary py-1 px-2" onclick="navigator.clipboard.writeText('NEWCUSTOMER30'); alert('คัดลอกโค้ด NEWCUSTOMER30 เรียบร้อย!');">
                            คัดลอก
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 14px; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-left: 5px solid #2563eb !important;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary" style="font-size:0.75rem;">SME Special</span>
                        <small class="text-muted">เหลือ 8 สิทธิ์</small>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-1">ส่วนลด 5,000 บาท</h3>
                    <p class="text-secondary small mb-3">เมื่อจองคลังขนาดยอดนิยม 100 - 300 ตร.ม. ทุกทำเล</p>
                    <div class="d-flex align-items-center justify-content-between bg-white p-2 rounded-3 border">
                        <code class="fw-bold fs-6 text-primary">SMEGROWTH</code>
                        <button class="btn btn-sm btn-outline-primary py-1 px-2" onclick="navigator.clipboard.writeText('SMEGROWTH'); alert('คัดลอกโค้ด SMEGROWTH เรียบร้อย!');">
                            คัดลอก
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 14px; background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-left: 5px solid #16a34a !important;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-success" style="font-size:0.75rem;">ระยะยาวคุ้มสุด</span>
                        <small class="text-muted">ตลอดปี 2026</small>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-1">ฟรีค่าเช่า 1 เดือน!</h3>
                    <p class="text-secondary small mb-3">สัญญาเช่า 12 เดือนขึ้นไป ฟรีเดือนที่ 12 + บริการรถยกฟรี 10 ชม.</p>
                    <div class="d-flex align-items-center justify-content-between bg-white p-2 rounded-3 border">
                        <code class="fw-bold fs-6 text-success">LONGTERM12</code>
                        <button class="btn btn-sm btn-outline-success py-1 px-2" onclick="navigator.clipboard.writeText('LONGTERM12'); alert('คัดลอกโค้ด LONGTERM12 เรียบร้อย!');">
                            คัดลอก
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Promotional Featured Warehouses (Hot Deals) -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h4 fw-bold mb-1" style="color: #0f172a;">
                <span class="material-symbols-outlined align-middle text-danger me-1">local_fire_department</span>
                ยูนิตแนะนำโปรโมชั่นสุดคุ้ม (Hot Promotional Units)
            </h2>
            <p class="text-secondary small mb-0">คลังสินค้าราคาสุดพิเศษ ลดเฉพาะช่วงแคมเปญนี้เท่านั้น</p>
        </div>
        <a asp-controller="Customer" asp-action="Search" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" style="border-radius:8px;">
            <span>ดูคลังสินค้าทั้งหมด</span>
            <span class="material-symbols-outlined" style="font-size: 1.1rem;">chevron_right</span>
        </a>
    </div>

    <div class="row g-4">
        <!-- Hot Deal 1 -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 overflow-hidden" style="border-radius:14px;">
                <div class="position-relative" style="height: 180px;">
                    <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&q=80"
                         alt="BN-A01" style="width: 100%; height: 100%; object-fit: cover;" />
                    <span class="badge bg-danger shadow-sm position-absolute top-0 start-0 m-2 px-2 py-1" style="border-radius:6px; font-weight:700;">
                        🏷️ ลด 14% FLASH DEAL
                    </span>
                    <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-2 px-2 py-1" style="border-radius:6px; font-size:0.75rem;">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">location_on</span> บางนา กม.19
                    </span>
                </div>
                <div class="card-body p-3 d-flex flex-column">
                    <h3 class="h6 fw-bold mb-1" style="color: #0f172a;">BN-A01 (บางนา มาตรฐานสากล)</h3>
                    <p class="text-secondary small mb-3">พื้นอีพ็อกซี่รับน้ำหนัก 3 ตัน/ตร.ม. ติดทางด่วนบูรพาวิถี เข้าออกสะดวก</p>
                    <div class="mt-auto border-top pt-2 mb-3">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <div>
                                <span class="text-muted small d-block">ขนาด 150 ตร.ม.</span>
                                <small class="text-muted text-decoration-line-through">฿29,000</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-danger-subtle text-danger mb-1">ประหยัด ฿4,000/ด.</span>
                                <div class="fw-bold fs-5 text-primary">฿25,000 <span class="small text-muted" style="font-size:0.75rem;">/เดือน</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Customer" asp-action="BookRoom" asp-route-id="BN-A01" class="btn btn-primary flex-fill btn-sm fw-semibold" style="border-radius:8px;">
                            จองพร้อมโปรนี้
                        </a>
                        <a asp-controller="Customer" asp-action="RoomDetail" asp-route-id="BN-A01" class="btn btn-outline-secondary btn-sm" style="border-radius:8px;">
                            ดูรายละเอียด
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hot Deal 2 -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 overflow-hidden" style="border-radius:14px;">
                <div class="position-relative" style="height: 180px;">
                    <img src="https://images.unsplash.com/photo-1566576912321-d58ddd7a6088?w=600&q=80"
                         alt="LC-C05" style="width: 100%; height: 100%; object-fit: cover;" />
                    <span class="badge bg-info text-dark shadow-sm position-absolute top-0 start-0 m-2 px-2 py-1" style="border-radius:6px; font-weight:700;">
                        ❄️ ห้องเย็นราคาพิเศษ
                    </span>
                    <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-2 px-2 py-1" style="border-radius:6px; font-size:0.75rem;">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">location_on</span> แหลมฉบัง (ชลบุรี)
                    </span>
                </div>
                <div class="card-body p-3 d-flex flex-column">
                    <h3 class="h6 fw-bold mb-1" style="color: #0f172a;">LC-C05 (ห้องเย็นควบคุมอุณหภูมิ)</h3>
                    <p class="text-secondary small mb-3">ควบคุมอุณหภูมิ -18°C ถึง +5°C ได้ตลอด 24 ชม. ใกล้ท่าเรือหลัก</p>
                    <div class="mt-auto border-top pt-2 mb-3">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <div>
                                <span class="text-muted small d-block">ขนาด 200 ตร.ม.</span>
                                <small class="text-muted text-decoration-line-through">฿48,000</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info-subtle text-info mb-1">ประหยัด ฿8,000/ด.</span>
                                <div class="fw-bold fs-5 text-primary">฿40,000 <span class="small text-muted" style="font-size:0.75rem;">/เดือน</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Customer" asp-action="BookRoom" asp-route-id="LC-C05" class="btn btn-primary flex-fill btn-sm fw-semibold" style="border-radius:8px;">
                            จองพร้อมโปรนี้
                        </a>
                        <a asp-controller="Customer" asp-action="RoomDetail" asp-route-id="LC-C05" class="btn btn-outline-secondary btn-sm" style="border-radius:8px;">
                            ดูรายละเอียด
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hot Deal 3 -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 overflow-hidden" style="border-radius:14px;">
                <div class="position-relative" style="height: 180px;">
                    <img src="https://images.unsplash.com/photo-1553413077-190dd305871c?w=600&q=80"
                         alt="WN-B12" style="width: 100%; height: 100%; object-fit: cover;" />
                    <span class="badge bg-warning text-dark shadow-sm position-absolute top-0 start-0 m-2 px-2 py-1" style="border-radius:6px; font-weight:700;">
                        🚚 BIG WAREHOUSE DEAL
                    </span>
                    <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-2 px-2 py-1" style="border-radius:6px; font-size:0.75rem;">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">location_on</span> วังน้อย (อยุธยา)
                    </span>
                </div>
                <div class="card-body p-3 d-flex flex-column">
                    <h3 class="h6 fw-bold mb-1" style="color: #0f172a;">WN-B12 (คลังสินค้าขนาดใหญ่ 500 ตร.ม.)</h3>
                    <p class="text-secondary small mb-3">รองรับรถเทรลเลอร์ 18 ล้อ พร้อมระบบกระจายสินค้าขึ้นเหนือ-อีสาน</p>
                    <div class="mt-auto border-top pt-2 mb-3">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <div>
                                <span class="text-muted small d-block">ขนาด 500 ตร.ม.</span>
                                <small class="text-muted text-decoration-line-through">฿85,000</small>
                            </div>
                            <div class="text-end">
