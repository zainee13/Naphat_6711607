@{
    var roomId = ViewBag.RoomId as string ?? "M-01";
    // รหัสห้องแบบเก่าที่อาจยังมีลิงก์ค้างอยู่
    if (roomId == "BN-A01") roomId = "M-01";
    if (roomId == "WN-B12") roomId = "L-01";
    if (roomId == "LC-C05") roomId = "CR-05";
    if (roomId == "LK-D03") roomId = "L-02";
    if (roomId == "BN-A07") roomId = "S-02";
    if (roomId == "WN-E01") roomId = "XL-01";

    // (ตอนต่อฐานข้อมูล ให้แทนที่ dictionary นี้ด้วยข้อมูลจากตาราง Rooms)
    var roomDict = new Dictionary<string, (bool Free, string Size, string Height, string Zone, string Vehicle, string Temp, string Img, string Price, int PriceNum, string Desc, string FloorLoad, string DockType, string Power)>
    {
        ["S-01"]  = (true,  "60 ตร.ม.",    "6 ม.",  "โซน A1 (ชั้น 1)",         "กระบะ / 4 ล้อ",                  "อุณหภูมิปกติ",   "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=900&q=80", "12,000",  12000,  "ห้องไซส์เล็กชั้น 1 ประตูม้วนกว้าง 3.5 ม. เหมาะกับเอกสารและสต็อกสินค้าพร้อมส่ง", "1.5 ตัน/ตร.ม.", "ทางลาดเทียบรถกระบะ", "220V 1 เฟส"),
        ["S-02"]  = (true,  "80 ตร.ม.",    "6 ม.",  "โซน A2 (SME)",            "4 ล้อ / 6 ล้อ",                  "อุณหภูมิปกติ",   "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=900&q=80", "15,000",  15000,  "ห้องกะทัดรัด ประตูม้วนไฟฟ้า เหมาะกับธุรกิจ SME และร้านค้าออนไลน์", "2 ตัน/ตร.ม.", "ทางลาดโหลดสินค้าในร่ม", "220V / 380V"),
        ["M-01"]  = (true,  "150 ตร.ม.",   "8 ม.",  "โซน B1 (มาตรฐาน)",        "6 ล้อ / 10 ล้อ",                 "อุณหภูมิปกติ",   "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=900&q=80", "25,000",  25000,  "พื้นอีพ็อกซี่รับน้ำหนัก 3 ตัน/ตร.ม. โฟล์คลิฟต์เข้าได้ วางพาเลทได้ 60–120 ตัว", "3 ตัน/ตร.ม.", "ชานชาลาพร้อมทางลาด", "3 เฟส 380V (50A)"),
        ["M-02"]  = (true,  "250 ตร.ม.",   "8 ม.",  "โซน B2 (พาเลท)",          "10 ล้อ",                         "อุณหภูมิปกติ",   "https://images.unsplash.com/photo-1553413077-190dd305871c?w=900&q=80", "38,000",  38000,  "ติดตั้ง Racking ได้ 3 ชั้น วางพาเลทได้ 120 ตัว มีระบบระบายอากาศ 24 ชม.", "3.5 ตัน/ตร.ม.", "ชานชาลาสูง 1.2 ม.", "3 เฟส 380V (100A)"),
        ["L-01"]  = (true,  "500 ตร.ม.",   "10 ม.", "โซน C1 (มี Dock)",        "รถพ่วง 18 ล้อ / ตู้ 40ft",       "อุณหภูมิปกติ",   "https://images.unsplash.com/photo-1553413077-190dd305871c?w=900&q=80", "75,000",  75000,  "รถพ่วง 18 ล้อเข้าได้ มี Dock Leveler ปรับระดับอัตโนมัติ 2 ช่องสำหรับเทียบตู้คอนเทนเนอร์", "5 ตัน/ตร.ม.", "Dock Leveler 2 ช่อง", "3 เฟส 380V (200A)"),
        ["L-02"]  = (false, "350 ตร.ม.",   "10 ม.", "โซน C2 (สินค้าปลอดภัย)",  "10 ล้อ / เทรลเลอร์",             "อุณหภูมิปกติ",   "https://images.unsplash.com/photo-1494412685616-a5d310fbb07d?w=900&q=80", "55,000",  55000,  "สำหรับสินค้ามูลค่าสูง ประตูนิรภัย 2 ชั้น กล้องบันทึกภาพย้อนหลัง 90 วัน", "4 ตัน/ตร.ม.", "Dock Leveler 1 ช่อง", "3 เฟส 380V (150A)"),
        ["XL-01"] = (true,  "1,200 ตร.ม.", "12 ม.", "โซน D1 (เมกะ)",           "คอนเทนเนอร์ทุกขนาด",             "อุณหภูมิปกติ",   "https://images.unsplash.com/photo-1494412685616-a5d310fbb07d?w=900&q=80", "180,000", 180000, "คลังขนาดใหญ่พิเศษ มีออฟฟิศ 2 ชั้นและห้องน้ำในตัว หลังคา Solar Roof", "5 ตัน/ตร.ม.", "Dock Leveler 4 ช่อง", "หม้อแปลงแยก 250 kVA"),
        ["CR-05"] = (true,  "200 ตร.ม.",   "7 ม.",  "โซนห้องเย็น",              "10 ล้อตู้เย็น",                   "−18°C ถึง +5°C", "https://images.unsplash.com/photo-1553413077-190dd305871c?w=900&q=80", "40,000",  40000,  "ห้องเย็นฉนวน PIR หนา 100 มม. ไฟสำรองคู่ แจ้งเตือนเมื่ออุณหภูมิผิดปกติทาง SMS", "3 ตัน/ตร.ม.", "Air Lock Loading Bay", "3 เฟส + ไฟสำรอง"),
    };

    if (!roomDict.ContainsKey(roomId)) roomId = "M-01";
    var info = roomDict[roomId];
    ViewData["Title"] = $"ห้อง {roomId}";
    Layout = "_Layout";

    var specs = new[] {
        ("พื้นที่", info.Size),
        ("เพดานสูง", info.Height),
        ("รับน้ำหนักพื้น", info.FloorLoad),
        ("รถที่เข้าได้", info.Vehicle),
        ("ชานชาลาโหลด", info.DockType),
        ("ไฟฟ้า", info.Power),
        ("อุณหภูมิ", info.Temp),
    };

    var reviews = new[] {
        ("บริษัท สยาม โลจิสติกส์ โซลูชั่นส์", 5, "ม.ค. 2569", "ห้องสะอาด พื้นเรียบ โฟล์คลิฟต์วิ่งคล่อง เทียบตู้คอนเทนเนอร์สะดวก"),
        ("บจก. นำเจริญ ซัพพลาย", 5, "ธ.ค. 2568", "เก็บพาเลทสินค้านำเข้าได้พอดี เจ้าหน้าที่ช่วยเรื่องเอกสารเร็ว"),
        ("SuperShop Thailand", 5, "พ.ย. 2568", "ทำสัญญาออนไลน์ง่าย ประตูม้วนไฟฟ้าใช้สะดวก รถเข้าส่งของได้ง่าย"),
    };
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/room.css" asp-append-version="true" />
}

<div class="rd cu">

    <a class="cu-back" asp-controller="Customer" asp-action="Search">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>กลับไปผังคลัง
    </a>
    <header class="cu-head rd-head">
        <div class="rd-title">
            <h1>ห้อง @roomId</h1>
            <span class="cu-status @(info.Free ? "" : "is-taken")">@(info.Free ? "ว่าง พร้อมส่งมอบ" : "มีผู้เช่าแล้ว")</span>
        </div>
        <p>@info.Zone, @info.Desc</p>
    </header>

    <div class="rd-layout">

        <!-- ซ้าย: รูป สเปก รีวิว -->
        <div class="rd-main">
            <img class="rd-photo @(info.Free ? "" : "is-taken")" src="@info.Img" alt="ภายในห้อง @roomId" />

            <section class="rd-section" aria-labelledby="rd-spec">
                <h2 id="rd-spec" class="cu-h2">สเปกห้อง</h2>
                <dl class="rd-spec">
                    @foreach (var s in specs)
                    {
                        <div><dt>@s.Item1</dt><dd>@s.Item2</dd></div>
                    }
                </dl>
                <p class="rd-included">
                    รวมในค่าเช่า: กล้อง CCTV แยกห้อง 24 ชม., สปริงเกอร์ดับเพลิง, โฟล์คลิฟต์พร้อมคนขับ (นัดล่วงหน้า), WiFi และใบกำกับภาษีเต็มรูป
                </p>
            </section>

            <section class="rd-section" aria-labelledby="rd-reviews">
                <div class="rd-reviews-head">
                    <h2 id="rd-reviews" class="cu-h2">รีวิว</h2>
                    <p class="rd-score"><strong>★ 4.8</strong> จาก <span id="rdReviewCount">14</span> รีวิว</p>
                </div>

                <ul class="rd-review-list" id="rdReviewList">
                    @foreach (var r in reviews)
                    {
                        <li>
                            <div class="rd-review-top">
                                <strong>@r.Item1</strong>
                                <span class="rd-stars" aria-label="@r.Item2 ดาว">@(new string('★', r.Item2))</span>
                            </div>
                            <p>@r.Item4</p>
                            <span class="rd-date">@r.Item3</span>
                        </li>
                    }
                </ul>

                <details class="rd-write">
                    <summary class="cu-btn">เขียนรีวิว</summary>
                    <form id="rdReviewForm">
                        <fieldset class="rd-star-input">
                            <legend>คะแนน</legend>
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" name="stars" id="star@(i)" value="@i" @(i == 5 ? "checked" : "") />
                                <label for="star@(i)" title="@i ดาว">★</label>
                            }
                        </fieldset>
                        <label class="cu-field">
                            <span>ความคิดเห็น</span>
                            <textarea id="rdReviewText" rows="3" required placeholder="เช่น ความสะดวกในการขนของ สภาพพื้น ความปลอดภัย"></textarea>
                        </label>
                        <button type="submit" class="cu-btn cu-btn--primary">ส่งรีวิว</button>
                    </form>
                </details>
            </section>
        </div>

        <!-- ขวา: ค่าเช่าและการจอง -->
        <aside class="rd-book" aria-labelledby="rd-price">
            <p class="rd-price" id="rd-price"><strong>฿@info.Price</strong> ต่อเดือน</p>

            @if (info.Free)
            {
                <label class="cu-field">
                    <span>วันเริ่มเช่า</span>
                    <input type="date" id="rdStart" />
                </label>
                <label class="cu-field">
                    <span>ระยะสัญญา</span>
                    <select id="rdDuration">
                        <option value="1">1 เดือน</option>
                        <option value="3">3 เดือน</option>
                        <option value="6" selected>6 เดือน</option>
                        <option value="12">12 เดือน</option>
                    </select>
                </label>

                <dl class="rd-calc">
                    <div><dt id="rdRentLabel">ค่าเช่า 6 เดือน</dt><dd id="rdRent"></dd></div>
                    <div><dt>เงินประกัน 2 เดือน</dt><dd id="rdDeposit"></dd></div>
                    <div><dt>VAT 7%</dt><dd id="rdVat"></dd></div>
                    <div class="rd-total"><dt>ยอดชำระงวดแรก</dt><dd id="rdTotal"></dd></div>
                </dl>

                <a class="cu-btn cu-btn--primary rd-cta" asp-controller="Customer" asp-action="BookRoom" asp-route-id="@roomId">จองห้องนี้</a>
            }
            else
            {
                <p class="rd-taken-note">ห้องนี้มีผู้เช่าแล้ว ยังจองไม่ได้ในตอนนี้</p>
                <a class="cu-btn rd-cta" asp-controller="Customer" asp-action="Search">เลือกห้องอื่นบนผัง</a>
            }
        </aside>
    </div>
</div>

@section Scripts {
<script>
(function () {
    // คำนวณค่าเช่า
    const rate = @info.PriceNum;
    const dur = document.getElementById('rdDuration');
    if (dur) {
        const baht = n => '฿' + Math.round(n).toLocaleString('th-TH');
        const calc = () => {
            const m = parseInt(dur.value) || 1;
            const rent = rate * m, deposit = rate * 2, vat = rent * 0.07;
            document.getElementById('rdRentLabel').textContent = 'ค่าเช่า ' + m + ' เดือน';
            document.getElementById('rdRent').textContent = baht(rent);
            document.getElementById('rdDeposit').textContent = baht(deposit);
            document.getElementById('rdVat').textContent = baht(vat);
            document.getElementById('rdTotal').textContent = baht(rent + deposit + vat);
        };
        dur.addEventListener('change', calc);
        const start = document.getElementById('rdStart');
        start.valueAsDate = new Date();
        start.min = start.value;
        calc();
    }

    // รีวิว (ยังไม่บันทึกลงฐานข้อมูล แสดงในหน้านี้เท่านั้น)
    const form = document.getElementById('rdReviewForm');
    form.addEventListener('submit', e => {
        e.preventDefault();
        const text = document.getElementById('rdReviewText').value.trim();
        if (!text) return;
        const stars = +form.querySelector('input[name=stars]:checked').value;

        const li = document.createElement('li');
        li.className = 'is-new';
        const top = document.createElement('div');
        top.className = 'rd-review-top';
        const name = document.createElement('strong');
        name.textContent = @Json.Serialize(ViewBag.FullName as string ?? "คุณ");
        const st = document.createElement('span');
        st.className = 'rd-stars';
        st.textContent = '★'.repeat(stars);
        top.append(name, st);
        const p = document.createElement('p');
        p.textContent = text; // textContent: ไม่แปลงข้อความเป็น HTML
        const date = document.createElement('span');
        date.className = 'rd-date';
        date.textContent = 'เมื่อสักครู่';
        li.append(top, p, date);

        document.getElementById('rdReviewList').prepend(li);
        const count = document.getElementById('rdReviewCount');
        count.textContent = (+count.textContent) + 1;
        form.reset();
        form.closest('details').open = false;
    });
})();
</script>
}
