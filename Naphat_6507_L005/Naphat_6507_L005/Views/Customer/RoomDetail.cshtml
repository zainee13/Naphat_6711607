@{
    var roomId = ViewBag.RoomId as string ?? "M-01";

    // รหัสห้องแบบเก่า (บางหน้ายังลิงก์ด้วยรหัสนี้) แปลงเป็นรหัสใหม่
    var oldRoomIds = new Dictionary<string, string>
    {
        { "BN-A01", "M-01" },
        { "WN-B12", "L-01" },
        { "LC-C05", "CR-05" },
        { "LK-D03", "L-02" },
        { "BN-A07", "S-02" },
        { "WN-E01", "XL-01" },
    };
    if (oldRoomIds.ContainsKey(roomId))
    {
        roomId = oldRoomIds[roomId];
    }

    // ข้อมูลห้องทั้งหมด (ตอนต่อฐานข้อมูล ให้ดึงจากตาราง Rooms แทน)
    var rooms = new[]
    {
        new {
            Id = "S-01", Free = true, Price = 12000,
            Size = "60 ตร.ม.", Height = "6 ม.", Zone = "โซน A1 (ชั้น 1)",
            Vehicle = "กระบะ / 4 ล้อ", Temp = "อุณหภูมิปกติ",
            FloorLoad = "1.5 ตัน/ตร.ม.", Dock = "ทางลาดเทียบรถกระบะ", Power = "220V 1 เฟส",
            Desc = "ห้องไซส์เล็กชั้น 1 ประตูม้วนกว้าง 3.5 ม. เหมาะกับเอกสารและสต็อกสินค้าพร้อมส่ง",
            Img = "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=900&q=80"
        },
        new {
            Id = "S-02", Free = true, Price = 15000,
            Size = "80 ตร.ม.", Height = "6 ม.", Zone = "โซน A2 (SME)",
            Vehicle = "4 ล้อ / 6 ล้อ", Temp = "อุณหภูมิปกติ",
            FloorLoad = "2 ตัน/ตร.ม.", Dock = "ทางลาดโหลดสินค้าในร่ม", Power = "220V / 380V",
            Desc = "ห้องกะทัดรัด ประตูม้วนไฟฟ้า เหมาะกับธุรกิจ SME และร้านค้าออนไลน์",
            Img = "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=900&q=80"
        },
        new {
            Id = "M-01", Free = true, Price = 25000,
            Size = "150 ตร.ม.", Height = "8 ม.", Zone = "โซน B1 (มาตรฐาน)",
            Vehicle = "6 ล้อ / 10 ล้อ", Temp = "อุณหภูมิปกติ",
            FloorLoad = "3 ตัน/ตร.ม.", Dock = "ชานชาลาพร้อมทางลาด", Power = "3 เฟส 380V (50A)",
            Desc = "พื้นอีพ็อกซี่รับน้ำหนัก 3 ตัน/ตร.ม. โฟล์คลิฟต์เข้าได้ วางพาเลทได้ 60–120 ตัว",
            Img = "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=900&q=80"
        },
        new {
            Id = "M-02", Free = true, Price = 38000,
            Size = "250 ตร.ม.", Height = "8 ม.", Zone = "โซน B2 (พาเลท)",
            Vehicle = "10 ล้อ", Temp = "อุณหภูมิปกติ",
            FloorLoad = "3.5 ตัน/ตร.ม.", Dock = "ชานชาลาสูง 1.2 ม.", Power = "3 เฟส 380V (100A)",
            Desc = "ติดตั้ง Racking ได้ 3 ชั้น วางพาเลทได้ 120 ตัว มีระบบระบายอากาศ 24 ชม.",
            Img = "https://images.unsplash.com/photo-1553413077-190dd305871c?w=900&q=80"
        },
        new {
            Id = "L-01", Free = true, Price = 75000,
            Size = "500 ตร.ม.", Height = "10 ม.", Zone = "โซน C1 (มี Dock)",
            Vehicle = "รถพ่วง 18 ล้อ / ตู้ 40ft", Temp = "อุณหภูมิปกติ",
            FloorLoad = "5 ตัน/ตร.ม.", Dock = "Dock Leveler 2 ช่อง", Power = "3 เฟส 380V (200A)",
            Desc = "รถพ่วง 18 ล้อเข้าได้ มี Dock Leveler ปรับระดับอัตโนมัติ 2 ช่องสำหรับเทียบตู้คอนเทนเนอร์",
            Img = "https://images.unsplash.com/photo-1553413077-190dd305871c?w=900&q=80"
        },
        new {
            Id = "L-02", Free = false, Price = 55000,
            Size = "350 ตร.ม.", Height = "10 ม.", Zone = "โซน C2 (สินค้าปลอดภัย)",
            Vehicle = "10 ล้อ / เทรลเลอร์", Temp = "อุณหภูมิปกติ",
            FloorLoad = "4 ตัน/ตร.ม.", Dock = "Dock Leveler 1 ช่อง", Power = "3 เฟส 380V (150A)",
            Desc = "สำหรับสินค้ามูลค่าสูง ประตูนิรภัย 2 ชั้น กล้องบันทึกภาพย้อนหลัง 90 วัน",
            Img = "https://images.unsplash.com/photo-1494412685616-a5d310fbb07d?w=900&q=80"
        },
        new {
            Id = "XL-01", Free = true, Price = 180000,
            Size = "1,200 ตร.ม.", Height = "12 ม.", Zone = "โซน D1 (เมกะ)",
            Vehicle = "คอนเทนเนอร์ทุกขนาด", Temp = "อุณหภูมิปกติ",
            FloorLoad = "5 ตัน/ตร.ม.", Dock = "Dock Leveler 4 ช่อง", Power = "หม้อแปลงแยก 250 kVA",
            Desc = "คลังโล่งขนาดใหญ่พิเศษ เพดานสูง 12 ม. หลังคา Solar Roof",
            Img = "https://images.unsplash.com/photo-1494412685616-a5d310fbb07d?w=900&q=80"
        },
        new {
            Id = "CR-05", Free = true, Price = 40000,
            Size = "200 ตร.ม.", Height = "7 ม.", Zone = "โซนห้องเย็น",
            Vehicle = "10 ล้อตู้เย็น", Temp = "−18°C ถึง +5°C",
            FloorLoad = "3 ตัน/ตร.ม.", Dock = "Air Lock Loading Bay", Power = "3 เฟส + ไฟสำรอง",
            Desc = "ห้องเย็นฉนวน PIR หนา 100 มม. ไฟสำรองคู่ แจ้งเตือนเมื่ออุณหภูมิผิดปกติทาง SMS",
            Img = "https://images.unsplash.com/photo-1553413077-190dd305871c?w=900&q=80"
        },
    };

    // หาห้องตามรหัส ถ้าไม่เจอให้แสดง M-01
    var room = rooms.FirstOrDefault(r => r.Id == roomId) ?? rooms.First(r => r.Id == "M-01");

    ViewData["Title"] = "ห้อง " + room.Id;
    Layout = "_Layout";

    // สเปกห้อง (ชื่อ, ค่า)
    var specs = new[]
    {
        ("พื้นที่", room.Size),
        ("เพดานสูง", room.Height),
        ("รับน้ำหนักพื้น", room.FloorLoad),
        ("รถที่เข้าได้", room.Vehicle),
        ("ชานชาลาโหลด", room.Dock),
        ("ไฟฟ้า", room.Power),
        ("อุณหภูมิ", room.Temp),
    };

    // รีวิว (ชื่อผู้รีวิว, ดาว, วันที่, ข้อความ)
    var reviews = new[]
    {
        ("บริษัท สยาม โลจิสติกส์ โซลูชั่นส์", 5, "ม.ค. 2569", "ห้องสะอาด พื้นเรียบ โฟล์คลิฟต์วิ่งคล่อง เทียบตู้คอนเทนเนอร์สะดวก"),
        ("บจก. นำเจริญ ซัพพลาย", 5, "ธ.ค. 2568", "เก็บพาเลทสินค้านำเข้าได้พอดี เจ้าหน้าที่ช่วยเรื่องเอกสารเร็ว"),
        ("SuperShop Thailand", 5, "พ.ย. 2568", "ทำสัญญาออนไลน์ง่าย ประตูม้วนไฟฟ้าใช้สะดวก รถเข้าส่งของได้ง่าย"),
    };

    var userName = ViewBag.FullName as string ?? "คุณ";
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/room.css" asp-append-version="true" />
}

<div class="rd cu">

    <a class="cu-back" asp-controller="Customer" asp-action="Search">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>กลับไปผังคลัง
    </a>

    <!-- หัวข้อ -->
    <header class="cu-head rd-head">
        <div class="rd-title">
            <h1>ห้อง @room.Id</h1>
            @if (room.Free)
            {
                <span class="cu-status">ว่าง พร้อมส่งมอบ</span>
            }
            else
            {
                <span class="cu-status is-taken">มีผู้เช่าแล้ว</span>
            }
        </div>
        <p>@room.Zone, @room.Desc</p>
    </header>

    <div class="rd-layout">

        <!-- ซ้าย: รูป สเปก รีวิว -->
        <div class="rd-main">
            <img class="rd-photo @(room.Free ? "" : "is-taken")" src="@room.Img" alt="ภายในห้อง @room.Id" />

            <!-- สเปกห้อง -->
            <section class="rd-section" aria-labelledby="specTitle">
                <h2 id="specTitle" class="cu-h2">สเปกห้อง</h2>
                <dl class="rd-spec">
                    @foreach (var spec in specs)
                    {
                        <div>
                            <dt>@spec.Item1</dt>
                            <dd>@spec.Item2</dd>
                        </div>
                    }
                </dl>
                <p class="rd-included">
                    รวมในค่าเช่า: กล้อง CCTV แยกห้อง 24 ชม., สปริงเกอร์ดับเพลิง, โฟล์คลิฟต์พร้อมคนขับ (นัดล่วงหน้า), WiFi และใบกำกับภาษีเต็มรูป
                </p>
            </section>

            <!-- รีวิว -->
            <section class="rd-section" aria-labelledby="reviewTitle">
                <div class="rd-reviews-head">
                    <h2 id="reviewTitle" class="cu-h2">รีวิว</h2>
                    <p class="rd-score"><strong>★ 4.8</strong> จาก <span id="reviewCount">14</span> รีวิว</p>
                </div>

                <ul class="rd-review-list" id="reviewList">
                    @foreach (var review in reviews)
                    {
                        <li>
                            <div class="rd-review-top">
                                <strong>@review.Item1</strong>
                                <span class="rd-stars" aria-label="@review.Item2 ดาว">@(new string('★', review.Item2))</span>
                            </div>
                            <p>@review.Item4</p>
                            <span class="rd-date">@review.Item3</span>
                        </li>
                    }
                </ul>

                <!-- ฟอร์มเขียนรีวิว (กดปุ่มแล้วเปิดออก) -->
                <details class="rd-write">
                    <summary class="cu-btn">เขียนรีวิว</summary>
                    <form id="reviewForm">
                        <fieldset class="rd-star-input">
                            <legend>คะแนน</legend>
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" name="stars" id="star@(i)" value="@i" @(i == 5 ? "checked" : "") />
                                <label for="star@(i)" title="@i ดาว">★</label>
                            }
                        </fieldset>
                        <label class="cu-field">
                            <span>ความคิดเห็น</span>
                            <textarea id="reviewText" rows="3" required placeholder="เช่น ความสะดวกในการขนของ สภาพพื้น ความปลอดภัย"></textarea>
                        </label>
                        <button type="submit" class="cu-btn cu-btn--primary">ส่งรีวิว</button>
                    </form>
                </details>
            </section>
        </div>

        <!-- ขวา: ค่าเช่าและการจอง -->
        <aside class="rd-book" aria-labelledby="priceTitle">
            <p class="rd-price" id="priceTitle"><strong>฿@room.Price.ToString("N0")</strong> ต่อเดือน</p>

            @if (room.Free)
            {
                <label class="cu-field">
                    <span>วันเริ่มเช่า</span>
                    <input type="date" id="startDate" />
                </label>
                <label class="cu-field">
                    <span>ระยะสัญญา</span>
                    <select id="duration">
                        <option value="1">1 เดือน</option>
                        <option value="3">3 เดือน</option>
                        <option value="6" selected>6 เดือน</option>
                        <option value="12">12 เดือน</option>
                    </select>
                </label>

                <!-- สรุปยอด (JS คำนวณตามระยะสัญญา) -->
                <dl class="rd-calc">
                    <div>
                        <dt>ค่าเช่าเดือนแรก</dt>
                        <dd id="rentText"></dd>
                    </div>
                    <div>
                        <dt>
                            <span id="depositLabel">เงินประกัน 2 เดือน</span>
                            <span class="cu-sub">คืนเมื่อสิ้นสุดสัญญา</span>
                        </dt>
                        <dd id="depositText"></dd>
                    </div>
                    <div class="rd-total">
                        <dt>ชำระก่อนเข้าใช้</dt>
                        <dd id="totalText"></dd>
                    </div>
                </dl>
                <p class="cu-next" id="nextMonthsText"></p>

                <a class="cu-btn cu-btn--primary rd-cta" asp-controller="Customer" asp-action="BookRoom" asp-route-id="@room.Id">จองห้องนี้</a>
            }
            else
            {
                <p class="rd-taken-note">ห้องนี้มีผู้เช่าแล้ว ยังจองไม่ได้ในตอนนี้</p>
                <a class="cu-btn rd-cta" asp-controller="Customer" asp-action="Search">เลือกห้องอื่นบนผัง</a>
            }
        </aside>
    </div>
</div>

@section Scripts {
<script>
    const monthlyRate = @room.Price;   // ค่าเช่าต่อเดือน
    const userName = @Json.Serialize(userName);

    // แปลงตัวเลขเป็นข้อความเงินบาท เช่น 25000 -> ฿25,000
    function toBaht(amount) {
        return '฿' + Math.round(amount).toLocaleString('th-TH');
    }

    // จำนวนเดือนของเงินประกัน: สัญญา 1–3 เดือน = 1 เดือน, 6 เดือน = 2 เดือน, 12 เดือน = 3 เดือน
    function getDepositMonths(months) {
        if (months >= 12) return 3;
        if (months >= 6) return 2;
        return 1;
    }

    // คำนวณยอดที่ต้องจ่าย: ก่อนเข้าใช้จ่ายค่าเช่าเดือนแรก + เงินประกัน (ไม่มี VAT)
    function calculatePrice() {
        const months = parseInt(document.getElementById('duration').value) || 1;
        const depositMonths = getDepositMonths(months);
        const deposit = monthlyRate * depositMonths;

        document.getElementById('rentText').textContent = toBaht(monthlyRate);
        document.getElementById('depositLabel').textContent = 'เงินประกัน ' + depositMonths + ' เดือน';
        document.getElementById('depositText').textContent = toBaht(deposit);
        document.getElementById('totalText').textContent = toBaht(monthlyRate + deposit);

        // บอกยอดเดือนถัดไป (สัญญา 1 เดือนไม่ต้องแสดง)
        const nextText = document.getElementById('nextMonthsText');
        if (months > 1) {
            nextText.textContent = 'เดือนที่ 2–' + months + ' ชำระเดือนละ ' + toBaht(monthlyRate);
            nextText.hidden = false;
        } else {
            nextText.hidden = true;
        }
    }

    // กล่องคำนวณมีเฉพาะห้องที่ว่าง
    const durationSelect = document.getElementById('duration');
    if (durationSelect) {
        const startDate = document.getElementById('startDate');
        startDate.valueAsDate = new Date();
        startDate.min = startDate.value;   // เลือกวันย้อนหลังไม่ได้

        durationSelect.addEventListener('change', calculatePrice);
        calculatePrice();
    }

    // ส่งรีวิว (ยังไม่บันทึกลงฐานข้อมูล แค่เพิ่มในหน้านี้)
    const reviewForm = document.getElementById('reviewForm');
    reviewForm.addEventListener('submit', function (event) {
        event.preventDefault();

        const text = document.getElementById('reviewText').value.trim();
        if (text === '') return;
        const stars = parseInt(reviewForm.querySelector('input[name=stars]:checked').value);

        // สร้างรายการรีวิวใหม่ (ใช้ textContent เพื่อไม่ให้ข้อความถูกแปลงเป็น HTML)
        const item = document.createElement('li');
        item.className = 'is-new';

        const top = document.createElement('div');
        top.className = 'rd-review-top';

        const name = document.createElement('strong');
        name.textContent = userName;

        const starText = document.createElement('span');
        starText.className = 'rd-stars';
        starText.textContent = '★'.repeat(stars);

        const comment = document.createElement('p');
        comment.textContent = text;

        const date = document.createElement('span');
        date.className = 'rd-date';
        date.textContent = 'เมื่อสักครู่';

        top.append(name, starText);
        item.append(top, comment, date);
        document.getElementById('reviewList').prepend(item);

        // เพิ่มจำนวนรีวิว
        const count = document.getElementById('reviewCount');
        count.textContent = parseInt(count.textContent) + 1;

        reviewForm.reset();
        reviewForm.closest('details').open = false;
    });
</script>
}
