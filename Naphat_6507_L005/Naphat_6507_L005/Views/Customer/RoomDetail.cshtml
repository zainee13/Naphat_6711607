@model Naphat_6507_L005.ViewModels.RoomViewModel
@{
    var room = Model;
    var reviews = ViewBag.Reviews as List<Naphat_6507_L005.ViewModels.ReviewViewModel> ?? new();
    var quote = (Naphat_6507_L005.ViewModels.PriceQuoteViewModel)ViewBag.Quote;
    var periods = ViewBag.BookedPeriods as List<Naphat_6507_L005.ViewModels.BookedPeriodViewModel> ?? new();   // ช่วงที่ถูกจองแล้ว
    var nextFree = (DateOnly)ViewBag.NextFreeDate;   // วันแรกที่ห้องว่าง   // ยอดเริ่มต้น (เริ่มวันนี้ 6 เดือน)

    ViewData["Title"] = "ห้อง " + room.Id;
    Layout = "_PublicLayout";

    // สเปกห้อง (ชื่อ, ค่า)
    var specs = new[]
    {
        ("พื้นที่", room.Area + " ตร.ม."),
        ("เพดานสูง", room.Height),
        ("รับน้ำหนักพื้น", room.FloorLoad),
        ("รถที่เข้าได้", room.Vehicle),
        ("ชานชาลาโหลด", room.Dock),
        ("ไฟฟ้า", room.Power),
        ("อุณหภูมิ", room.Temp),
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/room.css" asp-append-version="true" />
}

<div class="rd cu">

    <a class="cu-back" asp-controller="Customer" asp-action="Search">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>กลับไปผังคลัง
    </a>

    <!-- หัวข้อ -->
    <header class="cu-head rd-head">
        <div class="rd-title">
            <h1>ห้อง @room.Id</h1>
            @if (room.Free)
            {
                <span class="cu-status">ว่าง พร้อมส่งมอบ</span>
            }
            else
            {
                <span class="cu-status is-taken">มีผู้เช่า / ถูกจองแล้ว · จองได้ตั้งแต่ @ViewBag.NextFreeText</span>
            }
        </div>
        <p>@room.Zone, @room.Desc</p>
    </header>

    <div class="rd-layout">

        <!-- ซ้าย: รูป สเปก รีวิว -->
        <div class="rd-main">
            <img class="rd-photo @(room.Free ? "" : "is-taken")" src="@(room.Img)?w=900&q=80" alt="ภายในห้อง @room.Id" />

            <!-- สเปกห้อง -->
            <section class="rd-section" aria-labelledby="specTitle">
                <h2 id="specTitle" class="cu-h2">สเปกห้อง</h2>
                <dl class="rd-spec">
                    @foreach (var spec in specs)
                    {
                        <div>
                            <dt>@spec.Item1</dt>
                            <dd>@spec.Item2</dd>
                        </div>
                    }
                </dl>
                <p class="rd-included">
                    รวมในค่าเช่า: กล้อง CCTV แยกห้อง 24 ชม., สปริงเกอร์ดับเพลิง, โฟล์คลิฟต์พร้อมคนขับ (นัดล่วงหน้า), WiFi และใบกำกับภาษีเต็มรูป
                </p>
            </section>

            <!-- รีวิว -->
            <section class="rd-section" aria-labelledby="reviewTitle">
                <div class="rd-reviews-head">
                    <h2 id="reviewTitle" class="cu-h2">รีวิว</h2>
                    @if (reviews.Count > 0)
                    {
                        <p class="rd-score"><strong>★ @room.Rating</strong> จาก @reviews.Count รีวิว</p>
                    }
                    else
                    {
                        <p class="rd-score">ยังไม่มีรีวิว</p>
                    }
                </div>

                @if (TempData["Success"] != null)
                {
                    <p class="cu-alert" role="status">@TempData["Success"]</p>
                }
                @if (TempData["Error"] != null)
                {
                    <p class="cu-alert cu-alert--error" role="alert">@TempData["Error"]</p>
                }

                <ul class="rd-review-list">
                    @foreach (var review in reviews)
                    {
                        <li>
                            <div class="rd-review-top">
                                <strong>@review.Name</strong>
                                <span class="rd-stars" aria-label="@review.Stars ดาว">@(new string('★', review.Stars))</span>
                            </div>
                            <p>@review.Comment</p>
                            <span class="rd-date">@review.Date</span>
                        </li>
                    }
                </ul>

                <!-- ฟอร์มเขียนรีวิว: เฉพาะคนที่เคยเช่าห้องนี้ (CustomerController ส่ง ViewBag.CanReview มา) -->
                @if (ViewBag.CanReview == true)
                {
                <details class="rd-write">
                    <summary class="cu-btn">เขียนรีวิว</summary>
                    <form asp-controller="Customer" asp-action="AddReview" method="post">
                        <input type="hidden" name="RoomId" value="@room.Id" />
                        <fieldset class="rd-star-input">
                            <legend>คะแนน</legend>
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" name="Stars" id="star@(i)" value="@i" @(i == 5 ? "checked" : "") />
                                <label for="star@(i)" title="@i ดาว">★</label>
                            }
                        </fieldset>
                        <label class="cu-field">
                            <span>ความคิดเห็น</span>
                            <textarea name="Comment" rows="3" required placeholder="เช่น ความสะดวกในการขนของ สภาพพื้น ความปลอดภัย"></textarea>
                        </label>
                        <button type="submit" class="cu-btn cu-btn--primary">ส่งรีวิว</button>
                    </form>
                </details>
                }
                else
                {
                    <p class="cu-sub">รีวิวได้หลังจากเช่าห้องนี้แล้ว</p>
                }
            </section>
        </div>

        <!-- ขวา: ค่าเช่าและการจอง -->
        <aside class="rd-book" aria-labelledby="priceTitle">
            <p class="rd-price" id="priceTitle"><strong>฿@room.Price.ToString("N0")</strong> ต่อเดือน</p>

            @if (periods.Count > 0)
            {
                <!-- ช่วงที่ห้องถูกจองแล้ว (CustomerController.GetBookedPeriods) จองได้เฉพาะช่วงที่ไม่ทับ -->
                <div class="cu-booked">
                    <strong>ช่วงที่ถูกจองแล้ว</strong>
                    <ul>
                        @foreach (var p in periods)
                        {
                            <li>@p.Text</li>
                        }
                    </ul>
                    <p>ว่างให้จองตั้งแต่ <strong>@ViewBag.NextFreeText</strong></p>
                </div>
            }

            @* จองได้ทุกห้อง ถ้าช่วงเวลาไม่ทับกับการจองอื่น (ตรวจที่ CustomerController.BookRoom) *@
                <!-- ส่งวันเริ่มเช่าและระยะสัญญาไปหน้า BookRoom -->
                <form asp-controller="Customer" asp-action="BookRoom" asp-route-id="@room.Id" method="get">
                <label class="cu-field">
                    <span>วันเริ่มเช่า</span>
                    <input type="date" id="startDate" name="startDate" value="@nextFree.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </label>
                <label class="cu-field">
                    <span>ระยะสัญญา</span>
                    <select id="duration" name="months">
                        <option value="1">1 เดือน</option>
                        <option value="3">3 เดือน</option>
                        <option value="6" selected>6 เดือน</option>
                        <option value="12">12 เดือน</option>
                    </select>
                </label>

                <!-- สรุปยอด (JS คำนวณตามระยะสัญญา) -->
                <dl class="rd-calc">
                    <div>
                        <dt>ค่าเช่าเดือนแรก</dt>
                        <dd id="rentText">@quote.RentText</dd>
                    </div>
                    <div>
                        <dt>
                            <span id="depositLabel">เงินประกัน @quote.DepositMonths เดือน</span>
                            <span class="cu-sub">คืนเมื่อสิ้นสุดสัญญา</span>
                        </dt>
                        <dd id="depositText">@quote.DepositText</dd>
                    </div>
                    <div class="rd-total">
                        <dt>ชำระก่อนเข้าใช้</dt>
                        <dd id="totalText">@quote.TotalText</dd>
                    </div>
                </dl>
                <p class="cu-next" id="nextMonthsText" hidden="@(quote.NextMonthsText == null)">@quote.NextMonthsText</p>

                <button type="submit" class="cu-btn cu-btn--primary rd-cta">จองห้องนี้</button>
                </form>
        </aside>
    </div>
</div>

@section Scripts {
<script>
    // ยอดและวันสิ้นสุดสัญญาคิดที่ CustomerController.BuildQuote ที่เดียว
    // JS แค่ขอค่าใหม่จาก Customer/PriceQuote เมื่อเปลี่ยนวันหรือระยะสัญญา แล้วเอามาแสดง
    const quoteUrl = '@Url.Action("PriceQuote", "Customer", new { id = room.Id })';

    function showQuote(q) {
        document.getElementById('rentText').textContent = q.rentText;
        document.getElementById('depositLabel').textContent = 'เงินประกัน ' + q.depositMonths + ' เดือน';
        document.getElementById('depositText').textContent = q.depositText;
        document.getElementById('totalText').textContent = q.totalText;
        const nextText = document.getElementById('nextMonthsText');
        nextText.textContent = q.nextMonthsText || '';
        nextText.hidden = !q.nextMonthsText;
        const endText = document.getElementById('endDateText');
        if (endText) {
            endText.textContent = q.endDateText;
        }
    }

    function refreshQuote(startValue, monthsValue) {
        const url = quoteUrl + '?months=' + encodeURIComponent(monthsValue) + (startValue ? '&start=' + encodeURIComponent(startValue) : '');
        fetch(url, { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (q) { if (q) showQuote(q); })
            .catch(function () { /* เน็ตหลุด: คงยอดเดิมไว้ ยอดจริงคิดใหม่ตอนกดจองอยู่แล้ว */ });
    }

    // กล่องคำนวณมีเฉพาะห้องที่ว่าง
    const durationSelect = document.getElementById('duration');
    if (durationSelect) {
        const startDate = document.getElementById('startDate');
        // วันเริ่มตั้งต้น (วันแรกที่ห้องว่าง) และวันต่ำสุดตั้งมาจาก Controller แล้ว

        durationSelect.addEventListener('change', function () { refreshQuote(startDate.value, durationSelect.value); });
    }
</script>
}
