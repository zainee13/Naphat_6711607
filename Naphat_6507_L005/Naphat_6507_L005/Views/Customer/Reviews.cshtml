@{
    ViewData["Title"] = "รีวิวและประเมินบริการ";
    Layout = "_Layout";
}

<!-- Breadcrumbs & Header -->
<div class="page-header mb-4">
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-0 small" style="--bs-breadcrumb-divider: '›';">
            <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Dashboard" class="text-decoration-none text-muted">หน้าหลัก</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">รีวิวและประเมินบริการ</li>
        </ol>
    </nav>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2" style="color:#0f172a;">
                <span class="material-symbols-outlined text-primary" style="font-size:2rem;">rate_review</span>
                รีวิวและประเมินความพึงพอใจ
            </h1>
            <p class="text-secondary mb-0" style="font-size:0.92rem;">
                แชร์ประสบการณ์การใช้พื้นที่คลังสินค้า และข้อเสนอแนะเพื่อพัฒนาบริการให้ดียิ่งขึ้น
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                <span class="material-symbols-outlined align-middle me-1" style="font-size:1rem;">verified</span>
                รีวิวจากผู้เช่าจริง 100%
            </span>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- Left Column: Write Review -->
    <div class="col-12 col-lg-5">
        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined">edit_note</span> เขียนรีวิวการใช้งานคลังสินค้า</h2>
            </div>

            <form id="reviewForm" onsubmit="submitReview(event)">
                <div class="mb-3">
                    <label class="form-label">เลือกสัญญาการจองที่ต้องการประเมิน *</label>
                    <select class="form-select" id="reviewBookingSelect" required>
                        <option value="BK-2026-001">BK-2026-001 — Unit M-01 (ไซส์ M โซน B1 - 150 ตร.ม.)</option>
                        <option value="BK-2025-018">BK-2025-018 — Unit CR-05 (ห้องเย็น โซน Cold - 200 ตร.ม.)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">ระดับความพึงพอใจโดยรวม *</label>
                    <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background:#f8fafc; border:1px solid #e2e8f0;">
                        <div class="d-flex gap-1" id="starContainer">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="material-symbols-outlined"
                                      id="star_@i"
                                      onclick="setStar(@i)"
                                      style="font-size:2.2rem; cursor:pointer; color:#cbd5e1; transition:all 0.15s ease;">
                                    star
                                </span>
                            }
                        </div>
                        <div id="starLabel" class="small fw-bold text-muted ms-2">คลิกเพื่อให้คะแนน</div>
                    </div>
                </div>

                <!-- Detailed Criteria -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-secondary mb-1">ความสะอาดของพื้นที่</label>
                        <select class="form-select form-select-sm">
                            <option>5 ★ ยอดเยี่ยม</option>
                            <option selected>4 ★ ดีมาก</option>
                            <option>3 ★ พอใช้</option>
                            <option>2 ★ ควรปรับปรุง</option>
                            <option>1 ★ แย่</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-secondary mb-1">ระบบความปลอดภัย &amp; CCTV</label>
                        <select class="form-select form-select-sm">
                            <option selected>5 ★ ยอดเยี่ยม</option>
                            <option>4 ★ ดีมาก</option>
                            <option>3 ★ พอใช้</option>
                            <option>2 ★ ควรปรับปรุง</option>
                            <option>1 ★ แย่</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-secondary mb-1">ความสะดวกในการโหลดของ</label>
                        <select class="form-select form-select-sm">
                            <option selected>5 ★ ยอดเยี่ยม</option>
                            <option>4 ★ ดีมาก</option>
                            <option>3 ★ พอใช้</option>
                            <option>2 ★ ควรปรับปรุง</option>
                            <option>1 ★ แย่</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-secondary mb-1">การบริการของเจ้าหน้าที่</label>
                        <select class="form-select form-select-sm">
                            <option selected>5 ★ ยอดเยี่ยม</option>
                            <option>4 ★ ดีมาก</option>
                            <option>3 ★ พอใช้</option>
                            <option>2 ★ ควรปรับปรุง</option>
                            <option>1 ★ แย่</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">รายละเอียดความคิดเห็นและข้อเสนอแนะ *</label>
                    <textarea class="form-control" rows="4" id="reviewComment"
                              placeholder="บอกเล่าประสบการณ์การใช้งาน เช่น สภาพพื้นผิวคลัง ความปลอดภัย การบริการของทีมช่าง หรือการเทียบรถบรรทุก..." required></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">แนบรูปภาพประกอบ (ถ้ามี)</label>
                    <div class="p-3 text-center rounded-3" style="border:2px dashed #cbd5e1; cursor:pointer; background:#f8fafc;"
                         onclick="document.getElementById('reviewImg').click()">
                        <span class="material-symbols-outlined text-muted" style="font-size:1.8rem;">add_photo_alternate</span>
                        <div class="text-muted small mt-1">คลิกเพื่ออัปโหลดภาพถ่ายพื้นที่ หรือสเตจสินค้า</div>
                        <input type="file" id="reviewImg" class="d-none" accept="image/*" multiple onchange="onImgSelected(event)" />
                    </div>
                    <div id="imgPreviewText" class="small text-success fw-semibold mt-1" style="display:none;">
                        ✓ เลือกไฟล์รูปภาพเรียบร้อยแล้ว
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" style="border-radius:10px; height:42px;">
                    <span class="material-symbols-outlined" style="font-size:1.1rem;">send</span>
                    <span>ส่งความคิดเห็นและรีวิว</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Right Column: Summary Ratings & Verified Reviews -->
    <div class="col-12 col-lg-7">
        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined">forum</span> ภาพรวมคะแนนจากลูกค้าทั้งหมด</h2>
                <span class="badge bg-light text-dark border px-3 py-1 rounded-pill small">
                    อัปเดตแบบ Real-Time
                </span>
            </div>

            <!-- Score Summary Card -->
            <div class="p-4 rounded-3 mb-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-sm-4 text-center border-sm-end">
                        <div class="display-4 fw-bold text-dark mb-0">4.8</div>
                        <div class="text-warning fs-5 my-1">★★★★★</div>
                        <div class="text-muted small">จากผู้เช่าองค์กร 47 ราย</div>
                        <div class="badge bg-success-subtle text-success fw-semibold mt-2 px-2 py-1">
                            98% ผู้เช่าแนะนำต่อ
                        </div>
                    </div>
                    <div class="col-12 col-sm-8">
                        @foreach (var bar in new[] { ("5 ดาว", 82), ("4 ดาว", 14), ("3 ดาว", 4), ("2 ดาว", 0), ("1 ดาว", 0) })
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="text-muted small" style="width:45px;">@bar.Item1</span>
                                <div class="progress flex-grow-1" style="height:8px; border-radius:4px; background:#e2e8f0;">
                                    <div class="progress-bar bg-warning" role="progressbar" style="width: @bar.Item2%;" aria-valuenow="@bar.Item2" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <span class="text-muted small text-end" style="width:36px;">@bar.Item2%</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- List of Verified Reviews -->
            <h3 class="h6 fw-bold text-dark mb-3">ความคิดเห็นล่าสุดจากผู้เช่าคลังสินค้า</h3>

            <div class="vstack gap-3" id="reviewsList">
                @foreach (var rev in new[] {
                    ("บริษัท สยาม โลจิสติกส์ โซลูชั่นส์ จำกัด", "Unit M-01 (ไซส์ M - 150 ตร.ม.)", 5, "ห้องสะอาด โครงสร้างแข็งแรงมาก พื้นคอนกรีตอีพ็อกซี่เรียบเนียน โฟล์กลิฟต์วิ่งคล่องตัว ระบบชานชาลาสะดวกต่อการกระจายสินค้า มีรปภ. AI ดูแล 24 ชม. มั่นใจมากครับ", "ส", "#1e40af", "12 ก.ย. 2569", 8),
                    ("คุณสมชาย นำเจริญ (บจก. นำเจริญ ซัพพลาย)", "Unit CR-05 (ห้องเย็น - 200 ตร.ม.)", 5, "ระบบคุมอุณหภูมินิ่งมาก -18°C ตลอดเวลา มีไฟสำรองฉุกเฉินทำให้สินค้าอาหารแช่แข็งไม่เสียหาย เจ้าหน้าที่โครงการให้คำแนะนำดีมากครับ", "ส", "#059669", "8 ก.ย. 2569", 5),
                    ("ร้านค้าออนไลน์ SuperShop Thailand", "Unit S-02 (ไซส์ S - 80 ตร.ม.)", 4, "ขนาดกะทัดรัด ประตูม้วนไฟฟ้ารวดเร็ว เหมาะกับธุรกิจ E-Commerce สต็อกของพร้อมแพ็คส่ง รถกระบะถอยเข้าเทียบง่ายมากครับ", "S", "#d97706", "5 ก.ย. 2569", 3),
                    ("บริษัท ไทยโกลบอล ซัพพลายเชน จำกัด", "Unit L-01 (ไซส์ L - 500 ตร.ม.)", 5, "คลังสินค้าขนาดใหญ่ มี Dock Leveler อัตโนมัติ รถพ่วง 18 ล้อเทียบตู้คอนเทนเนอร์ 40 ฟุตได้สบาย ประหยัดเวลาโหลดสินค้าไปได้มาก", "ท", "#7c3aed", "1 ก.ย. 2569", 11)
                })
                {
                    <div class="p-3 rounded-3" style="background:#ffffff; border:1px solid #e2e8f0;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar rounded-circle text-white d-flex align-items-center justify-content-center fw-bold"
                                     style="background:@rev.Item6; width:38px; height:38px; font-size:0.9rem;">
                                    @rev.Item5
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size:0.9rem;">@rev.Item1</div>
                                    <div class="text-muted small" style="font-size:0.75rem;">@rev.Item2</div>
                                </div>
                            </div>
                            <span class="text-muted small" style="font-size:0.75rem;">@rev.Item7</span>
                        </div>

                        <div class="text-warning small mb-2">
                            @for (int i = 0; i < rev.Item3; i++) { <text>★</text> }
                            @for (int i = rev.Item3; i < 5; i++) { <span class="text-secondary opacity-25">★</span> }
                            <span class="text-dark fw-bold ms-1" style="font-size:0.8rem;">(@rev.Item3.0 / 5.0)</span>
                        </div>

                        <p class="text-secondary small mb-2" style="line-height:1.55;">@rev.Item4</p>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="badge bg-light text-muted border small">
                                <span class="material-symbols-outlined align-middle me-1" style="font-size:0.85rem; color:#059669;">verified</span>
                                ผู้เช่าที่ผ่านการตรวจสอบสัญญา
                            </span>
                            <button class="btn btn-sm btn-link text-decoration-none text-muted p-0 small d-inline-flex align-items-center gap-1"
                                    onclick="likeReview(this, @rev.Item8)">
                                <span class="material-symbols-outlined" style="font-size:1rem;">thumb_up</span>
                                <span>มีประโยชน์ (<span class="like-num">@rev.Item8</span>)</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
let currentStar = 5;
const labels = ['','1 ดาว — ควรปรับปรุง','2 ดาว — พอใช้','3 ดาว — ปานกลาง','4 ดาว — ดีมาก','5 ดาว — ยอดเยี่ยม'];
const colors = ['','#ef4444','#f97316','#f59e0b','#2563eb','#059669'];

function setStar(n) {
    currentStar = n;
    for (let i = 1; i <= 5; i++) {
        const el = document.getElementById('star_' + i);
        if (i <= n) {
            el.style.color = colors[n];
        } else {
            el.style.color = '#cbd5e1';
        }
    }
    document.getElementById('starLabel').textContent = labels[n];
    document.getElementById('starLabel').style.color = colors[n];
}

// Hover effects
for (let i = 1; i <= 5; i++) {
    const el = document.getElementById('star_' + i);
    el.addEventListener('mouseenter', () => {
        for (let j = 1; j <= 5; j++) {
            document.getElementById('star_' + j).style.color = j <= i ? '#f59e0b' : '#cbd5e1';
        }
    });
    el.addEventListener('mouseleave', () => setStar(currentStar));
}

setStar(5);

function onImgSelected(e) {
    if (e.target.files.length > 0) {
        document.getElementById('imgPreviewText').style.display = 'block';
    }
}

function submitReview(e) {
    e.preventDefault();
    const comment = document.getElementById('reviewComment').value;
    if (!comment) return;

    alert('ขอบคุณสำหรับความคิดเห็นและการประเมินบริการ!\nรีวิวของคุณได้รับการบันทึกและแสดงในระบบเรียบร้อยแล้ว');
    document.getElementById('reviewComment').value = '';
    document.getElementById('imgPreviewText').style.display = 'none';
}

function likeReview(btn, count) {
    const numSpan = btn.querySelector('.like-num');
    if (!btn.classList.contains('liked')) {
        btn.classList.add('liked');
        btn.classList.remove('text-muted');
        btn.classList.add('text-primary');
        numSpan.textContent = count + 1;
    }
}
</script>
}
