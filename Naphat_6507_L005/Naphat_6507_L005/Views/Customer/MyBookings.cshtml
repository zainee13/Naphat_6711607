@{
    ViewData["Title"] = "การจองของฉัน";
    Layout = "_Layout";
}

<div class="page-header mb-4">
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-0 small" style="--bs-breadcrumb-divider: '›';">
            <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Dashboard" class="text-decoration-none text-muted">หน้าหลัก</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">การจองของฉัน</li>
        </ol>
    </nav>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2" style="color:#0f172a;">
                <span class="material-symbols-outlined text-primary" style="font-size:2rem;">assignment</span>
                รายการจองห้องคลังสินค้าทั้งหมด
            </h1>
            <p class="text-secondary mb-0" style="font-size:0.92rem;">
                ติดตามสถานะสัญญา วันที่เริ่มสัญญา และการจัดการชำระเงิน
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Customer" asp-action="Search" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" style="border-radius:8px;">
                <span class="material-symbols-outlined" style="font-size:1rem;">add</span>
                <span>จองห้องคลังเพิ่ม</span>
            </a>
            <a asp-controller="Customer" asp-action="Profile" asp-route-tab="bookings" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1" style="border-radius:8px;">
                <span class="material-symbols-outlined" style="font-size:1rem;">account_circle</span>
                <span>จัดการในหน้าโปรไฟล์</span>
            </a>
        </div>
    </div>
</div>

<!-- Status Summary KPI -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="kpi-card h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#eff6ff; width:44px; height:44px;">
                    <span class="material-symbols-outlined" style="color:#2563eb; font-size:1.4rem;">receipt_long</span>
                </div>
                <div>
                    <div class="kpi-value fs-4">4</div>
                    <div class="kpi-label">การจองทั้งหมด</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#fffbeb; width:44px; height:44px;">
                    <span class="material-symbols-outlined" style="color:#d97706; font-size:1.4rem;">pending_actions</span>
                </div>
                <div>
                    <div class="kpi-value fs-4 text-warning">1</div>
                    <div class="kpi-label">รอชำระเงิน</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#ecfdf5; width:44px; height:44px;">
                    <span class="material-symbols-outlined" style="color:#059669; font-size:1.4rem;">verified</span>
                </div>
                <div>
                    <div class="kpi-value fs-4 text-success">2</div>
                    <div class="kpi-label">สัญญาที่ใช้งานอยู่</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#fef2f2; width:44px; height:44px;">
                    <span class="material-symbols-outlined" style="color:#dc2626; font-size:1.4rem;">cancel</span>
                </div>
                <div>
                    <div class="kpi-value fs-4 text-secondary">1</div>
                    <div class="kpi-label">ยกเลิก / สิ้นสุด</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bookings Table Card -->
<div class="section-card">
    <div class="section-card-header">
        <h2><span class="material-symbols-outlined">table_chart</span> รายการสัญญาจองคลังสินค้า</h2>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm" id="bookingFilter" style="width:auto; border-radius:8px;">
                <option value="all">ทุกสถานะสัญญา</option>
                <option value="confirmed">ใช้งานอยู่ / ยืนยันแล้ว</option>
                <option value="pending">รอชำระเงิน</option>
                <option value="cancelled">ยกเลิกแล้ว</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table-custom w-100">
            <thead>
                <tr>
                    <th>รหัสการจอง</th>
                    <th>ห้องคลังสินค้า</th>
                    <th>ขนาด / โซน</th>
                    <th>ช่วงเวลาสัญญา</th>
                    <th>ค่าเช่ารวม</th>
                    <th>สถานะการจอง</th>
                    <th>การชำระเงิน</th>
                    <th class="text-center">การดำเนินการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in new[] {
                    ("BK-2026-002","Unit L-01 (ไซส์ L)","500 ตร.ม. • โซน C1 (มี Dock)","1 ก.พ. 2569 — 31 ก.ค. 2569 (6 เดือน)","฿275,000","รอการยืนยัน","pending","⚠️ รอชำระเงิน","pending"),
                    ("BK-2026-001","Unit M-01 (ไซส์ M)","150 ตร.ม. • โซน B1 (มาตรฐาน)","1 ม.ค. 2569 — 30 มิ.ย. 2569 (6 เดือน)","฿200,000","ยืนยันแล้ว","confirmed","ชำระครบแล้ว","confirmed"),
                    ("BK-2025-018","Unit CR-05 (ห้องเย็น)","200 ตร.ม. • โซน Cold Storage","1 ก.ค. 2568 — 31 ธ.ค. 2568 (6 เดือน)","฿130,000","เสร็จสิ้นสัญญา","confirmed","ชำระแล้ว","confirmed"),
                    ("BK-2025-009","Unit M-01 (ไซส์ M)","150 ตร.ม. • โซน B1 (มาตรฐาน)","1 ม.ค. 2568 — 30 มิ.ย. 2568 (6 เดือน)","฿200,000","ยกเลิก","occupied","คืนเงินแล้ว","occupied")
                })
                {
                    <tr>
                        <td>
                            <strong class="text-primary" style="font-size:0.9rem;">@b.Item1</strong>
                        </td>
                        <td>
                            <div class="fw-bold text-dark" style="font-size:0.9rem;">@b.Item2</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border small">@b.Item3</span>
                        </td>
                        <td class="text-secondary small">@b.Item4</td>
                        <td>
                            <strong class="text-dark">@b.Item5</strong>
                        </td>
                        <td>
                            <span class="badge-status badge-@b.Item7">@b.Item6</span>
                        </td>
                        <td>
                            <span class="badge-status badge-@b.Item9">@b.Item8</span>
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-1">
                                @if (b.Item7 == "pending")
                                {
                                    <a asp-controller="Customer" asp-action="Profile" asp-route-tab="payment" asp-route-bookingId="@b.Item1"
                                       class="btn btn-sm btn-primary py-1 px-2 fw-semibold" style="font-size:0.75rem; border-radius:6px;">
                                        ชำระเงินทันที
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size:0.75rem; border-radius:6px;" onclick="alert('กำลังเปิดเอกสารสัญญาเช่า @b.Item1 (PDF)');">
                                        ดูสัญญา
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
