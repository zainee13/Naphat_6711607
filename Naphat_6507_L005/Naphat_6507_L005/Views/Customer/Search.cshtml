@model List<Naphat_6507_L005.ViewModels.RoomViewModel>
@{
    ViewData["Title"] = "ค้นหาห้องคลังสินค้า";
    Layout = "_Layout";

    var rooms = Model;
    var freeCount = rooms.Count(r => r.Free);

    // ห้องที่เลือกไว้ตอนเปิดหน้า
    var firstRoom = rooms.First(r => r.Id == "M-01");

    // รายการการ์ด: ห้องว่างขึ้นก่อน แล้วเรียงตามราคา
    var roomList = rooms.OrderBy(r => r.Free ? 0 : 1).ThenBy(r => r.Price);

    var detailUrl = Url.Action("RoomDetail", "Customer");
    var bookUrl = Url.Action("BookRoom", "Customer");
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}

<div class="sr cu">

    <!-- หัวข้อ -->
    <header class="cu-head">
        <h1>ค้นหาห้องคลังสินค้า</h1>
        <p>ว่าง <strong>@freeCount</strong> จาก @rooms.Count ห้อง แตะห้องบนผังเพื่อดูรายละเอียดและจอง</p>
    </header>

    <div class="fp-board">

        <!-- ผังคลังสินค้า -->
        <div class="fp-plan-wrap">
            <div class="fp-plan" role="group" aria-label="ผังห้องคลังสินค้า">
                @foreach (var room in rooms)
                {
                    var isSelected = room.Id == firstRoom.Id;
                    var takenClass = room.Free ? "" : "is-taken";
                    var selectedClass = isSelected ? "is-selected" : "";
                    var statusText = room.Free ? "ว่าง" : "มีผู้เช่าแล้ว";

                    <button type="button"
                            class="fp-unit fp-unit--@room.Kind @takenClass @selectedClass"
                            style="grid-area:@room.Grid;"
                            aria-pressed="@(isSelected ? "true" : "false")"
                            aria-label="ห้อง @room.Id @room.Area ตารางเมตร @statusText"
                            data-id="@room.Id"
                            data-free="@(room.Free ? "1" : "0")"
                            data-kind="@room.Kind"
                            data-area="@room.Area"
                            data-ceil="@room.Height"
                            data-truck="@room.Vehicle"
                            data-power="@room.Power"
                            data-price="@room.Price.ToString("N0")"
                            data-zone="@room.Zone"
                            data-note="@room.Note">
                        <span class="fp-unit-code">@room.Id</span>
                        <span class="fp-unit-area">@room.Area ตร.ม.</span>
                    </button>
                }
            </div>

            <ul class="fp-legend">
                <li><i class="fp-sw"></i>ว่าง</li>
                <li><i class="fp-sw fp-sw--cold"></i>ห้องเย็น (ว่าง)</li>
                <li><i class="fp-sw fp-sw--taken"></i>มีผู้เช่าแล้ว</li>
            </ul>
        </div>

        <!-- รายละเอียดห้องที่เลือก (JS จะเปลี่ยนข้อมูลเมื่อกดห้องบนผัง) -->
        <aside class="fp-detail" id="roomDetail" aria-live="polite">
            <div class="fp-detail-head">
                <div class="fp-detail-code" id="detailId">@firstRoom.Id</div>
                <span class="cu-status" id="detailStatus">ว่าง พร้อมส่งมอบ</span>
            </div>

            <p class="fp-detail-zone">
                <span id="detailZone">@firstRoom.Zone</span>, <span id="detailNote">@firstRoom.Note</span>
            </p>

            <dl class="fp-spec">
                <div><dt>พื้นที่</dt><dd><span id="detailArea">@firstRoom.Area</span> ตร.ม.</dd></div>
                <div><dt>เพดานสูง</dt><dd id="detailCeil">@firstRoom.Height</dd></div>
                <div><dt>รถที่เข้าได้</dt><dd id="detailTruck">@firstRoom.Vehicle</dd></div>
                <div><dt>ไฟฟ้า</dt><dd id="detailPower">@firstRoom.Power</dd></div>
            </dl>

            <div class="fp-price">
                <span>ค่าเช่า</span>
                <strong>฿<span id="detailPrice">@firstRoom.Price.ToString("N0")</span></strong>
                <span>ต่อเดือน</span>
            </div>

            <!-- ปุ่มสำหรับห้องว่าง -->
            <div class="fp-actions" id="actionsFree">
                <a class="cu-btn cu-btn--primary" id="btnBook" href="@bookUrl/@firstRoom.Id">จองห้องนี้</a>
                <a class="cu-btn" id="btnDetail" href="@detailUrl/@firstRoom.Id">ดูสเปกห้อง</a>
            </div>

            <!-- ข้อความสำหรับห้องที่มีผู้เช่าแล้ว -->
            <div class="fp-actions" id="actionsTaken" hidden>
                <p class="fp-taken-note">ห้องนี้มีผู้เช่าแล้ว เลือกห้องอื่นบนผังได้เลย</p>
            </div>
        </aside>
    </div>

    <!-- รายการห้องทั้งหมด -->
    <section class="sr-list" aria-labelledby="roomListTitle">
        <h2 id="roomListTitle">ห้องทั้งหมด</h2>

        <ul class="sr-grid">
            @foreach (var room in roomList)
            {
                <li class="sr-card @(room.Free ? "" : "is-taken")">
                    <div class="sr-card-img">
                        <img src="@(room.Img)?w=600&q=80" alt="" loading="lazy" />
                        @if (!room.Free)
                        {
                            <span class="sr-card-flag">มีผู้เช่าแล้ว</span>
                        }
                    </div>

                    <div class="sr-card-body">
                        <div class="sr-card-top">
                            <h3><a href="@detailUrl/@room.Id">@room.Id</a></h3>
                            <span class="sr-rating" aria-label="คะแนน @room.Rating จาก 5">★ @room.Rating</span>
                        </div>
                        <p class="sr-card-spec">@room.Area ตร.ม., เพดาน @room.Height</p>
                        <p class="sr-card-zone">@room.Zone, @room.Note</p>
                        <p class="sr-card-price">
                            <strong>฿@room.Price.ToString("N0")</strong> ต่อเดือน
                            @if (room.OldPrice > 0)
                            {
                                <s>฿@room.OldPrice.ToString("N0")</s>
                            }
                        </p>
                    </div>
                </li>
            }
        </ul>
    </section>
</div>

@section Scripts {
<script>
    const detailUrl = '@detailUrl';
    const bookUrl = '@bookUrl';
    const roomButtons = document.querySelectorAll('.fp-unit');

    // เลือกห้องบนผัง แล้วแสดงข้อมูลห้องนั้นในกล่องรายละเอียด
    function selectRoom(button) {
        // ไฮไลต์ห้องที่เลือก
        roomButtons.forEach(function (item) {
            const isThis = (item === button);
            item.classList.toggle('is-selected', isThis);
            item.setAttribute('aria-pressed', isThis ? 'true' : 'false');
        });

        // ข้อมูลห้องเก็บไว้ใน data-* ของปุ่ม
        const room = button.dataset;
        const isFree = (room.free === '1');

        document.getElementById('detailId').textContent = room.id;
        document.getElementById('detailZone').textContent = room.zone;
        document.getElementById('detailNote').textContent = room.note;
        document.getElementById('detailArea').textContent = room.area;
        document.getElementById('detailCeil').textContent = room.ceil;
        document.getElementById('detailTruck').textContent = room.truck;
        document.getElementById('detailPower').textContent = room.power;
        document.getElementById('detailPrice').textContent = room.price;

        // สถานะห้อง
        const status = document.getElementById('detailStatus');
        if (!isFree) {
            status.textContent = 'มีผู้เช่าแล้ว';
        } else if (room.kind === 'cold') {
            status.textContent = 'ว่าง ห้องเย็น';
        } else {
            status.textContent = 'ว่าง พร้อมส่งมอบ';
        }
        status.classList.toggle('is-taken', !isFree);
        document.getElementById('roomDetail').classList.toggle('is-taken', !isFree);

        // ห้องว่างแสดงปุ่มจอง ห้องไม่ว่างแสดงข้อความแทน
        document.getElementById('actionsFree').hidden = !isFree;
        document.getElementById('actionsTaken').hidden = isFree;
        document.getElementById('btnBook').href = bookUrl + '/' + room.id;
        document.getElementById('btnDetail').href = detailUrl + '/' + room.id;
    }

    roomButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            selectRoom(button);
        });
    });

    // ถ้ามาจากฟอร์มค้นหาหน้าหลัก (เช่น ?size=s) ให้เลือกห้องว่างห้องแรกของขนาดนั้น
    const size = new URLSearchParams(window.location.search).get('size');
    if (size && size !== 'all') {
        const match = document.querySelector('.fp-unit[data-kind="' + size + '"][data-free="1"]');
        if (match) {
            selectRoom(match);
        }
    }
</script>
}
