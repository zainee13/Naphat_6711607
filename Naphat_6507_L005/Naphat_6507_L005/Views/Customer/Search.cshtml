@{
    ViewData["Title"] = "ค้นหาและจองห้องคลังสินค้าตามขนาด";
    Layout = "_Layout";
}

<div class="page-header mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color:#1e293b;">
                <span class="material-symbols-outlined align-middle me-2 text-primary" style="font-size:1.8rem;">view_cozy</span>
                ค้นหาและจองห้องคลังสินค้าตามขนาด
            </h1>
            <p class="text-secondary mb-0" style="font-size:0.9rem;">
                คลังสินค้าโครงการของเราเอง — เลือกระดับขนาดห้องที่ตรงกับการจัดเก็บสินค้าของคุณ พร้อมจองได้ทันที
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:600; padding:0.5rem 0.9rem; border-radius:30px; font-size:0.85rem;">
                <span class="material-symbols-outlined align-middle me-1" style="font-size:1rem;">check_circle</span>
                ว่าง 7 ยูนิตพร้อมให้บริการ
            </span>
            <a asp-controller="Customer" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" style="border-radius:8px;">
                <span class="material-symbols-outlined" style="font-size:1rem;">local_offer</span>
                ดูโปรโมชั่น
            </a>
        </div>
    </div>
</div>

<!-- Quick Size Filter Pills -->
<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-sm btn-primary px-3 size-filter-btn active" onclick="selectSizeFilter('all', this)" style="border-radius:20px; font-weight:600;">
        ทุกขนาดห้อง
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary px-3 size-filter-btn" onclick="selectSizeFilter('s', this)" style="border-radius:20px;">
        📦 ไซส์ S (30 - 80 ตร.ม.)
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary px-3 size-filter-btn" onclick="selectSizeFilter('m', this)" style="border-radius:20px;">
        🏭 ไซส์ M (100 - 250 ตร.ม.)
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary px-3 size-filter-btn" onclick="selectSizeFilter('l', this)" style="border-radius:20px;">
        🚚 ไซส์ L (300 - 500 ตร.ม.)
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary px-3 size-filter-btn" onclick="selectSizeFilter('xl', this)" style="border-radius:20px;">
        ⚡ ไซส์ XL (600+ ตร.ม.)
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary px-3 size-filter-btn" onclick="selectSizeFilter('cold', this)" style="border-radius:20px;">
        ❄️ ห้องเย็น / ปรับอุณหภูมิ
    </button>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-body p-4">
        <form id="filterForm" onsubmit="return false;">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">square_foot</span>
                        ระดับขนาดห้อง
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><span class="material-symbols-outlined" style="font-size:1.1rem; color:#64748b;">aspect_ratio</span></span>
                        <select class="form-select border-start-0 ps-0" id="filterSizeSelect" onchange="onSelectChanged()" style="border-radius:0 8px 8px 0;">
                            <option value="all">ทุกขนาดห้อง</option>
                            <option value="s">ไซส์ S: 30 - 80 ตร.ม. (SME / แม่ค้าออนไลน์)</option>
                            <option value="m">ไซส์ M: 100 - 250 ตร.ม. (ขนาดยอดนิยม วางพาเลท)</option>
                            <option value="l">ไซส์ L: 300 - 500 ตร.ม. (คลังใหญ่ มี Dock Leveler)</option>
                            <option value="xl">ไซส์ XL: 600 - 1,200 ตร.ม. (เมกะแวร์เฮ้าส์)</option>
                            <option value="cold">ห้องเย็นควบคุมอุณหภูมิ (-18°C ถึง +5°C)</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">payments</span>
                        งบประมาณ / เดือน
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><span class="material-symbols-outlined" style="font-size:1.1rem; color:#64748b;">attach_money</span></span>
                        <select class="form-select border-start-0 ps-0" id="filterPriceSelect" onchange="applyFilters()" style="border-radius:0 8px 8px 0;">
                            <option value="all">ทุกช่วงราคา</option>
                            <option value="under20k">ต่ำกว่า 20,000 บาท</option>
                            <option value="20k-50k">20,000 - 50,000 บาท</option>
                            <option value="50k-100k">50,000 - 100,000 บาท</option>
                            <option value="over100k">100,000 บาทขึ้นไป</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <button type="button" class="btn btn-primary w-100 d-flex justify-content-center align-items-center gap-2"
                            onclick="applyFilters()"
                            style="background: linear-gradient(135deg,#2563eb,#1d4ed8); border:none; border-radius:8px; height:34px; font-weight:600; font-size:0.875rem;">
                        <span class="material-symbols-outlined" style="font-size:1.1rem;">search</span>
                        กรองห้องว่างตามเงื่อนไข
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Special Promotion Banner Notice in Search -->
<div class="alert border-0 shadow-sm d-flex align-items-center justify-content-between mb-4"
     style="background: linear-gradient(90deg, #eff6ff 0%, #f0fdf4 100%); border-left: 4px solid #3b82f6 !important; border-radius: 12px; padding: 1rem 1.25rem;">
    <div class="d-flex align-items-center gap-3">
        <span class="material-symbols-outlined text-primary" style="font-size: 2rem;">campaign</span>
        <div>
            <strong style="color: #1e3a8a; font-size: 0.95rem;">โปรโมชั่นต้อนรับลูกค้าใหม่ในคลังสินค้าของเรา!</strong>
            <p class="mb-0 text-muted" style="font-size: 0.85rem;">จองห้องที่มีป้าย <span class="badge bg-danger">PROMO</span> หรือ <span class="badge bg-danger">ลดราคา</span> รับส่วนลดสูงสุด 35% ทันที</p>
        </div>
    </div>
    <a asp-controller="Customer" asp-action="Dashboard" class="btn btn-sm btn-outline-primary" style="border-radius: 8px; font-size: 0.82rem; white-space: nowrap;">
        ดูแคมเปญโปรโมชั่นทั้งหมด &rarr;
    </a>
</div>

<!-- Room Cards -->
<div class="row g-4" id="customerRoomGrid">
    @foreach (var room in new[] {
        new { Id="M-01", Name="Unit M-01 (ขนาด 150 ตร.ม.)", SizeCat="m", Desc="โกดังมาตรฐาน พื้นอีพ็อกซี่ รองรับน้ำหนัก 3 ตัน/ตร.ม. โฟล์กลิฟต์เข้าสะดวก", Size="150", Price="25,000", PriceVal=25000, OldPrice="29,000", Promo="ลด 14%", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&q=80", Rating="4.8", Reviews="12", Zone="โซน A1 (มาตรฐาน)", SizeLabel="ไซส์ M" },
        new { Id="L-01", Name="Unit L-01 (ขนาด 500 ตร.ม.)", SizeCat="l", Desc="คลังสินค้าขนาดใหญ่ รองรับรถพ่วง 18 ล้อ พร้อม Dock Leveler เทียบตู้คอนเทนเนอร์", Size="500", Price="75,000", PriceVal=75000, OldPrice="85,000", Promo="ลด 12%", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1553413077-190dd305871c?w=600&q=80", Rating="4.6", Reviews="8", Zone="โซน B1 (คลังใหญ่)", SizeLabel="ไซส์ L" },
        new { Id="CR-05", Name="Unit CR-05 (ห้องเย็น 200 ตร.ม.)", SizeCat="cold", Desc="ห้องเย็นควบคุมอุณหภูมิ -18 ถึง +5°C ระบบไฟสำรองคู่ พร้อมเซ็นเซอร์ IoT Real-Time", Size="200", Price="40,000", PriceVal=40000, OldPrice="48,000", Promo="HOT DEAL", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1566576912321-d58ddd7a6088?w=600&q=80", Rating="4.9", Reviews="21", Zone="โซน C (ห้องเย็น)", SizeLabel="ห้องเย็น" },
        new { Id="L-02", Name="Unit L-02 (ขนาด 350 ตร.ม.)", SizeCat="l", Desc="เพดานสูง 10 เมตร พื้นที่จัดเก็บสินค้าปลอดภัยสูง พร้อมระบบ CCTV แยกห้อง", Size="350", Price="55,000", PriceVal=55000, OldPrice="", Promo="", Status="ไม่ว่าง", StatusClass="badge-occupied",
              Img="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=600&q=80", Rating="4.5", Reviews="6", Zone="โซน B2 (เพดานสูง)", SizeLabel="ไซส์ L" },
        new { Id="S-02", Name="Unit S-02 (ขนาด 80 ตร.ม.)", SizeCat="s", Desc="ห้องขนาดกะทัดรัด ประตูม้วนไฟฟ้า สะดวกต่อการโหลดสินค้า เหมาะกับ SME และออนไลน์", Size="80", Price="15,000", PriceVal=15000, OldPrice="18,000", Promo="ลด 16%", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=600&q=80", Rating="4.3", Reviews="9", Zone="โซน A2 (SME)", SizeLabel="ไซส์ S" },
        new { Id="XL-01", Name="Unit XL-01 (ขนาด 1,200 ตร.ม.)", SizeCat="xl", Desc="คลังขนาดใหญ่พิเศษ เพดานสูง 12 ม. ระบบ WMS & Cloud Monitoring พร้อมออฟฟิศในตัว", Size="1200", Price="180,000", PriceVal=180000, OldPrice="210,000", Promo="FLASH DEAL", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1494412685616-a5d310fbb07d?w=600&q=80", Rating="5.0", Reviews="4", Zone="โซน D1 (เมกะ)", SizeLabel="ไซส์ XL" },
        new { Id="S-01", Name="Unit S-01 (ขนาด 60 ตร.ม.)", SizeCat="s", Desc="ห้องไซส์เล็ก ชั้น 1 เข้าถึงง่าย เหมาะกับเก็บเอกสารและสต็อกสินค้าพร้อมส่ง", Size="60", Price="12,000", PriceVal=12000, OldPrice="", Promo="SME START", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&q=80", Rating="4.7", Reviews="10", Zone="โซน A1 (ชั้น 1)", SizeLabel="ไซส์ S" },
        new { Id="M-02", Name="Unit M-02 (ขนาด 250 ตร.ม.)", SizeCat="m", Desc="ห้องขนาดกลาง เพดาน 8 เมตร ติดตั้ง Racking ได้ 3 ชั้น รองรับพาเลท 120 ตัว", Size="250", Price="38,000", PriceVal=38000, OldPrice="", Promo="", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1553413077-190dd305871c?w=600&q=80", Rating="4.8", Reviews="5", Zone="โซน B2 (พาเลท)", SizeLabel="ไซส์ M" }
    })
    {
        <div class="col-12 col-md-6 col-xl-4 customer-room-card" data-size="@room.SizeCat" data-price="@room.PriceVal">
            <div class="room-card card border-0 shadow-sm h-100 overflow-hidden" style="border-radius:14px; transition: transform 0.2s, box-shadow 0.2s;">
                <div style="position:relative; height:190px; overflow:hidden;">
                    <img src="@room.Img" alt="@room.Name" style="width:100%; height:100%; object-fit:cover;" />
                    
                    <span class="badge @(room.Status == "ว่าง" ? "bg-success" : "bg-secondary")"
                          style="position:absolute; top:12px; left:12px; font-weight:600; padding:0.35rem 0.65rem; border-radius:6px;">
                        @(room.Status == "ว่าง" ? "● ว่างพร้อมเข้าใช้" : "● จองแล้ว")
                    </span>

                    @if (!string.IsNullOrEmpty(room.Promo))
                    {
                        <span class="badge bg-danger shadow-sm"
                              style="position:absolute; top:12px; right:12px; font-weight:700; padding:0.35rem 0.65rem; border-radius:6px;">
                            🔥 @room.Promo
                        </span>
                    }

                    <div style="position:absolute; bottom:8px; left:12px; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px); color:#fff; border-radius:6px; padding:3px 8px; font-size:0.75rem;">
                        <span class="badge bg-primary me-1" style="font-size:0.7rem;">@room.SizeLabel</span>
                        <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">warehouse</span>
                        @room.Zone
                    </div>
                </div>

                <div class="card-body p-3 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h2 class="h6 fw-bold mb-0" style="color:#0f172a;">@room.Name</h2>
                        <div class="text-warning fw-bold d-flex align-items-center" style="font-size:0.82rem;">
                            ★ @room.Rating
                            <span class="text-muted ms-1" style="font-size:0.75rem; font-weight:normal;">(@room.Reviews)</span>
                        </div>
                    </div>

                    <p class="text-secondary small mb-3" style="min-height:36px; line-height:1.4;">@room.Desc</p>

                    <div class="row g-2 border-top border-bottom py-2 my-auto bg-light rounded-3 px-1 mb-3">
                        <div class="col-6">
                            <span class="text-muted d-block" style="font-size:0.75rem;">พื้นที่จัดเก็บ</span>
                            <strong style="color:#1e293b; font-size:0.92rem;">@room.Size ตร.ม. (@room.SizeLabel)</strong>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted d-block" style="font-size:0.75rem;">ราคาเช่า/เดือน</span>
                            @if (!string.IsNullOrEmpty(room.OldPrice))
                            {
                                <small class="text-muted text-decoration-line-through me-1" style="font-size:0.75rem;">฿@room.OldPrice</small>
                            }
                            <strong class="text-primary" style="font-size:1rem;">฿@room.Price</strong>
                        </div>
                    </div>

                    <div class="d-flex gap-2 pt-1">
                        @if (room.Status == "ว่าง")
                        {
                            <a asp-controller="Customer" asp-action="BookRoom" asp-route-id="@room.Id"
                               class="btn btn-primary flex-fill btn-sm fw-semibold"
                               style="background:linear-gradient(135deg,#2563eb,#1d4ed8); border:none; border-radius:8px; padding:0.45rem 0.5rem;">
                                จองห้องนี้
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary flex-fill btn-sm" disabled style="border-radius:8px;">
                                เต็มแล้ว
                            </button>
                        }
                        <a asp-controller="Customer" asp-action="RoomDetail" asp-route-id="@room.Id"
                           class="btn btn-outline-secondary flex-fill btn-sm" style="border-radius:8px;">
                            รายละเอียด
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
let activeSize = 'all';

function selectSizeFilter(size, btn) {
    activeSize = size;
    document.querySelectorAll('.size-filter-btn').forEach(b => {
        b.classList.remove('btn-primary', 'active');
        b.classList.add('btn-outline-secondary');
    });
    btn.classList.remove('btn-outline-secondary');
    btn.classList.add('btn-primary', 'active');
    document.getElementById('filterSizeSelect').value = size;
    applyFilters();
}

function onSelectChanged() {
    activeSize = document.getElementById('filterSizeSelect').value;
    document.querySelectorAll('.size-filter-btn').forEach(b => {
        b.classList.remove('btn-primary', 'active');
        b.classList.add('btn-outline-secondary');
    });
    applyFilters();
}

function applyFilters() {
    const size = activeSize;
    const price = document.getElementById('filterPriceSelect').value;
    const cards = document.querySelectorAll('.customer-room-card');

    cards.forEach(card => {
        const itemSize = card.getAttribute('data-size');
        const itemPrice = parseInt(card.getAttribute('data-price'));

        let matchSize = (size === 'all' || itemSize === size);
        let matchPrice = true;
        if (price === 'under20k') matchPrice = itemPrice < 20000;
        else if (price === '20k-50k') matchPrice = itemPrice >= 20000 && itemPrice <= 50000;
        else if (price === '50k-100k') matchPrice = itemPrice > 50000 && itemPrice <= 100000;
        else if (price === 'over100k') matchPrice = itemPrice > 100000;

        if (matchSize && matchPrice) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });
}

// Check URL query parameters (e.g. ?size=s)
window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const sizeParam = urlParams.get('size');
    if (sizeParam) {
        const select = document.getElementById('filterSizeSelect');
        if (select) {
            select.value = sizeParam;
            activeSize = sizeParam;
            // update pills
            document.querySelectorAll('.size-filter-btn').forEach(b => {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-outline-secondary');
            });
            applyFilters();
        }
    }
});
</script>
}
