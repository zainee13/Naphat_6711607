@model List<Naphat_6507_L005.ViewModels.RoomViewModel>
@{
    ViewData["Title"] = "ค้นหาห้องคลังสินค้า";
    Layout = "_PublicLayout";

    var rooms = Model;
    var freeCount = rooms.Count(r => r.Free);

    // รายการการ์ด (กรองตามงบและเรียงแล้ว) ส่งมาจาก CustomerController.Search
    var roomList = (List<Naphat_6507_L005.ViewModels.RoomViewModel>)ViewBag.RoomList;
    var priceText = ViewBag.PriceText as string;

    var detailUrl = Url.Action("RoomDetail", "Customer");
    var bookUrl = Url.Action("BookRoom", "Customer");
    var promoCode = ViewBag.Promo as string;   // โค้ดที่กดมาจากหน้าหลัก (ถ้ามี)
    var promoQuery = promoCode == null ? "" : "?promo=" + Uri.EscapeDataString(promoCode);
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}

<div class="sr cu">

    <!-- หัวข้อ -->
    <header class="cu-head">
        <h1>ค้นหาห้องคลังสินค้า</h1>
        @if (promoCode != null)
        {
            <p class="sr-promo-note"><span class="material-symbols-outlined" aria-hidden="true">sell</span> ใช้โค้ด <strong>@promoCode</strong> อยู่ เลือกห้องแล้วกดจอง ระบบจะกรอกโค้ดให้</p>
        }
        <p>ว่าง <strong>@freeCount</strong> จาก @rooms.Count ห้อง กดห้องบนผังเพื่อดูรายละเอียดและจอง</p>
    </header>

    <!-- ผังคลังสินค้า: กดห้องแล้วมีป๊อปอัปรายละเอียดเด้งขึ้นในกรอบผัง -->
    <div class="fp-plan-wrap" id="planWrap">
        <div class="fp-plan-top">
            <span><span class="material-symbols-outlined">explore</span> ผังคลังสินค้า LogiManage</span>
            <span class="fp-plan-hint">ชี้หรือกดห้องเพื่อดูรายละเอียด</span>
        </div>

        <div class="fp-plan" role="group" aria-label="ผังห้องคลังสินค้า">
            @foreach (var room in rooms)
            {
                var order = rooms.IndexOf(room);   // ลำดับห้อง ใช้หน่วงเวลาให้ห้องค่อยๆ เด้งขึ้นทีละห้อง
                var takenClass = room.Free ? "" : "is-taken";
                var statusText = room.Free ? "ว่าง" : "มีผู้เช่าแล้ว";
                // ไอคอนตามประเภทห้อง (Material Symbols)
                var icon = room.Kind switch
                {
                    "s" => "inventory_2",
                    "m" => "shelves",
                    "l" => "local_shipping",
                    "xl" => "warehouse",
                    "cold" => "ac_unit",
                    _ => "inventory_2"
                };

                <button type="button"
                        class="fp-unit fp-unit--@room.Kind @takenClass"
                        style="grid-area:@room.Grid; --i:@order;"
                        aria-label="ห้อง @room.Id @room.Area ตารางเมตร @statusText"
                        data-id="@room.Id"
                        data-free="@(room.Free ? "1" : "0")"
                        data-kind="@room.Kind"
                        data-icon="@icon"
                        data-area="@room.Area"
                        data-ceil="@room.Height"
                        data-truck="@room.Vehicle"
                        data-power="@room.Power"
                        data-price="@room.Price.ToString("N0")"
                        data-zone="@room.Zone"
                        data-note="@room.Note"
                        data-img="@(room.Img)?w=480&q=70">
                    <span class="fp-unit-photo" style="background-image:url('@(room.Img)?w=400&q=60')" aria-hidden="true"></span>
                    <span class="fp-unit-top">
                        <span class="fp-unit-code">@room.Id</span>
                        @if (room.Free)
                        {
                            <i class="fp-dot" aria-hidden="true"></i>
                        }
                        else
                        {
                            <span class="material-symbols-outlined fp-lock" aria-hidden="true">lock</span>
                        }
                    </span>
                    <span class="fp-unit-bottom">
                        <span class="fp-unit-area">@room.Area ตร.ม.</span>
                        <span class="fp-unit-price">฿@room.Price.ToString("N0")</span>
                    </span>
                </button>
            }

            <!-- ทางเดินรถกลางคลัง -->
            <div class="fp-aisle" style="grid-area:4 / 6 / 5 / 13;" aria-hidden="true">
                <span class="material-symbols-outlined">local_shipping</span>
                <span>ทางเดินรถ / ลานโหลดสินค้า</span>
                <span class="material-symbols-outlined">arrow_forward</span>
            </div>
        </div>

        <!-- ถนนหน้าคลัง + ประตูทางเข้า -->
        <div class="fp-road" aria-hidden="true">
            <span class="fp-gate"><span class="material-symbols-outlined">door_sliding</span> ประตูทางเข้า</span>
            <span class="fp-road-line"></span>
            <span class="fp-gate"><span class="material-symbols-outlined">security</span> ป้อมยาม 24 ชม.</span>
        </div>

        <ul class="fp-legend">
            <li><i class="fp-dot"></i>ว่าง</li>
            <li><i class="fp-sw fp-sw--cold"></i>ห้องเย็น</li>
            <li><span class="material-symbols-outlined fp-lock">lock</span>มีผู้เช่าแล้ว</li>
        </ul>

        <!-- ป๊อปอัปรายละเอียดห้อง (อยู่ในกรอบผัง JS ย้ายไปวางข้างห้องที่กด) -->
        <div class="fp-pop" id="roomPop" role="dialog" aria-labelledby="popId" hidden>
            <button type="button" class="fp-pop-close" id="popClose" aria-label="ปิด">
                <span class="material-symbols-outlined">close</span>
            </button>
            <div class="fp-pop-img"><img id="popImg" src="" alt="" /></div>
            <div class="fp-pop-body">
                <div class="fp-pop-head">
                    <span class="material-symbols-outlined" id="popIcon">inventory_2</span>
                    <strong id="popId">-</strong>
                    <span class="cu-status" id="popStatus">ว่าง</span>
                </div>
                <p class="fp-pop-zone"><span id="popZone"></span>, <span id="popNote"></span></p>
                <dl class="fp-spec">
                    <div><dt>พื้นที่</dt><dd><span id="popArea"></span> ตร.ม.</dd></div>
                    <div><dt>เพดานสูง</dt><dd id="popCeil"></dd></div>
                    <div><dt>รถที่เข้าได้</dt><dd id="popTruck"></dd></div>
                    <div><dt>ไฟฟ้า</dt><dd id="popPower"></dd></div>
                </dl>
                <div class="fp-price">
                    <span>ค่าเช่า</span>
                    <strong>฿<span id="popPrice"></span></strong>
                    <span>ต่อเดือน</span>
                </div>
                <p class="fp-taken-note" id="popTakenNote" hidden>ห้องนี้มีผู้เช่าหรือถูกจองแล้ว แต่จองช่วงเวลาถัดไปได้</p>
                <div class="fp-actions">
                    <a class="cu-btn cu-btn--primary" id="popBook" href="#">จองห้องนี้</a>
                    <a class="cu-btn" id="popDetail" href="#">ดูสเปกห้อง</a>
                </div>
            </div>
        </div>
    </div>

    <!-- รายการห้องทั้งหมด -->
    <section class="sr-list" aria-labelledby="roomListTitle">
        <h2 id="roomListTitle">@(priceText == null ? "ห้องทั้งหมด" : "ห้องงบ " + priceText + " (" + roomList.Count + " ห้อง)")</h2>
        @if (priceText != null)
        {
            <p class="cu-sub"><a asp-controller="Customer" asp-action="Search">ดูทุกห้อง</a></p>
        }
        @if (roomList.Count == 0)
        {
            <p class="cu-sub">ไม่มีห้องในช่วงงบนี้</p>
        }

        <ul class="sr-grid">
            @foreach (var room in roomList)
            {
                <li class="sr-card @(room.Free ? "" : "is-taken")">
                    <div class="sr-card-img">
                        <img src="@(room.Img)?w=600&q=80" alt="" loading="lazy" />
                        @if (!room.Free)
                        {
                            <span class="sr-card-flag">มีผู้เช่าแล้ว</span>
                        }
                    </div>

                    <div class="sr-card-body">
                        <div class="sr-card-top">
                            <h3><a href="@detailUrl/@room.Id">@room.Id</a></h3>
                            @if (room.Rating != null)
                            {
                                <span class="sr-rating" aria-label="คะแนน @room.Rating จาก 5">★ @room.Rating</span>
                            }
                        </div>
                        <p class="sr-card-spec">@room.Area ตร.ม., เพดาน @room.Height</p>
                        <p class="sr-card-zone">@room.Zone, @room.Note</p>
                        <p class="sr-card-price">
                            <strong>฿@room.Price.ToString("N0")</strong> ต่อเดือน
                            @if (room.OldPrice > 0)
                            {
                                <s>฿@room.OldPrice.ToString("N0")</s>
                            }
                        </p>
                    </div>
                </li>
            }
        </ul>
    </section>
</div>

@section Scripts {
<script>
    // JS ใช้แค่เปิด/ปิดป๊อปอัป ข้อมูลห้องทั้งหมดมาจาก Controller (ฝังไว้ใน data-* ของปุ่มห้อง)
    const detailUrl = '@detailUrl';
    const bookUrl = '@bookUrl';
    const promoQuery = '@promoQuery';   // ?promo=โค้ด (ถ้ามาจากการ์ดโปรโมชั่น)
    const planWrap = document.getElementById('planWrap');
    const pop = document.getElementById('roomPop');
    const roomButtons = document.querySelectorAll('.fp-unit');
    let currentButton = null;

    function setText(id, text) {
        document.getElementById(id).textContent = text;
    }

    // เปิดป๊อปอัปของห้องที่กด
    function openRoom(button) {
        roomButtons.forEach(function (item) {
            item.classList.toggle('is-selected', item === button);
        });
        currentButton = button;

        const room = button.dataset;
        const isFree = (room.free === '1');

        setText('popId', room.id);
        setText('popIcon', room.icon);
        setText('popZone', room.zone);
        setText('popNote', room.note);
        setText('popArea', room.area);
        setText('popCeil', room.ceil);
        setText('popTruck', room.truck);
        setText('popPower', room.power);
        setText('popPrice', room.price);
        document.getElementById('popImg').src = room.img;

        const status = document.getElementById('popStatus');
        if (!isFree) {
            status.textContent = 'มีผู้เช่าแล้ว';
        } else if (room.kind === 'cold') {
            status.textContent = 'ว่าง ห้องเย็น';
        } else {
            status.textContent = 'ว่าง พร้อมส่งมอบ';
        }
        status.classList.toggle('is-taken', !isFree);
        pop.classList.toggle('is-taken', !isFree);

        // ห้องว่าง = ปุ่มจอง / ห้องไม่ว่าง = ดูช่วงที่ว่าง
        document.getElementById('popTakenNote').hidden = isFree;
        document.getElementById('popBook').hidden = !isFree;
        document.getElementById('popBook').href = bookUrl + '/' + room.id + promoQuery;
        const detail = document.getElementById('popDetail');
        detail.href = detailUrl + '/' + room.id;
        detail.textContent = isFree ? 'ดูสเปกห้อง' : 'ดูช่วงที่ว่าง';

        pop.hidden = false;
        placePopup(button);
    }

    // วางป๊อปอัปข้างห้องที่กด แต่ไม่ให้ล้นออกนอกกรอบผัง
    function placePopup(button) {
        const wrapBox = planWrap.getBoundingClientRect();
        const roomBox = button.getBoundingClientRect();
        const gap = 10;

        // จอเล็ก: ป๊อปอัปเต็มความกว้างกรอบผัง ใต้ห้องที่กด
        if (wrapBox.width < 640) {
            let topSmall = roomBox.bottom - wrapBox.top + gap;
            if (topSmall + pop.offsetHeight > wrapBox.height - gap) {
                topSmall = Math.max(gap, wrapBox.height - pop.offsetHeight - gap);
            }
            pop.style.left = gap + 'px';
            pop.style.top = topSmall + 'px';
            return;
        }

        // ลองวางขวาของห้องก่อน ถ้าไม่พอค่อยวางซ้าย
        let left = roomBox.right - wrapBox.left + gap;
        if (left + pop.offsetWidth > wrapBox.width - gap) {
            left = roomBox.left - wrapBox.left - pop.offsetWidth - gap;
        }
        if (left < gap) {
            left = gap;
        }

        let top = roomBox.top - wrapBox.top;
        if (top + pop.offsetHeight > wrapBox.height - gap) {
            top = wrapBox.height - pop.offsetHeight - gap;
        }
        if (top < gap) {
            top = gap;
        }

        pop.style.left = left + 'px';
        pop.style.top = top + 'px';
    }

    function closeRoom() {
        pop.hidden = true;
        roomButtons.forEach(function (item) {
            item.classList.remove('is-selected');
        });
        currentButton = null;
    }

    roomButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            if (currentButton === button && !pop.hidden) {
                closeRoom();
            } else {
                openRoom(button);
            }
        });
    });

    document.getElementById('popClose').addEventListener('click', closeRoom);

    // แสงไฟส่องตามเมาส์บนห้อง (แค่ลูกเล่นหน้าตา)
    roomButtons.forEach(function (button) {
        button.addEventListener('mousemove', function (e) {
            const box = button.getBoundingClientRect();
            button.style.setProperty('--mx', (e.clientX - box.left) + 'px');
            button.style.setProperty('--my', (e.clientY - box.top) + 'px');
        });
    });

    // กด Esc หรือกดที่อื่นนอกป๊อปอัป = ปิด
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !pop.hidden) {
            closeRoom();
        }
    });
    document.addEventListener('click', function (e) {
        if (!pop.hidden && !pop.contains(e.target) && !e.target.closest('.fp-unit')) {
            closeRoom();
        }
    });
    window.addEventListener('resize', function () {
        if (!pop.hidden && currentButton) {
            placePopup(currentButton);
        }
    });

    // ถ้ามาจากฟอร์มค้นหาหน้าหลัก (เช่น ?size=s) ให้เปิดห้องว่างห้องแรกของขนาดนั้น
    const size = new URLSearchParams(window.location.search).get('size');
    if (size && size !== 'all') {
        const match = document.querySelector('.fp-unit[data-kind="' + size + '"][data-free="1"]');
        if (match) {
            openRoom(match);
        }
    }
</script>
}
