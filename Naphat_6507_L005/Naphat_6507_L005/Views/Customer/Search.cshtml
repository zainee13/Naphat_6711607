@{
    ViewData["Title"] = "ค้นหาห้องคลังสินค้า";
    Layout = "_Layout";

    // ห้องทั้งหมด ใช้ทั้งผังคลังและรายการการ์ดด้านล่าง
    // (ตอนต่อฐานข้อมูล ให้แทนที่ array นี้ด้วยข้อมูลจากตาราง Rooms; Grid คือตำแหน่งบนผัง 12 คอลัมน์ x 6 แถว)
    var rooms = new[] {
        new { Id="XL-01", Kind="xl",   Free=true,  Area="1,200", Ceil="12 ม.", Truck="คอนเทนเนอร์ทุกขนาด", Power="หม้อแปลงแยก", Price="180,000", Zone="โซน D1 (เมกะ)",          Note="คลังโล่งขนาดใหญ่พิเศษ",                    PriceVal=180000, OldPrice="210,000", Rating="5.0", Img="https://images.unsplash.com/photo-1494412685616-a5d310fbb07d?w=600&q=80", Grid="1 / 1 / 6 / 6" },
        new { Id="L-01",  Kind="l",    Free=true,  Area="500",   Ceil="10 ม.", Truck="18 ล้อ / ตู้ 40ft",   Power="3 เฟส 380V",   Price="75,000",  Zone="โซน C1 (มี Dock)",        Note="มี Dock Leveler เทียบตู้คอนเทนเนอร์",       PriceVal=75000, OldPrice="85,000", Rating="4.6", Img="https://images.unsplash.com/photo-1553413077-190dd305871c?w=600&q=80", Grid="1 / 6 / 4 / 10" },
        new { Id="L-02",  Kind="l",    Free=false, Area="350",   Ceil="10 ม.", Truck="10 ล้อ / เทรลเลอร์", Power="3 เฟส 380V",   Price="55,000",  Zone="โซน C2 (สินค้าปลอดภัย)", Note="ควบคุมการเข้าออกเฉพาะบุคคล",              PriceVal=55000, OldPrice="", Rating="4.5", Img="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=600&q=80", Grid="1 / 10 / 4 / 13" },
        new { Id="M-02",  Kind="m",    Free=true,  Area="250",   Ceil="8 ม.",  Truck="10 ล้อ",             Power="3 เฟส 380V",   Price="38,000",  Zone="โซน B2 (พาเลท)",         Note="Racking 3 ชั้น วางได้ 120 พาเลท",           PriceVal=38000, OldPrice="", Rating="4.8", Img="https://images.unsplash.com/photo-1553413077-190dd305871c?w=600&q=80", Grid="4 / 6 / 7 / 9" },
        new { Id="M-01",  Kind="m",    Free=true,  Area="150",   Ceil="8 ม.",  Truck="6 ล้อ / 10 ล้อ",     Power="3 เฟส 380V",   Price="25,000",  Zone="โซน B1 (มาตรฐาน)",       Note="พื้นอีพ็อกซี่รับน้ำหนัก 3 ตัน/ตร.ม.",       PriceVal=25000, OldPrice="29,000", Rating="4.8", Img="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&q=80", Grid="4 / 9 / 7 / 11" },
        new { Id="CR-05", Kind="cold", Free=true,  Area="200",   Ceil="7 ม.",  Truck="10 ล้อตู้เย็น",      Power="ไฟสำรองคู่",    Price="40,000",  Zone="โซน Cold Chain",          Note="ควบคุม −18°C ถึง +5°C ดูอุณหภูมิผ่านมือถือ", PriceVal=40000, OldPrice="48,000", Rating="4.9", Img="https://images.unsplash.com/photo-1553413077-190dd305871c?w=600&q=80", Grid="4 / 11 / 7 / 13" },
        new { Id="S-01",  Kind="s",    Free=true,  Area="60",    Ceil="6 ม.",  Truck="กระบะ / 4 ล้อ",      Power="220V",         Price="12,000",  Zone="โซน A1 (ชั้น 1)",         Note="ชั้น 1 เข้าถึงง่าย",                       PriceVal=12000, OldPrice="", Rating="4.7", Img="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&q=80", Grid="6 / 1 / 7 / 3" },
        new { Id="S-02",  Kind="s",    Free=true,  Area="80",    Ceil="6 ม.",  Truck="กระบะ / 4 ล้อ",      Power="220V / 380V",  Price="15,000",  Zone="โซน A2 (SME)",            Note="ประตูม้วนไฟฟ้า",                           PriceVal=15000, OldPrice="18,000", Rating="4.3", Img="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=600&q=80", Grid="6 / 3 / 7 / 6" },
    };
    var freeCount = rooms.Count(r => r.Free);
    var first = rooms.First(r => r.Id == "M-01");
    var detailBase = Url.Action("RoomDetail", "Customer");
    var bookBase = Url.Action("BookRoom", "Customer");
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}

<div class="sr cu">

    <header class="cu-head">
        <h1>ค้นหาห้องคลังสินค้า</h1>
        <p>ว่าง <strong>@freeCount</strong> จาก @rooms.Length ห้อง แตะห้องบนผังเพื่อดูรายละเอียดและจอง ราคายังไม่รวม VAT</p>
    </header>

    <div class="fp-board">
        <div class="fp-plan-wrap">
            <div class="fp-plan" role="group" aria-label="ผังห้องคลังสินค้า">
                @foreach (var r in rooms)
                {
                    <button type="button"
                            class="fp-unit fp-unit--@r.Kind @(r.Free ? "" : "is-taken") @(r.Id == first.Id ? "is-selected" : "")"
                            style="grid-area:@r.Grid;"
                            aria-pressed="@(r.Id == first.Id ? "true" : "false")"
                            aria-label="ห้อง @r.Id @r.Area ตารางเมตร @(r.Free ? "ว่าง" : "มีผู้เช่าแล้ว")"
                            data-id="@r.Id" data-free="@(r.Free ? "1" : "0")" data-kind="@r.Kind"
                            data-area="@r.Area" data-ceil="@r.Ceil" data-truck="@r.Truck" data-power="@r.Power"
                            data-price="@r.Price" data-zone="@r.Zone" data-note="@r.Note">
                        <span class="fp-unit-code">@r.Id</span>
                        <span class="fp-unit-area">@r.Area ตร.ม.</span>
                    </button>
                }
            </div>
            <ul class="fp-legend">
                <li><i class="fp-sw"></i>ว่าง</li>
                <li><i class="fp-sw fp-sw--cold"></i>ห้องเย็น (ว่าง)</li>
                <li><i class="fp-sw fp-sw--taken"></i>มีผู้เช่าแล้ว</li>
            </ul>
        </div>

        <aside class="fp-detail" aria-live="polite" id="fp-detail" data-detail-base="@detailBase" data-book-base="@bookBase">
            <div class="fp-detail-head">
                <div class="fp-detail-code" data-f="id">@first.Id</div>
                <span class="cu-status" data-f="status">ว่าง พร้อมส่งมอบ</span>
            </div>
            <p class="fp-detail-zone"><span data-f="zone">@first.Zone</span>, <span data-f="note">@first.Note</span></p>
            <dl class="fp-spec">
                <div><dt>พื้นที่</dt><dd><span data-f="area">@first.Area</span> ตร.ม.</dd></div>
                <div><dt>เพดานสูง</dt><dd data-f="ceil">@first.Ceil</dd></div>
                <div><dt>รถที่เข้าได้</dt><dd data-f="truck">@first.Truck</dd></div>
                <div><dt>ไฟฟ้า</dt><dd data-f="power">@first.Power</dd></div>
            </dl>
            <div class="fp-price">
                <span>ค่าเช่า</span>
                <strong>฿<span data-f="price">@first.Price</span></strong>
                <span>ต่อเดือน</span>
            </div>
            <div class="fp-actions" data-f="actions-free">
                <a class="cu-btn cu-btn--primary" data-f="book" href="@bookBase/@first.Id">จองห้องนี้</a>
                <a class="cu-btn" data-f="detail" href="@detailBase/@first.Id">ดูสเปกห้อง</a>
            </div>
            <div class="fp-actions" data-f="actions-taken" hidden>
                <p class="fp-taken-note">ห้องนี้มีผู้เช่าแล้ว เลือกห้องอื่นบนผังได้เลย</p>
            </div>
        </aside>
    </div>

    <!-- รายการห้องทั้งหมด -->
    <section class="sr-list" aria-labelledby="sr-list-title">
        <h2 id="sr-list-title">ห้องทั้งหมด</h2>
        <ul class="sr-grid">
            @foreach (var r in rooms.OrderBy(r => r.Free ? 0 : 1).ThenBy(r => r.PriceVal))
            {
                <li class="sr-card @(r.Free ? "" : "is-taken")">
                    <div class="sr-card-img">
                        <img src="@r.Img" alt="" loading="lazy" />
                        @if (!r.Free) { <span class="sr-card-flag">มีผู้เช่าแล้ว</span> }
                    </div>
                    <div class="sr-card-body">
                        <div class="sr-card-top">
                            <h3><a href="@detailBase/@r.Id">@r.Id</a></h3>
                            <span class="sr-rating" aria-label="คะแนน @r.Rating จาก 5">★ @r.Rating</span>
                        </div>
                        <p class="sr-card-spec">@r.Area ตร.ม., เพดาน @r.Ceil</p>
                        <p class="sr-card-zone">@r.Zone, @r.Note</p>
                        <p class="sr-card-price">
                            <strong>฿@r.Price</strong> ต่อเดือน
                            @if (r.OldPrice != "") { <s>฿@r.OldPrice</s> }
                        </p>
                    </div>
                </li>
            }
        </ul>
    </section>
</div>

@section Scripts {
<script>
(function () {
    const detail = document.getElementById('fp-detail');
    const units = document.querySelectorAll('.fp-unit');
    const f = name => detail.querySelector('[data-f="' + name + '"]');

    function select(btn) {
        units.forEach(u => {
            const on = u === btn;
            u.classList.toggle('is-selected', on);
            u.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        const d = btn.dataset, free = d.free === '1';
        ['id', 'zone', 'note', 'area', 'ceil', 'truck', 'power', 'price'].forEach(k => f(k).textContent = d[k]);
        const status = f('status');
        status.textContent = free ? (d.kind === 'cold' ? 'ว่าง ห้องเย็น' : 'ว่าง พร้อมส่งมอบ') : 'มีผู้เช่าแล้ว';
        status.classList.toggle('is-taken', !free);
        detail.classList.toggle('is-taken', !free);
        f('actions-free').hidden = !free;
        f('actions-taken').hidden = free;
        f('book').href = detail.dataset.bookBase + '/' + d.id;
        f('detail').href = detail.dataset.detailBase + '/' + d.id;
    }
    units.forEach(u => u.addEventListener('click', () => select(u)));

    // มาจากฟอร์มค้นหาหน้าหลัก (?size=s): เลือกห้องว่างห้องแรกของขนาดนั้นให้เลย
    const size = new URLSearchParams(location.search).get('size');
    if (size && size !== 'all') {
        const match = document.querySelector('.fp-unit[data-kind="' + size + '"][data-free="1"]');
        if (match) select(match);
    }
})();
</script>
}
