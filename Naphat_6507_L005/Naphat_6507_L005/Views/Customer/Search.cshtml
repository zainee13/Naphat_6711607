@{
    ViewData["Title"] = "ค้นหาสินค้าและคลังสินค้า";
    Layout = "_Layout";
}

<div class="page-header mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color:#1e293b;">
                <span class="material-symbols-outlined align-middle me-2 text-primary" style="font-size:1.8rem;">warehouse</span>
                ค้นหาและจองห้องคลังสินค้า
            </h1>
            <p class="text-secondary mb-0" style="font-size:0.9rem;">
                เลือกพื้นที่จัดเก็บที่ตรงกับขนาดและธุรกิจของคุณ พร้อมจองได้ทันที
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:600; padding:0.5rem 0.9rem; border-radius:30px; font-size:0.85rem;">
                <span class="material-symbols-outlined align-middle me-1" style="font-size:1rem;">check_circle</span>
                ว่าง 8 ยูนิตพร้อมให้บริการ
            </span>
            <a asp-controller="Customer" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" style="border-radius:8px;">
                <span class="material-symbols-outlined" style="font-size:1rem;">local_offer</span>
                ดูโปรโมชั่น
            </a>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-body p-4">
        <form method="get" onsubmit="return false;">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">location_on</span>
                        ทำเลที่ตั้ง
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><span class="material-symbols-outlined" style="font-size:1.1rem; color:#64748b;">map</span></span>
                        <select class="form-select border-start-0 ps-0" id="filterLocation" style="border-radius:0 8px 8px 0;">
                            <option value="">ทุกทำเล</option>
                            <option value="บางนา">บางนา กม.19</option>
                            <option value="วังน้อย">วังน้อย (อยุธยา)</option>
                            <option value="แหลมฉบัง">แหลมฉบัง (ชลบุรี)</option>
                            <option value="ลาดกระบัง">ลาดกระบัง (สุวรรณภูมิ)</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">square_foot</span>
                        ขนาดพื้นที่
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><span class="material-symbols-outlined" style="font-size:1.1rem; color:#64748b;">aspect_ratio</span></span>
                        <select class="form-select border-start-0 ps-0" id="filterSize" style="border-radius:0 8px 8px 0;">
                            <option value="">ทุกขนาด</option>
                            <option value="s">50 - 100 ตร.ม. (ขนาดเล็ก)</option>
                            <option value="m">101 - 300 ตร.ม. (ขนาดกลาง)</option>
                            <option value="l">301 - 500 ตร.ม. (ขนาดใหญ่)</option>
                            <option value="xl">500+ ตร.ม. (เมกะแวร์เฮ้าส์)</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">payments</span>
                        งบประมาณ / เดือน
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><span class="material-symbols-outlined" style="font-size:1.1rem; color:#64748b;">attach_money</span></span>
                        <select class="form-select border-start-0 ps-0" id="filterPrice" style="border-radius:0 8px 8px 0;">
                            <option value="">ทุกช่วงราคา</option>
                            <option value="under20k">ต่ำกว่า 20,000 บาท</option>
                            <option value="20k-50k">20,000 - 50,000 บาท</option>
                            <option value="50k-100k">50,000 - 100,000 บาท</option>
                            <option value="over100k">100,000 บาทขึ้นไป</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <button type="button" class="btn btn-primary w-100 d-flex justify-content-center align-items-center gap-2"
                            style="background: linear-gradient(135deg,#2563eb,#1d4ed8); border:none; border-radius:8px; height:34px; font-weight:600; font-size:0.875rem;">
                        <span class="material-symbols-outlined" style="font-size:1.1rem;">search</span>
                        ค้นหาห้องว่าง
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Special Promotion Banner Notice in Search -->
<div class="alert border-0 shadow-sm d-flex align-items-center justify-content-between mb-4"
     style="background: linear-gradient(90deg, #eff6ff 0%, #f0fdf4 100%); border-left: 4px solid #3b82f6 !important; border-radius: 12px; padding: 1rem 1.25rem;">
    <div class="d-flex align-items-center gap-3">
        <span class="material-symbols-outlined text-primary" style="font-size: 2rem;">campaign</span>
        <div>
            <strong style="color: #1e3a8a; font-size: 0.95rem;">มีโปรโมชั่นพิเศษเดือนนี้!</strong>
            <p class="mb-0 text-muted" style="font-size: 0.85rem;">จองคลังสินค้าห้องที่มีป้าย <span class="badge bg-danger">PROMO</span> รับส่วนลดสูงสุด 25% ทันที</p>
        </div>
    </div>
    <a asp-controller="Customer" asp-action="Dashboard" class="btn btn-sm btn-outline-primary" style="border-radius: 8px; font-size: 0.82rem; white-space: nowrap;">
        ดูแคมเปญโปรโมชั่นทั้งหมด &rarr;
    </a>
</div>

<!-- Room Cards -->
<div class="row g-4">
    @foreach (var room in new[] {
        new { Id="BN-A01", Name="BN-A01 (บางนา)", Desc="โกดังมาตรฐาน พื้นอีพ็อกซี่ ใกล้ทางด่วนบางนา-ตราด", Size="150", Price="25,000", OldPrice="29,000", Promo="ลด 14%", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&q=80", Rating="4.8", Reviews="12", Location="บางนา" },
        new { Id="WN-B12", Name="WN-B12 (วังน้อย)", Desc="คลังสินค้าขนาดใหญ่ รองรับรถพ่วง 18 ล้อ พร้อม Dock Leveler", Size="500", Price="75,000", OldPrice="85,000", Promo="ลด 12%", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1553413077-190dd305871c?w=600&q=80", Rating="4.6", Reviews="8", Location="วังน้อย" },
        new { Id="LC-C05", Name="LC-C05 (แหลมฉบัง)", Desc="ห้องเย็นควบคุมอุณหภูมิ -18 ถึง +5°C ใกล้ท่าเรือแหลมฉบัง", Size="200", Price="40,000", OldPrice="48,000", Promo="HOT DEAL", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1566576912321-d58ddd7a6088?w=600&q=80", Rating="4.9", Reviews="21", Location="แหลมฉบัง" },
        new { Id="LK-D03", Name="LK-D03 (ลาดกระบัง)", Desc="ใกล้สนามบินสุวรรณภูมิ พื้นที่รองรับสินค้าปลอดภัยสูง", Size="350", Price="55,000", OldPrice="", Promo="", Status="ไม่ว่าง", StatusClass="badge-occupied",
              Img="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=600&q=80", Rating="4.5", Reviews="6", Location="ลาดกระบัง" },
        new { Id="BN-A07", Name="BN-A07 (บางนา)", Desc="คลังขนาดกะทัดรัด ระบบรักษาความปลอดภัย 24 ชม. เหมาะกับ SME", Size="80", Price="15,000", OldPrice="18,000", Promo="ลด 16%", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=600&q=80", Rating="4.3", Reviews="9", Location="บางนา" },
        new { Id="WN-E01", Name="WN-E01 (วังน้อย)", Desc="คลังขนาดใหญ่พิเศษ เพดานสูง 12 ม. ระบบ WMS & Cloud Monitoring", Size="1200", Price="180,000", OldPrice="210,000", Promo="FLASH DEAL", Status="ว่าง", StatusClass="badge-available",
              Img="https://images.unsplash.com/photo-1494412685616-a5d310fbb07d?w=600&q=80", Rating="5.0", Reviews="4", Location="วังน้อย" },
    })
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="room-card card border-0 shadow-sm h-100 overflow-hidden" style="border-radius:14px; transition: transform 0.2s, box-shadow 0.2s;">
                <div style="position:relative; height:190px; overflow:hidden;">
                    <img src="@room.Img" alt="@room.Name" style="width:100%; height:100%; object-fit:cover;" />
                    
                    <span class="badge @(room.Status == "ว่าง" ? "bg-success" : "bg-secondary")"
                          style="position:absolute; top:12px; left:12px; font-weight:600; padding:0.35rem 0.65rem; border-radius:6px;">
                        @(room.Status == "ว่าง" ? "● ว่างพร้อมเข้าใช้" : "● จองแล้ว")
                    </span>

                    @if (!string.IsNullOrEmpty(room.Promo))
                    {
                        <span class="badge bg-danger shadow-sm"
                              style="position:absolute; top:12px; right:12px; font-weight:700; padding:0.35rem 0.65rem; border-radius:6px;">
                            🔥 @room.Promo
                        </span>
                    }

                    <div style="position:absolute; bottom:8px; left:12px; background:rgba(0,0,0,0.65); backdrop-filter:blur(4px); color:#fff; border-radius:6px; padding:2px 8px; font-size:0.75rem;">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">location_on</span>
                        @room.Location
                    </div>
                </div>

                <div class="card-body p-3 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h2 class="h6 fw-bold mb-0" style="color:#0f172a;">@room.Name</h2>
                        <div class="text-warning fw-bold d-flex align-items-center" style="font-size:0.82rem;">
                            ★ @room.Rating
                            <span class="text-muted ms-1" style="font-size:0.75rem; font-weight:normal;">(@room.Reviews)</span>
                        </div>
                    </div>

                    <p class="text-secondary small mb-3" style="min-height:36px; line-height:1.4;">@room.Desc</p>

                    <div class="row g-2 border-top border-bottom py-2 my-auto bg-light rounded-3 px-1 mb-3">
                        <div class="col-6">
                            <span class="text-muted d-block" style="font-size:0.75rem;">พื้นที่จัดเก็บ</span>
                            <strong style="color:#1e293b; font-size:0.92rem;">@room.Size ตร.ม.</strong>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted d-block" style="font-size:0.75rem;">ราคาเช่า/เดือน</span>
                            @if (!string.IsNullOrEmpty(room.OldPrice))
                            {
                                <small class="text-muted text-decoration-line-through me-1" style="font-size:0.75rem;">฿@room.OldPrice</small>
                            }
                            <strong class="text-primary" style="font-size:1rem;">฿@room.Price</strong>
                        </div>
                    </div>

                    <div class="d-flex gap-2 pt-1">
                        @if (room.Status == "ว่าง")
                        {
                            <a asp-controller="Customer" asp-action="BookRoom" asp-route-id="@room.Id"
                               class="btn btn-primary flex-fill btn-sm fw-semibold"
                               style="background:linear-gradient(135deg,#2563eb,#1d4ed8); border:none; border-radius:8px; padding:0.45rem 0.5rem;">
                                จองห้องนี้
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary flex-fill btn-sm" disabled style="border-radius:8px;">
                                เต็มแล้ว
                            </button>
                        }
                        <a asp-controller="Customer" asp-action="RoomDetail" asp-route-id="@room.Id"
                           class="btn btn-outline-secondary flex-fill btn-sm" style="border-radius:8px;">
                            รายละเอียด
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
