@{
    var roomId = ViewBag.RoomId as string ?? "M-01";
    if (roomId == "BN-A01") roomId = "M-01";
    if (roomId == "WN-B12") roomId = "L-01";
    if (roomId == "LC-C05") roomId = "CR-05";
    if (roomId == "LK-D03") roomId = "L-02";
    if (roomId == "BN-A07") roomId = "S-02";
    if (roomId == "WN-E01") roomId = "XL-01";

    var roomDict = new Dictionary<string, (string Name, string Size, string Zone, int MonthlyRate, string Img)>
    {
        ["S-01"] = ("Unit S-01 (ไซส์ S)", "60 ตร.ม.", "โซน A1 (ชั้น 1)", 12000, "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=300&q=80"),
        ["S-02"] = ("Unit S-02 (ไซส์ S)", "80 ตร.ม.", "โซน A2 (SME)", 15000, "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=300&q=80"),
        ["M-01"] = ("Unit M-01 (ไซส์ M)", "150 ตร.ม.", "โซน B1 (มาตรฐาน)", 25000, "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=300&q=80"),
        ["M-02"] = ("Unit M-02 (ไซส์ M)", "250 ตร.ม.", "โซน B2 (พาเลท)", 38000, "https://images.unsplash.com/photo-1553413077-190dd305871c?w=300&q=80"),
        ["L-01"] = ("Unit L-01 (ไซส์ L)", "500 ตร.ม.", "โซน C1 (มี Dock)", 75000, "https://images.unsplash.com/photo-1553413077-190dd305871c?w=300&q=80"),
        ["L-02"] = ("Unit L-02 (ไซส์ L)", "350 ตร.ม.", "โซน C2 (สินค้าปลอดภัย)", 55000, "https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=300&q=80"),
        ["XL-01"] = ("Unit XL-01 (ไซส์ XL)", "1,200 ตร.ม.", "โซน D1 (เมกะ)", 180000, "https://images.unsplash.com/photo-1494412685616-a5d310fbb07d?w=300&q=80"),
        ["CR-05"] = ("Unit CR-05 (ห้องเย็น)", "200 ตร.ม.", "โซน Cold Storage", 40000, "https://images.unsplash.com/photo-1566576912321-d58ddd7a6088?w=300&q=80")
    };

    if (!roomDict.ContainsKey(roomId))
    {
        roomId = "M-01";
    }
    var room = roomDict[roomId];

    ViewData["Title"] = $"จองห้อง {room.Name}";
    Layout = "_Layout";
}

<div class="page-header">
    <a asp-controller="Customer" asp-action="RoomDetail" asp-route-id="@roomId"
       class="btn btn-sm btn-outline-secondary mb-3" style="border-radius:8px;">
        <span class="material-symbols-outlined align-middle" style="font-size:0.9rem;">arrow_back</span>
        กลับ
    </a>
    <h1><span class="material-symbols-outlined align-middle me-2 text-orange">bookmark_add</span>จองห้องคลัง — @room.Name</h1>
    <p>กรอกข้อมูลผู้เช่าและกำหนดระยะเวลาสัญญาเช่าในคลังสินค้าของเรา</p>
</div>

<div class="row g-4">

    <!-- Booking Form -->
    <div class="col-12 col-lg-8">
        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined text-orange">person</span> ข้อมูลผู้เช่า</h2>
            </div>

            <form>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">ชื่อ - นามสกุล *</label>
                        <input type="text" class="form-control" value="@ViewBag.FullName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">บริษัท / องค์กร</label>
                        <input type="text" class="form-control" placeholder="ระบุชื่อบริษัท (ถ้ามี)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">เบอร์โทรศัพท์ *</label>
                        <input type="tel" class="form-control" placeholder="0812345678" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">อีเมล *</label>
                        <input type="email" class="form-control" placeholder="example@email.com" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">เลขบัตรประชาชน / เลขทะเบียนนิติบุคคล *</label>
                        <input type="text" class="form-control" placeholder="X-XXXX-XXXXX-XX-X" />
                    </div>
                </div>
            </form>
        </div>

        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined text-orange">calendar_month</span> ช่วงเวลาเช่า</h2>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">วันที่เริ่มเช่า *</label>
                    <input type="date" class="form-control" id="bookStart" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">ระยะเวลาสัญญา *</label>
                    <select class="form-select" id="bookDuration" onchange="calcPrice()">
                        <option value="1">1 เดือน</option>
                        <option value="3">3 เดือน</option>
                        <option value="6" selected>6 เดือน</option>
                        <option value="12">12 เดือน (ฟรีเดือนที่ 12)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">วันสิ้นสุด (คำนวณอัตโนมัติ)</label>
                    <input type="date" class="form-control" id="bookEnd" readonly style="background:#f9fafb;" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">ประเภทสินค้าที่จะจัดเก็บ</label>
                    <select class="form-select">
                        <option>สินค้าอุปโภคบริโภคทั่วไป</option>
                        <option>สินค้าอาหารและเครื่องดื่ม</option>
                        <option>สินค้าอุตสาหกรรม / อะไหล่</option>
                        <option>สินค้าอิเล็กทรอนิกส์และไอที</option>
                        <option>เวชภัณฑ์และเคมีภัณฑ์ทั่วไป</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">ความต้องการเพิ่มเติม</label>
                    <textarea class="form-control" rows="3"
                              placeholder="เช่น ขอใช้บริการรถโฟล์กลิฟต์ในวันย้ายเข้า, ขอติดตั้งระบบเซ็นเซอร์อุณหภูมิเพิ่มเติม ฯลฯ"></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Panel -->
    <div class="col-12 col-lg-4">
        <div class="section-card" style="position:sticky; top:80px;">
            <h3 class="h6 fw-bold mb-3" style="color:#14213d;">
                <span class="material-symbols-outlined align-middle text-orange" style="font-size:1rem;">receipt</span>
                สรุปการจองห้อง
            </h3>

            <div style="background:#f8f9fa; border-radius:10px; padding:1rem; margin-bottom:1rem;">
                <div class="d-flex gap-3 mb-2">
                    <img src="@room.Img"
                         style="width:60px; height:50px; object-fit:cover; border-radius:8px; flex-shrink:0;" alt="@room.Name" />
                    <div>
                        <div class="fw-semibold" style="font-size:0.875rem; color:#14213d;">@room.Name</div>
                        <div style="font-size:0.78rem; color:#6c757d;">@room.Zone • @room.Size</div>
                        <span class="badge-status badge-available" style="font-size:0.7rem;">ว่างพร้อมทำสัญญา</span>
                    </div>
                </div>
            </div>

            <div class="mb-1 d-flex justify-content-between" style="font-size:0.85rem;">
                <span class="text-secondary">ค่าเช่า / เดือน</span>
                <span>฿@room.MonthlyRate.ToString("N0")</span>
            </div>
            <div class="mb-1 d-flex justify-content-between" style="font-size:0.85rem;">
                <span class="text-secondary">ระยะเวลา</span>
                <span id="summaryDuration">6 เดือน</span>
            </div>
            <div class="mb-1 d-flex justify-content-between" style="font-size:0.85rem;">
                <span class="text-secondary">ค่าเช่ารวม</span>
                <span id="summaryRent">฿@((room.MonthlyRate * 6).ToString("N0"))</span>
            </div>
            <div class="mb-1 d-flex justify-content-between" style="font-size:0.85rem;">
                <span class="text-secondary">เงินประกัน (2 เดือน)</span>
                <span id="summaryDeposit">฿@((room.MonthlyRate * 2).ToString("N0"))</span>
            </div>
            <hr />
            <div class="d-flex justify-content-between fw-bold">
                <span>ยอดรวมทั้งหมด</span>
                <span class="text-orange" id="summaryTotal">฿@((room.MonthlyRate * 8).ToString("N0"))</span>
            </div>

            <div class="mt-3 p-2" style="background:#eff6ff; border-radius:8px; font-size:0.75rem; color:#1d4ed8;">
                <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">verified</span>
                คลังสินค้าของเรามีระบบสัญญาออนไลน์ พร้อมเข้าใช้พื้นที่ได้ทันทีเมื่อชำระเงิน
            </div>

            <button class="btn btn-primary w-100 mt-3"
                    onclick="submitBooking()"
                    style="background:linear-gradient(135deg,#3b82f6,#1d4ed8); border:none; border-radius:10px; padding:0.75rem; font-weight:600;">
                <span class="material-symbols-outlined align-middle me-1" style="font-size:1rem;">send</span>
                ยืนยันการจองห้อง
            </button>
        </div>
    </div>

</div>

@section Scripts {
<script>
const monthlyRate = @room.MonthlyRate;
function calcPrice() {
    const dur = parseInt(document.getElementById('bookDuration').value);
    const rent = monthlyRate * dur;
    const deposit = monthlyRate * 2;
    const total = rent + deposit;
    document.getElementById('summaryDuration').textContent = dur + ' เดือน';
    document.getElementById('summaryRent').textContent = '฿' + rent.toLocaleString();
    document.getElementById('summaryDeposit').textContent = '฿' + deposit.toLocaleString();
    document.getElementById('summaryTotal').textContent = '฿' + total.toLocaleString();
    const start = document.getElementById('bookStart').value;
    if (start) {
        const end = new Date(start);
        end.setMonth(end.getMonth() + dur);
        document.getElementById('bookEnd').value = end.toISOString().split('T')[0];
    }
}
document.getElementById('bookStart').addEventListener('change', calcPrice);
document.getElementById('bookStart').valueAsDate = new Date();
calcPrice();

function submitBooking() {
    alert('ส่งคำขอจองห้อง @room.Name เรียบร้อยแล้ว!\nระบบได้นำท่านไปยังหน้าโปรไฟล์เพื่อตรวจสอบข้อมูลการจองและชำระเงิน');
    window.location.href = '@Url.Action("Profile", "Customer", new { tab = "payment", bookingId = "BK-2026-002" })';
}
</script>
}
