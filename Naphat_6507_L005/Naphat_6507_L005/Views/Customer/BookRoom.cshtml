@model Naphat_6507_L005.ViewModels.BookingViewModel
@{
    var room = (Naphat_6507_L005.ViewModels.RoomViewModel)ViewBag.Room;
    var isCompany = Model.TenantType != "person";

    ViewData["Title"] = "จองห้อง " + room.Id;
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/book.css" asp-append-version="true" />
}

<div class="bk cu">

    <a class="cu-back" asp-controller="Customer" asp-action="RoomDetail" asp-route-id="@room.Id">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>กลับไปห้อง @room.Id
    </a>

    <!-- หัวข้อ -->
    <header class="cu-head">
        <h1>จองห้อง @room.Id</h1>
        <p>กรอกข้อมูลผู้เช่าและระยะสัญญา จากนั้นไปชำระเงิน</p>
    </header>

    <!-- ขั้นตอนการจอง -->
    <ol class="bk-steps" aria-label="ขั้นตอนการจอง">
        <li class="is-done"><span>1</span>เลือกห้อง</li>
        <li class="is-current" aria-current="step"><span>2</span>ข้อมูลการเช่า</li>
        <li><span>3</span>ชำระเงิน</li>
    </ol>

    @if (!room.Free)
    {
        <!-- ห้องมีผู้เช่าแล้ว: ไม่แสดงฟอร์ม -->
        <div class="bk-blocked">
            <p><strong>ห้อง @room.Id มีผู้เช่าแล้ว</strong> จองไม่ได้ในตอนนี้</p>
            <a class="cu-btn" asp-controller="Customer" asp-action="Search">เลือกห้องอื่นบนผัง</a>
        </div>
    }
    else
    {
        <form class="bk-layout" id="bookingForm" asp-controller="Customer" asp-action="BookRoom" method="post">
            <input type="hidden" asp-for="RoomId" />

            <div class="bk-main">

                <!-- ข้อมูลผู้เช่า -->
                <fieldset class="bk-section">
                    <legend class="cu-h2">ผู้เช่า</legend>

                    <div class="bk-type" role="radiogroup" aria-label="ประเภทผู้เช่า">
                        <label>
                            <input type="radio" asp-for="TenantType" value="corp" />
                            <span>บริษัท / นิติบุคคล</span>
                        </label>
                        <label>
                            <input type="radio" asp-for="TenantType" value="person" />
                            <span>บุคคลธรรมดา</span>
                        </label>
                    </div>

                    <div class="bk-grid">
                        <label class="cu-field bk-span-2" id="companyField" hidden="@(!isCompany)">
                            <span>ชื่อบริษัท</span>
                            <input type="text" asp-for="CompanyName" autocomplete="organization" placeholder="เช่น บจก. ไทยซัพพลาย" required="@isCompany" />
                        </label>
                        <label class="cu-field">
                            <span id="taxIdLabel">@(isCompany ? "เลขผู้เสียภาษี 13 หลัก" : "เลขบัตรประชาชน 13 หลัก")</span>
                            <input type="text" asp-for="TaxId" inputmode="numeric" pattern="\d{13}" maxlength="13" placeholder="ตัวเลข 13 หลัก ไม่ต้องมีขีด" required />
                        </label>
                        <label class="cu-field">
                            <span>ชื่อผู้ติดต่อ</span>
                            <input type="text" asp-for="ContactName" autocomplete="name" required />
                        </label>
                        <label class="cu-field">
                            <span>เบอร์โทร</span>
                            <input type="tel" asp-for="Phone" autocomplete="tel" inputmode="tel" pattern="0\d{8,9}" placeholder="0812345678" required />
                        </label>
                        <label class="cu-field">
                            <span>อีเมลรับสัญญาและใบแจ้งหนี้</span>
                            <input type="email" asp-for="Email" autocomplete="email" placeholder="name@company.com" required />
                        </label>
                        <label class="cu-field bk-span-2">
                            <span>ที่อยู่ออกใบกำกับภาษี</span>
                            <textarea asp-for="Address" rows="2" autocomplete="street-address" required></textarea>
                        </label>
                    </div>
                </fieldset>

                <!-- สัญญาเช่า -->
                <fieldset class="bk-section">
                    <legend class="cu-h2">สัญญาเช่า</legend>

                    <div class="bk-grid">
                        <label class="cu-field">
                            <span>วันเริ่มเช่า</span>
                            <input type="date" asp-for="StartDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </label>
                        <label class="cu-field">
                            <span>ระยะสัญญา</span>
                            <select asp-for="Months">
                                <option value="1">1 เดือน</option>
                                <option value="3">3 เดือน</option>
                                <option value="6">6 เดือน</option>
                                <option value="12">12 เดือน</option>
                            </select>
                        </label>
                        <p class="bk-end bk-span-2">สิ้นสุดสัญญา <strong id="endDateText">-</strong></p>

                        <label class="cu-field">
                            <span>สินค้าที่จะเก็บ</span>
                            <select asp-for="GoodsType">
                                <option>สินค้าอุปโภคบริโภคทั่วไป</option>
                                <option>อาหารและเครื่องดื่ม</option>
                                <option>ชิ้นส่วนอุตสาหกรรม / อะไหล่</option>
                                <option>อิเล็กทรอนิกส์และไอที</option>
                                <option>เสื้อผ้าและแฟชั่น</option>
                                <option>เวชภัณฑ์และอุปกรณ์การแพทย์</option>
                            </select>
                        </label>
                        <label class="cu-field">
                            <span>บริการวันย้ายเข้า (ไม่บังคับ)</span>
                            <select asp-for="MoveInService">
                                <option>ไม่ต้องการ</option>
                                <option>โฟล์คลิฟต์ยกพาเลท (ฟรี)</option>
                                <option>ติดตั้ง Racking เพิ่ม</option>
                            </select>
                        </label>
                        <label class="cu-field bk-span-2">
                            <span>หมายเหตุ (ไม่บังคับ)</span>
                            <textarea asp-for="Note" rows="2" placeholder="เช่น ขนาดรถที่จะเข้าเทียบ หรือวันขนของเข้าครั้งแรก"></textarea>
                        </label>
                    </div>
                </fieldset>
            </div>

            <!-- สรุปยอด -->
            <aside class="bk-summary" aria-labelledby="summaryTitle">
                <h2 id="summaryTitle" class="visually-hidden">สรุปยอด</h2>

                <div class="bk-room">
                    <img src="@(room.Img)?w=400&q=80" alt="" />
                    <div>
                        <strong>@room.Id</strong>
                        <span>@room.Zone, @room.Area ตร.ม.</span>
                    </div>
                </div>

                <!-- ยอดเงิน (JS คำนวณตามระยะสัญญา) -->
                <dl class="bk-calc">
                    <div>
                        <dt>ค่าเช่าเดือนแรก</dt>
                        <dd id="rentText"></dd>
                    </div>
                    <div>
                        <dt>
                            <span id="depositLabel">เงินประกัน 2 เดือน</span>
                            <span class="cu-sub">คืนเมื่อสิ้นสุดสัญญา</span>
                        </dt>
                        <dd id="depositText"></dd>
                    </div>
                    <div class="bk-total">
                        <dt>ชำระก่อนเข้าใช้</dt>
                        <dd id="totalText"></dd>
                    </div>
                </dl>
                <p class="cu-next" id="nextMonthsText"></p>

                <!-- โค้ดส่วนลด: มีแค่หน้าตา ยังไม่คิดส่วนลด -->
                <div class="cu-promo bk-promo">
                    <div class="cu-field">
                        <label for="promoInput">โค้ดส่วนลด</label>
                        <div class="cu-promo-row">
                            <input type="text" id="promoInput" name="PromoCode" value="@Model.PromoCode" autocomplete="off" placeholder="เช่น MEGA35START" />
                            <button type="button" class="cu-btn" id="promoButton">ใช้โค้ด</button>
                        </div>
                    </div>
                    <p class="cu-promo-msg" id="promoMessage" role="status" hidden></p>
                </div>

                <label class="bk-agree">
                    <input type="checkbox" asp-for="AgreeTerms" required />
                    <span>ฉันอ่านและยอมรับ<a href="#" id="termsLink">เงื่อนไขสัญญาเช่า</a>แล้ว</span>
                </label>

                @if (ViewBag.Error != null)
                {
                    <p class="bk-error" role="alert">@ViewBag.Error</p>
                }

                <button type="submit" class="cu-btn cu-btn--primary bk-submit" id="submitButton">ยืนยันการจองและไปชำระเงิน</button>
            </aside>
        </form>
    }
</div>

@section Scripts {
<script>
    // JS ใช้แค่แสดงผลบนหน้าจอ (คำนวณยอดให้ดูก่อนกดจอง)
    // การตรวจข้อมูลและบันทึกการจองทำที่ CustomerController.BookRoom (POST)
    const monthlyRate = @room.Price;   // ค่าเช่าต่อเดือน
    const bookingForm = document.getElementById('bookingForm');

    // แปลงตัวเลขเป็นข้อความเงินบาท เช่น 25000 -> ฿25,000
    function toBaht(amount) {
        return '฿' + Math.round(amount).toLocaleString('th-TH');
    }

    // จำนวนเดือนของเงินประกัน (กฎเดียวกับ CustomerController.GetDepositMonths)
    function getDepositMonths(months) {
        if (months >= 12) return 3;
        if (months >= 6) return 2;
        return 1;
    }

    // วันสิ้นสุดสัญญา = วันก่อนวันที่เดียวกันของเดือนปลายทาง
    // ถ้าเดือนปลายทางไม่มีวันที่นั้น ให้จบวันสุดท้ายของเดือนนั้น
    function getEndDate(startDate, months) {
        const year = startDate.getFullYear();
        const endMonth = startDate.getMonth() + months;
        const day = startDate.getDate();
        const lastDayOfEndMonth = new Date(year, endMonth + 1, 0).getDate();

        if (day > lastDayOfEndMonth) {
            return new Date(year, endMonth, lastDayOfEndMonth);
        }
        return new Date(year, endMonth, day - 1);
    }

    // คำนวณยอดและวันสิ้นสุดสัญญา
    function calculatePrice() {
        const months = parseInt(document.getElementById('Months').value) || 1;
        const depositMonths = getDepositMonths(months);
        const deposit = monthlyRate * depositMonths;

        document.getElementById('rentText').textContent = toBaht(monthlyRate);
        document.getElementById('depositLabel').textContent = 'เงินประกัน ' + depositMonths + ' เดือน';
        document.getElementById('depositText').textContent = toBaht(deposit);
        document.getElementById('totalText').textContent = toBaht(monthlyRate + deposit);

        const nextText = document.getElementById('nextMonthsText');
        if (months > 1) {
            nextText.textContent = 'เดือนที่ 2–' + months + ' ชำระเดือนละ ' + toBaht(monthlyRate);
            nextText.hidden = false;
        } else {
            nextText.hidden = true;
        }

        const startDate = document.getElementById('StartDate').valueAsDate;
        if (startDate) {
            const endDate = getEndDate(startDate, months);
            document.getElementById('endDateText').textContent =
                endDate.toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric' });
        }
    }

    // ประเภทผู้เช่า: บุคคลธรรมดาไม่ต้องกรอกชื่อบริษัท และใช้เลขบัตรประชาชนแทน
    function changeTenantType() {
        const type = bookingForm.querySelector('input[name=TenantType]:checked').value;
        const isCompany = (type === 'corp');

        document.getElementById('companyField').hidden = !isCompany;
        document.getElementById('CompanyName').required = isCompany;
        document.getElementById('taxIdLabel').textContent = isCompany ? 'เลขผู้เสียภาษี 13 หลัก' : 'เลขบัตรประชาชน 13 หลัก';
    }

    // โค้ดส่วนลด: ยังไม่มีระบบส่วนลด แสดงข้อความแจ้งเฉยๆ
    function applyPromo() {
        const code = document.getElementById('promoInput').value.trim();
        const message = document.getElementById('promoMessage');
        message.textContent = (code === '') ? 'พิมพ์โค้ดส่วนลดก่อนกดใช้โค้ด' : 'ยังใช้โค้ดส่วนลดไม่ได้ในตอนนี้';
        message.hidden = false;
    }

    // ห้องมีผู้เช่าแล้วจะไม่มีฟอร์ม ไม่ต้องทำอะไรต่อ
    if (bookingForm) {
        document.getElementById('StartDate').addEventListener('change', calculatePrice);
        document.getElementById('Months').addEventListener('change', calculatePrice);

        bookingForm.querySelectorAll('input[name=TenantType]').forEach(function (radio) {
            radio.addEventListener('change', changeTenantType);
        });

        document.getElementById('promoButton').addEventListener('click', applyPromo);
        document.getElementById('promoInput').addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();   // ไม่ให้กด Enter แล้วส่งฟอร์มจอง
                applyPromo();
            }
        });

        // ยังไม่มีหน้าเงื่อนไขสัญญา
        document.getElementById('termsLink').addEventListener('click', function (event) {
            event.preventDefault();
        });

        calculatePrice();
    }
</script>
}
