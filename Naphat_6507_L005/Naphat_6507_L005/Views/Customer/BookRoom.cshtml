@model Naphat_6507_L005.ViewModels.BookingViewModel
@{
    // โปรโมชั่นที่เลือกได้ตอนจอง (CustomerController.SetPromoOptionsBag)
    var promoOptions = (List<Naphat_6507_L005.ViewModels.PromoOptionViewModel>)(ViewBag.PromoOptions ?? new List<Naphat_6507_L005.ViewModels.PromoOptionViewModel>());
    var room = (Naphat_6507_L005.ViewModels.RoomViewModel)ViewBag.Room;
    var periods = ViewBag.BookedPeriods as List<Naphat_6507_L005.ViewModels.BookedPeriodViewModel> ?? new();   // ช่วงที่ถูกจองแล้ว
    var isCompany = Model.TenantType != "person";
    var quote = (Naphat_6507_L005.ViewModels.PriceQuoteViewModel)ViewBag.Quote;   // ยอดเริ่มต้นจาก Controller

    // แถวรายการสินค้า: ถ้ายังไม่มี (เปิดฟอร์มครั้งแรก) ให้มีแถวว่าง 1 แถว
    var itemRows = Model.Items.Count > 0 ? Model.Items : new List<Naphat_6507_L005.ViewModels.DeclaredItemViewModel> { new() };

    ViewData["Title"] = "จองห้อง " + room.Id;
    Layout = "_PublicLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/book.css" asp-append-version="true" />
}

<div class="bk cu">

    <a class="cu-back" asp-controller="Customer" asp-action="RoomDetail" asp-route-id="@room.Id">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>กลับไปห้อง @room.Id
    </a>

    <!-- หัวข้อ -->
    <header class="cu-head">
        <h1>จองห้อง @room.Id</h1>
        <p>กรอกข้อมูลผู้เช่าและระยะสัญญา จากนั้นไปชำระเงิน</p>
    </header>

    <!-- ขั้นตอนการจอง -->
    <ol class="bk-steps" aria-label="ขั้นตอนการจอง">
        <li class="is-done"><span>1</span>เลือกห้อง</li>
        <li class="is-current" aria-current="step"><span>2</span>ข้อมูลการเช่า</li>
        <li><span>3</span>ชำระเงิน</li>
    </ol>

    @if (periods.Count > 0)
    {
        <!-- ช่วงที่ห้องถูกจองแล้ว (CustomerController.GetBookedPeriods) จองได้เฉพาะช่วงที่ไม่ทับ -->
                <div class="cu-booked bk-booked">
                    <strong>ช่วงที่ถูกจองแล้ว</strong>
                    <ul>
                        @foreach (var p in periods)
                        {
                            <li>@p.Text</li>
                        }
                    </ul>
                    <p>ว่างให้จองตั้งแต่ <strong>@ViewBag.NextFreeText</strong></p>
                </div>
    }

    @* จองได้ถ้าช่วงเวลาไม่ทับกับการจองอื่น (ตรวจที่ CustomerController.BookRoom POST) *@
        <form class="bk-layout" id="bookingForm" asp-controller="Customer" asp-action="BookRoom" method="post">
            <input type="hidden" asp-for="RoomId" />

            <div class="bk-main">

                <!-- ข้อมูลผู้เช่า -->
                <fieldset class="bk-section">
                    <legend class="cu-h2">ผู้เช่า</legend>

                    <div class="bk-type" role="radiogroup" aria-label="ประเภทผู้เช่า">
                        <label>
                            <input type="radio" asp-for="TenantType" value="corp" />
                            <span>บริษัท / นิติบุคคล</span>
                        </label>
                        <label>
                            <input type="radio" asp-for="TenantType" value="person" />
                            <span>บุคคลธรรมดา</span>
                        </label>
                    </div>

                    <div class="bk-grid">
                        <label class="cu-field bk-span-2" id="companyField" hidden="@(!isCompany)">
                            <span>ชื่อบริษัท</span>
                            <input type="text" asp-for="CompanyName" autocomplete="organization" placeholder="เช่น บจก. ไทยซัพพลาย" required="@isCompany" />
                        </label>
                        <label class="cu-field">
                            <span id="taxIdLabel">@(isCompany ? "เลขผู้เสียภาษี 13 หลัก" : "เลขบัตรประชาชน 13 หลัก")</span>
                            <input type="text" asp-for="TaxId" inputmode="numeric" pattern="[0-9]{13}" maxlength="13" title="ตัวเลข 13 หลักเท่านั้น" placeholder="1234567890123" required />
                        </label>
                        <label class="cu-field">
                            <span>ชื่อผู้ติดต่อ</span>
                            <input type="text" asp-for="ContactName" autocomplete="name" required />
                        </label>
                        <label class="cu-field">
                            <span>เบอร์โทร</span>
                            <input type="tel" asp-for="Phone" inputmode="numeric" pattern="0[689][0-9]{8}|0[1-57][0-9]{7}" maxlength="10" title="ตัวเลขเท่านั้น: มือถือ 10 หลัก หรือเบอร์บ้าน 9 หลัก ขึ้นต้นด้วย 0" placeholder="0812345678" autocomplete="tel" required />
                        </label>
                        <label class="cu-field">
                            <span>อีเมลรับสัญญาและใบแจ้งหนี้</span>
                            <input type="email" asp-for="Email" autocomplete="email" placeholder="name@company.com" required />
                        </label>
                        <label class="cu-field bk-span-2">
                            <span>ที่อยู่ออกใบกำกับภาษี</span>
                            <textarea asp-for="Address" rows="2" autocomplete="street-address" required></textarea>
                        </label>
                    </div>
                </fieldset>

                <!-- สัญญาเช่า -->
                <fieldset class="bk-section">
                    <legend class="cu-h2">สัญญาเช่า</legend>

                    <div class="bk-grid">
                        <label class="cu-field">
                            <span>วันเริ่มเช่า</span>
                            <input type="date" asp-for="StartDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </label>
                        <label class="cu-field">
                            <span>ระยะสัญญา</span>
                            <select asp-for="Months">
                                <option value="1">1 เดือน</option>
                                <option value="3">3 เดือน</option>
                                <option value="6">6 เดือน</option>
                                <option value="12">12 เดือน</option>
                            </select>
                        </label>
                        <p class="bk-end bk-span-2">สิ้นสุดสัญญา <strong id="endDateText">@quote.EndDateText</strong></p>

                        <label class="cu-field">
                            <span>ประเภทสินค้าหลัก</span>
                            <select asp-for="GoodsType">
                                <option>สินค้าอุปโภคบริโภคทั่วไป</option>
                                <option>อาหารและเครื่องดื่ม</option>
                                <option>ชิ้นส่วนอุตสาหกรรม / อะไหล่</option>
                                <option>อิเล็กทรอนิกส์และไอที</option>
                                <option>เสื้อผ้าและแฟชั่น</option>
                                <option>เวชภัณฑ์และอุปกรณ์การแพทย์</option>
                            </select>
                        </label>
                        <label class="cu-field">
                            <span>บริการวันย้ายเข้า (ไม่บังคับ)</span>
                            <select asp-for="MoveInService">
                                <option>ไม่ต้องการ</option>
                                <option>โฟล์คลิฟต์ยกพาเลท (ฟรี)</option>
                                <option>ติดตั้ง Racking เพิ่ม</option>
                            </select>
                        </label>
                        <label class="cu-field bk-span-2">
                            <span>หมายเหตุ (ไม่บังคับ)</span>
                            <textarea asp-for="Note" rows="2" placeholder="เช่น ขนาดรถที่จะเข้าเทียบ หรือวันขนของเข้าครั้งแรก"></textarea>
                        </label>
                    </div>
                </fieldset>

                <!-- สินค้าที่จะนำเข้า: ฝ่ายคลังใช้ตรวจรับวันย้ายเข้า -->
                <fieldset class="bk-section">
                    <legend class="cu-h2">สินค้าที่จะนำเข้า</legend>
                    <p class="bk-items-help">แจ้งรายการและจำนวนสินค้า ฝ่ายคลังจะตรวจรับให้ตรงกับที่แจ้งในวันย้ายเข้า หลังจองแล้วถ้าต้องการแก้ไข ติดต่อฝ่ายคลังได้</p>

                    <div class="bk-items" id="itemRows">
                        @for (int i = 0; i < itemRows.Count; i++)
                        {
                            <div class="bk-item-row">
                                <label class="cu-field bk-item-name">
                                    <span>ชื่อสินค้า</span>
                                    <input type="text" name="Items[@i].ItemName" value="@itemRows[i].ItemName" maxlength="200" placeholder="เช่น น้ำดื่มขวด 600 มล." />
                                </label>
                                <label class="cu-field bk-item-qty">
                                    <span>จำนวน</span>
                                    <input type="number" name="Items[@i].Quantity" value="@(itemRows[i].Quantity > 0 ? itemRows[i].Quantity.ToString() : "")" min="1" step="1" />
                                </label>
                                <label class="cu-field bk-item-unit">
                                    <span>หน่วย</span>
                                    <input type="text" name="Items[@i].Unit" value="@itemRows[i].Unit" maxlength="50" placeholder="กล่อง / พาเลท" />
                                </label>
                                <button type="button" class="bk-item-remove" aria-label="ลบรายการนี้">
                                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                                </button>
                            </div>
                        }
                    </div>
                    <button type="button" class="cu-btn bk-item-add" id="addItemButton">
                        <span class="material-symbols-outlined" aria-hidden="true">add</span> เพิ่มรายการ
                    </button>
                </fieldset>
            </div>

            <!-- สรุปยอด -->
            <aside class="bk-summary" aria-labelledby="summaryTitle">
                <h2 id="summaryTitle" class="visually-hidden">สรุปยอด</h2>

                <div class="bk-room">
                    <img src="@(room.Img)?w=400&q=80" alt="" />
                    <div>
                        <strong>@room.Id</strong>
                        <span>@room.Zone, @room.Area ตร.ม.</span>
                    </div>
                </div>

                <!-- ยอดเงิน (JS คำนวณตามระยะสัญญา) -->
                <dl class="bk-calc">
                    <div>
                        <dt>ค่าเช่าเดือนแรก</dt>
                        <dd id="rentText">@quote.RentText</dd>
                    </div>
                    <div>
                        <dt>
                            <span id="depositLabel">เงินประกัน @quote.DepositMonths เดือน</span>
                            <span class="cu-sub">คืนเมื่อสิ้นสุดสัญญา</span>
                        </dt>
                        <dd id="depositText">@quote.DepositText</dd>
                    </div>
                    <div id="discountRow" hidden="@(quote.DiscountText == null)">
                        <dt>ส่วนลดค่าเช่าเดือนแรก</dt>
                        <dd id="discountText">@quote.DiscountText</dd>
                    </div>
                    <div class="bk-total">
                        <dt>ชำระก่อนเข้าใช้</dt>
                        <dd id="totalText">@quote.TotalText</dd>
                    </div>
                </dl>
                <p class="cu-next" id="nextMonthsText" hidden="@(quote.NextMonthsText == null)">@quote.NextMonthsText</p>

                <!-- โค้ดส่วนลด: เลือกจากรายการโปร หรือพิมพ์โค้ดเอง
                     ตรวจที่ CustomerController.CheckPromo (เลือก/กดใช้โค้ด = ขอยอดใหม่จาก PriceQuote ตอนกดจองตรวจซ้ำอีกครั้ง) -->
                <div class="cu-promo bk-promo">
                    <div class="bk-promo-head">
                        <label for="promoInput">โค้ดส่วนลด</label>
                        @if (promoOptions.Count > 0)
                        {
                            <button type="button" class="bk-promo-open" id="promoOpen" aria-expanded="false" aria-controls="promoPanel">
                                <span class="material-symbols-outlined" aria-hidden="true">sell</span>
                                เลือกโปรโมชั่น (@promoOptions.Count)
                            </button>
                        }
                    </div>
                    <div class="cu-promo-row">
                        <input type="text" id="promoInput" name="PromoCode" value="@Model.PromoCode" autocomplete="off" placeholder="เช่น MEGA35START" />
                        <button type="button" class="cu-btn" id="promoButton">ใช้โค้ด</button>
                    </div>
                    <p class="cu-promo-msg" id="promoMessage" role="status" hidden></p>

                    @if (promoOptions.Count > 0)
                    {
                        <!-- รายการโปรโมชั่นที่ใช้ได้ตอนนี้ (CustomerController.SetPromoOptionsBag) -->
                        <div class="bk-promo-panel" id="promoPanel" hidden>
                            <div class="bk-promo-panel-head">
                                <strong>เลือกโปรโมชั่น</strong>
                                <button type="button" class="bk-promo-close" id="promoClose" aria-label="ปิด">
                                    <span class="material-symbols-outlined">close</span>
                                </button>
                            </div>

                            <ul class="bk-promo-list">
                                @foreach (var option in promoOptions)
                                {
                                    <li class="bk-promo-item" data-code="@option.Code" data-min="@option.MinMonths" data-locked="@(option.UserLimitReached ? "1" : "0")">
                                        <button type="button" class="bk-promo-pick">
                                            <span class="bk-promo-big">@option.BigText</span>
                                            <span class="bk-promo-info">
                                                <strong>@option.Code</strong>
                                                <span>@option.Description</span>
                                                <span class="bk-promo-why" hidden></span>
                                            </span>
                                            @if (option.BadgeText != null)
                                            {
                                                <span class="bk-promo-badge">@option.BadgeText</span>
                                            }
                                        </button>
                                        <details class="bk-promo-terms">
                                            <summary>ข้อกำหนดของโค้ดนี้</summary>
                                            <ul>
                                                @foreach (var term in option.Terms)
                                                {
                                                    <li>@term</li>
                                                }
                                            </ul>
                                        </details>
                                    </li>
                                }
                            </ul>

                            <details class="bk-promo-rules">
                                <summary>ข้อกำหนดการใช้โค้ดส่วนลด</summary>
                                <ol>
                                    <li>ใช้ได้ 1 โค้ดต่อการจอง 1 ครั้ง</li>
                                    <li>ส่วนลดใช้กับค่าเช่าเดือนแรกเท่านั้น ไม่รวมเงินประกัน</li>
                                    <li>ส่วนลดแบบจำนวนเงิน ลดได้ไม่เกินค่าเช่าเดือนแรก</li>
                                    <li>ต้องตรงตามเงื่อนไขของโค้ด เช่น ระยะสัญญาขั้นต่ำ ช่วงวันที่ และจำนวนสิทธิ์</li>
                                    <li>ระบบตรวจโค้ดอีกครั้งตอนกดยืนยันการจอง ถ้าโค้ดหมดสิทธิ์ก่อน จะจองไม่สำเร็จจนกว่าจะเอาโค้ดออก</li>
                                    <li>ถ้าการจองถูกยกเลิก สิทธิ์ของโค้ดจะคืนให้ใช้ใหม่ได้</li>
                                    <li>ส่วนลดแลกเป็นเงินสดหรือโอนให้ผู้อื่นไม่ได้</li>
                                </ol>
                            </details>

                            <button type="button" class="bk-promo-none" id="promoNone">ไม่ใช้โค้ดส่วนลด</button>
                        </div>
                    }
                </div>

                <label class="bk-agree">
                    <input type="checkbox" asp-for="AgreeTerms" required />
                    <span>ฉันอ่านและยอมรับ<a href="#" id="termsLink">เงื่อนไขสัญญาเช่า</a>แล้ว</span>
                </label>

                @if (ViewBag.Error != null)
                {
                    <p class="bk-error" role="alert">@ViewBag.Error</p>
                }

                <button type="submit" class="cu-btn cu-btn--primary bk-submit" id="submitButton">ยืนยันการจองและไปชำระเงิน</button>
            </aside>
        </form>
</div>

@section Scripts {
<script>
    // JS ใช้แค่แสดงผลบนหน้าจอ การตรวจข้อมูลและบันทึกการจองทำที่ CustomerController.BookRoom (POST)
    const bookingForm = document.getElementById('bookingForm');

    // ยอดและวันสิ้นสุดสัญญาคิดที่ CustomerController.BuildQuote ที่เดียว
    // JS แค่ขอค่าใหม่จาก Customer/PriceQuote เมื่อเปลี่ยนวันหรือระยะสัญญา แล้วเอามาแสดง
    const quoteUrl = '@Url.Action("PriceQuote", "Customer", new { id = room.Id })';

    function showQuote(q) {
        document.getElementById('rentText').textContent = q.rentText;
        document.getElementById('depositLabel').textContent = 'เงินประกัน ' + q.depositMonths + ' เดือน';
        document.getElementById('depositText').textContent = q.depositText;
        document.getElementById('totalText').textContent = q.totalText;
        document.getElementById('discountText').textContent = q.discountText || '';
        document.getElementById('discountRow').hidden = !q.discountText;
        const nextText = document.getElementById('nextMonthsText');
        nextText.textContent = q.nextMonthsText || '';
        nextText.hidden = !q.nextMonthsText;
        const endText = document.getElementById('endDateText');
        if (endText) {
            endText.textContent = q.endDateText;
        }
    }

    function refreshQuote(startValue, monthsValue) {
        const promo = document.getElementById('promoInput').value.trim();
        const url = quoteUrl + '?months=' + encodeURIComponent(monthsValue) + (startValue ? '&start=' + encodeURIComponent(startValue) : '')
                    + (promo ? '&promo=' + encodeURIComponent(promo) : '');
        fetch(url, { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (q) {
                if (!q) return;
                showQuote(q);
                // ผลการตรวจโค้ดจาก Controller
                const message = document.getElementById('promoMessage');
                message.textContent = q.promoMessage || '';
                message.hidden = !q.promoMessage;
                message.classList.toggle('is-ok', !!q.promoOk);
            })
            .catch(function () { /* เน็ตหลุด: คงยอดเดิมไว้ ยอดจริงคิดใหม่ตอนกดจองอยู่แล้ว */ });
    }

    // ประเภทผู้เช่า: บุคคลธรรมดาไม่ต้องกรอกชื่อบริษัท และใช้เลขบัตรประชาชนแทน
    function changeTenantType() {
        const type = bookingForm.querySelector('input[name=TenantType]:checked').value;
        const isCompany = (type === 'corp');

        document.getElementById('companyField').hidden = !isCompany;
        document.getElementById('CompanyName').required = isCompany;
        document.getElementById('taxIdLabel').textContent = isCompany ? 'เลขผู้เสียภาษี 13 หลัก' : 'เลขบัตรประชาชน 13 หลัก';
    }

    // โค้ดส่วนลด: ขอยอดใหม่พร้อมโค้ด (Controller ตรวจว่าใช้ได้ไหม และคิดส่วนลดให้)
    function applyPromo() {
        const code = document.getElementById('promoInput').value.trim();
        if (code === '') {
            const message = document.getElementById('promoMessage');
            message.textContent = 'พิมพ์โค้ดส่วนลดก่อนกดใช้โค้ด';
            message.hidden = false;
            return;
        }
        refreshQuote(document.getElementById('StartDate').value, document.getElementById('Months').value);
    }

    // ห้องมีผู้เช่าแล้วจะไม่มีฟอร์ม ไม่ต้องทำอะไรต่อ
    if (bookingForm) {
        const startInput = document.getElementById('StartDate');
        const monthsInput = document.getElementById('Months');
        startInput.addEventListener('change', function () { refreshQuote(startInput.value, monthsInput.value); });
        monthsInput.addEventListener('change', function () { refreshQuote(startInput.value, monthsInput.value); });

        bookingForm.querySelectorAll('input[name=TenantType]').forEach(function (radio) {
            radio.addEventListener('change', changeTenantType);
        });

        document.getElementById('promoButton').addEventListener('click', applyPromo);

        // ===== รายการโปรโมชั่นให้เลือก (แค่เปิด/ปิดและกรอกโค้ดให้ การตรวจจริงอยู่ที่ Controller) =====
        const promoPanel = document.getElementById('promoPanel');
        if (promoPanel) {
            const promoOpen = document.getElementById('promoOpen');
            const promoInput = document.getElementById('promoInput');

            // ปิดโค้ดที่ใช้ไม่ได้กับระยะสัญญาที่เลือก หรือที่ลูกค้าใช้ครบสิทธิ์แล้ว
            function updatePromoItems() {
                const months = parseInt(monthsInput.value, 10);
                const current = promoInput.value.trim().toUpperCase();
                promoPanel.querySelectorAll('.bk-promo-item').forEach(function (item) {
                    const why = item.querySelector('.bk-promo-why');
                    let reason = '';
                    if (item.dataset.locked === '1') {
                        reason = 'คุณใช้โค้ดนี้ครบสิทธิ์แล้ว';
                    } else if (months < parseInt(item.dataset.min, 10)) {
                        reason = 'ต้องทำสัญญา ' + item.dataset.min + ' เดือนขึ้นไป';
                    }
                    why.textContent = reason;
                    why.hidden = reason === '';
                    item.classList.toggle('is-disabled', reason !== '');
                    item.querySelector('.bk-promo-pick').disabled = reason !== '';
                    item.classList.toggle('is-selected', item.dataset.code === current);
                });
            }

            function togglePanel(open) {
                promoPanel.hidden = !open;
                promoOpen.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (open) {
                    updatePromoItems();
                }
            }

            promoOpen.addEventListener('click', function () { togglePanel(promoPanel.hidden); });
            document.getElementById('promoClose').addEventListener('click', function () { togglePanel(false); });

            promoPanel.querySelectorAll('.bk-promo-pick').forEach(function (pick) {
                pick.addEventListener('click', function () {
                    promoInput.value = pick.closest('.bk-promo-item').dataset.code;
                    applyPromo();
                    togglePanel(false);
                });
            });

            document.getElementById('promoNone').addEventListener('click', function () {
                promoInput.value = '';
                document.getElementById('promoMessage').hidden = true;
                refreshQuote(startInput.value, monthsInput.value);
                togglePanel(false);
            });

            monthsInput.addEventListener('change', updatePromoItems);
        }
        // มาจากการ์ดโปรโมชั่นหน้าหลัก: มีโค้ดกรอกไว้แล้ว ตรวจโค้ดและคิดยอดใหม่เลย
        if (document.getElementById('promoInput').value.trim() !== '') {
            applyPromo();
        }
        document.getElementById('promoInput').addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();   // ไม่ให้กด Enter แล้วส่งฟอร์มจอง
                applyPromo();
            }
        });

        // ยังไม่มีหน้าเงื่อนไขสัญญา
        document.getElementById('termsLink').addEventListener('click', function (event) {
            event.preventDefault();
        });


        // รายการสินค้า: เพิ่ม / ลบแถวบนหน้าจอ แล้วเรียงชื่อช่องใหม่ (Items[0], Items[1], ...) ให้ส่งไป Controller ได้ครบ
        const itemRows = document.getElementById('itemRows');

        function renumberItems() {
            itemRows.querySelectorAll('.bk-item-row').forEach(function (row, index) {
                row.querySelectorAll('input').forEach(function (input) {
                    input.name = input.name.replace(/Items\[\d+\]/, 'Items[' + index + ']');
                });
            });
        }

        document.getElementById('addItemButton').addEventListener('click', function () {
            const first = itemRows.querySelector('.bk-item-row');
            const row = first.cloneNode(true);
            row.querySelectorAll('input').forEach(function (input) { input.value = ''; });
            itemRows.appendChild(row);
            renumberItems();
            row.querySelector('input').focus();
        });

        itemRows.addEventListener('click', function (event) {
            const button = event.target.closest('.bk-item-remove');
            if (!button) return;
            const rows = itemRows.querySelectorAll('.bk-item-row');
            if (rows.length === 1) {
                rows[0].querySelectorAll('input').forEach(function (input) { input.value = ''; });   // เหลือแถวเดียว: ล้างค่าแทนการลบ
            } else {
                button.closest('.bk-item-row').remove();
                renumberItems();
            }
        });
    }
</script>
}
