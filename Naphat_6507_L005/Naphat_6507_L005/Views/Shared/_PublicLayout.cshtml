@* Layout ของหน้าฝั่งลูกค้าทั้งหมด (หน้าหลัก, ค้นหาห้อง, รายละเอียดห้อง, จองห้อง, บัญชีของฉัน)
   เมนูด้านบน ไม่มี sidebar สไตล์ตาม DESIGN.md (wwwroot/css/home.css)
   - หน้าหลักตั้ง ViewData["HeroNav"] = true: เมนูโปร่งใสทับรูป hero และเนื้อหาเต็มจอ
   - หน้าอื่น: เมนูทึบ และเนื้อหาอยู่ในกรอบกว้างสุด 1200px
   ฝั่งพนักงานยังใช้ _Layout ที่มี sidebar *@
@{
    var sessionUser = Context.Session.GetString("Username");
    var role = Context.Session.GetString("Role") ?? "Guest";
    var fullName = Context.Session.GetString("FullName") ?? "";
    bool isLoggedIn = !string.IsNullOrEmpty(sessionUser);
    bool heroNav = ViewData["HeroNav"] as bool? == true;

    // เมนูที่ตรงกับหน้าปัจจุบัน
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var tab = Context.Request.Query["tab"].ToString();
    bool inCustomer = controller == "Customer";
    string Current(bool on) => on ? "page" : "false";
    bool onHome = inCustomer && action == "Dashboard";
    bool onSearch = inCustomer && (action == "Search" || action == "RoomDetail" || action == "BookRoom");
    bool onBookings = inCustomer && action == "Profile" && (tab == "bookings" || tab == "");
    bool onPayment = inCustomer && action == "Profile" && tab == "payment";
    bool onInfo = inCustomer && action == "Profile" && tab == "info";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LogiManage</title>
    <meta name="description" content="ระบบเช่าห้องคลังสินค้าออนไลน์ LogiManage" />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="hm">

    <!-- ===== เมนูด้านบน ===== -->
    <header class="hm-nav @(heroNav ? "" : "is-solid")" id="hmNav">
        <div class="hm-nav-inner">
            <a asp-controller="Customer" asp-action="Dashboard" class="hm-brand">
                <span class="hm-brand-mark" aria-hidden="true"></span>
                LogiManage
            </a>

            <button type="button" class="hm-nav-toggle" id="hmNavToggle" aria-expanded="false" aria-controls="hmNavMenu" aria-label="เปิดเมนู">
                <span class="material-symbols-outlined" aria-hidden="true">menu</span>
            </button>

            <div class="hm-nav-menu" id="hmNavMenu">
                <nav class="hm-nav-links" aria-label="เมนูหลัก">
                    <a asp-controller="Customer" asp-action="Dashboard" class="hm-nav-link" aria-current="@Current(onHome)">หน้าหลัก</a>
                    <a asp-controller="Customer" asp-action="Search" class="hm-nav-link" aria-current="@Current(onSearch)">ค้นหาห้อง</a>
                    @if (isLoggedIn && role == "Customer")
                    {
                        <a asp-controller="Customer" asp-action="Profile" asp-route-tab="bookings" class="hm-nav-link" aria-current="@Current(onBookings)">การจองของฉัน</a>
                        <a asp-controller="Customer" asp-action="Profile" asp-route-tab="payment" class="hm-nav-link" aria-current="@Current(onPayment)">ชำระเงิน</a>
                    }
                    else if (isLoggedIn)
                    {
                        <a asp-controller="@role" asp-action="Dashboard" class="hm-nav-link">หน้าทำงาน</a>
                    }
                </nav>

                <div class="hm-nav-actions">
                    @if (!isLoggedIn)
                    {
                        <a asp-controller="Account" asp-action="Login" class="hm-nav-link">เข้าสู่ระบบ</a>
                        <a asp-controller="Account" asp-action="Register" class="hm-btn hm-btn--primary">สมัครสมาชิก</a>
                    }
                    else
                    {
                        @if (role == "Customer")
                        {
                            <a asp-controller="Customer" asp-action="Profile" asp-route-tab="info" class="hm-nav-link hm-nav-user" aria-current="@Current(onInfo)">
                                <span class="material-symbols-outlined" aria-hidden="true">account_circle</span> @fullName
                            </a>
                        }
                        else
                        {
                            <span class="hm-nav-link hm-nav-user">
                                <span class="material-symbols-outlined" aria-hidden="true">account_circle</span> @fullName
                            </span>
                        }
                        <a asp-controller="Account" asp-action="Logout" class="hm-btn hm-btn--ghost">ออกจากระบบ</a>
                    }
                </div>
            </div>
        </div>
    </header>

    @if (heroNav)
    {
        <main>
            @RenderBody()
        </main>
    }
    else
    {
        <main class="hm-page">
            <div class="hm-container">
                @RenderBody()
            </div>
        </main>
    }

    <footer class="hm-footer">
        &copy; 2026 LogiManage — ระบบเช่าห้องคลังสินค้าออนไลน์
    </footer>

    @if (isLoggedIn && role == "Customer")
    {
        <!-- ===== ปุ่มแชทฝ่ายบริการลูกค้า มุมขวาล่าง (ทุกหน้าของลูกค้า) =====
             ข้างในกล่องเป็นหน้าย่อยจาก CustomerController (Chat / ChatThread / ChatNew) โหลดเมื่อกดเปิดครั้งแรก -->
        <div class="cs-widget">
            <section class="cs-panel" id="csPanel" role="dialog" aria-label="แชทกับฝ่ายบริการลูกค้า" hidden>
                <button type="button" class="cs-panel-close" id="csClose" aria-label="ปิดแชท">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
                <iframe id="csFrame" title="แชทกับฝ่ายบริการลูกค้า" data-src="@Url.Action("Chat", "Customer")"></iframe>
            </section>

            <button type="button" class="cs-toast" id="csToast" hidden></button>

            <button type="button" class="cs-fab" id="csFab" aria-expanded="false" aria-controls="csPanel" aria-label="แชทกับฝ่ายบริการลูกค้า">
                <span class="material-symbols-outlined" aria-hidden="true">support_agent</span>
                <span class="cs-badge" id="csBadge" hidden></span>
            </button>
        </div>

        <script>
            // ปุ่มแชท: เปิด/ปิดกล่อง และถามจำนวนข้อความใหม่จาก CustomerController.ChatUnread ทุก 30 วินาที (ตัวนับคิดที่ Controller)
            (function () {
                const unreadUrl = '@Url.Action("ChatUnread", "Customer")';
                const fab = document.getElementById('csFab');
                const panel = document.getElementById('csPanel');
                const frame = document.getElementById('csFrame');
                const badge = document.getElementById('csBadge');
                const toast = document.getElementById('csToast');
                let lastCount = null;

                function setOpen(open) {
                    panel.hidden = !open;
                    fab.setAttribute('aria-expanded', open ? 'true' : 'false');
                    fab.classList.toggle('is-open', open);
                    if (open) {
                        if (!frame.src) {
                            frame.src = frame.dataset.src;   // โหลดครั้งแรกตอนเปิด
                        }
                        toast.hidden = true;
                    }
                }

                fab.addEventListener('click', function () { setOpen(panel.hidden); });
                document.getElementById('csClose').addEventListener('click', function () { setOpen(false); fab.focus(); });
                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape' && !panel.hidden) { setOpen(false); fab.focus(); }
                });
                toast.addEventListener('click', function () { setOpen(true); });

                function showBadge(count) {
                    badge.hidden = count === 0;
                    badge.textContent = count > 9 ? '9+' : count;
                    fab.setAttribute('aria-label', count > 0 ? 'แชทกับฝ่ายบริการลูกค้า มีข้อความใหม่ ' + count + ' ข้อความ' : 'แชทกับฝ่ายบริการลูกค้า');
                }

                function checkUnread() {
                    fetch(unreadUrl, { headers: { 'Accept': 'application/json' } })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (data) {
                            if (!data) return;
                            showBadge(data.count);
                            // มีข้อความใหม่เพิ่มขึ้นตอนกล่องปิดอยู่: เด้งข้อความแจ้งเตือนข้างปุ่ม ค้างไว้จนกว่าลูกค้าจะเปิดแชท
                            if (lastCount !== null && data.count > lastCount && panel.hidden && data.text) {
                                toast.textContent = 'ฝ่ายบริการลูกค้า: ' + data.text;
                                toast.hidden = false;
                            }
                            if (data.count === 0) {
                                toast.hidden = true;
                            }
                            lastCount = data.count;
                        })
                        .catch(function () { /* เน็ตหลุด: รอรอบถัดไป */ });
                }

                frame.addEventListener('load', checkUnread);   // เปิดอ่านในกล่องแล้ว ตัวเลขลดลงทันที
                checkUnread();
                setInterval(checkUnread, 30000);
            })();
        </script>
    }

    <script>
        // เมนูด้านบน: ทึบขึ้นเมื่อเลื่อนลง และเปิด/ปิดเมนูบนจอมือถือ (เฉพาะหน้าตา)
        (function () {
            const nav = document.getElementById('hmNav');
            const toggle = document.getElementById('hmNavToggle');

            function updateNav() {
                nav.classList.toggle('is-scrolled', window.scrollY > 24);
            }
            window.addEventListener('scroll', updateNav, { passive: true });
            updateNav();

            toggle.addEventListener('click', function () {
                const open = nav.classList.toggle('is-open');
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                toggle.setAttribute('aria-label', open ? 'ปิดเมนู' : 'เปิดเมนู');
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
