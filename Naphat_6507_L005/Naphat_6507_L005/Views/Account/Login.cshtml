@model Naphat_6507_L005.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = "_LayoutLogin";
}

<div class="auth">

    <!-- ฝั่งซ้าย: แบรนด์ -->
    <aside class="auth-brand">
        <a asp-controller="Customer" asp-action="Dashboard" class="auth-logo">Logi<span>Manage</span></a>

        <div>
            <span class="lm-eyebrow" style="color:rgba(255,255,255,.6);"><span class="lm-dot"></span> Warehouse rental platform</span>
            <h2>เช่าคลังสินค้า<br />จบในที่เดียว <em>ออนไลน์</em></h2>
            <p class="lead-s">จองห้อง ชำระเงิน ติดตามสต็อก และดูใบเสร็จได้จากหน้าเว็บเดียว ไม่ต้องเดินทางมาติดต่อ</p>

            <div class="auth-points">
                <div class="auth-point">
                    <span class="material-symbols-outlined">warehouse</span>
                    ห้องคลังไซส์ S ถึง XL และห้องเย็น
                </div>
                <div class="auth-point">
                    <span class="material-symbols-outlined">inventory_2</span>
                    ดูสต็อกสินค้าในห้องของคุณแบบเรียลไทม์
                </div>
                <div class="auth-point">
                    <span class="material-symbols-outlined">receipt_long</span>
                    ใบแจ้งหนี้และใบเสร็จออนไลน์ทุกเดือน
                </div>
            </div>
        </div>

        <div class="auth-foot">© 2026 LOGIMANAGE · CSI402</div>
    </aside>

    <!-- ฝั่งขวา: ฟอร์ม -->
    <main class="auth-form-wrap">
        <div class="auth-form">
            <a asp-controller="Customer" asp-action="Dashboard" class="auth-back">
                <span class="material-symbols-outlined" style="font-size:1.1rem;">arrow_back</span>
                กลับสู่หน้าหลัก
            </a>

            <h1>ยินดีต้อนรับกลับ</h1>
            <p class="sub">เข้าสู่ระบบเพื่อจัดการการเช่าคลังสินค้าของคุณ</p>

            @if (ViewBag.Error != null)
            {
                <div class="auth-msg err">
                    <span class="material-symbols-outlined" style="font-size:1.1rem;">error</span>
                    @ViewBag.Error
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="auth-msg ok">
                    <span class="material-symbols-outlined" style="font-size:1.1rem;">check_circle</span>
                    @TempData["Success"]
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label" asp-for="Username">ชื่อผู้ใช้งาน</label>
                    <div class="auth-input">
                        <span class="material-symbols-outlined">person</span>
                        <input type="text" asp-for="Username" class="form-control"
                               placeholder="กรอกชื่อผู้ใช้" autocomplete="username" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="Password">รหัสผ่าน</label>
                    <div class="auth-input">
                        <span class="material-symbols-outlined">lock</span>
                        <input type="password" asp-for="Password" class="form-control"
                               placeholder="กรอกรหัสผ่าน" autocomplete="current-password" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary auth-submit">
                    เข้าสู่ระบบ
                    <span class="material-symbols-outlined" style="font-size:1.15rem;">arrow_forward</span>
                </button>
            </form>

            <div class="auth-alt">
                ยังไม่มีบัญชีผู้ใช้?
                <a asp-controller="Account" asp-action="Register">สมัครสมาชิก</a>
            </div>
        </div>
    </main>

</div>
