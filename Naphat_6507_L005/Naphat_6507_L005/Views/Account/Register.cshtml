@model Naphat_6507_L005.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "สมัครสมาชิก";
    Layout = "_LayoutLogin";
}

<div class="auth">

    <partial name="_AuthBrand" />

    <!-- ฝั่งขวา: ฟอร์ม -->
    <main class="auth-form-wrap">
        <div class="auth-form">
            <a asp-controller="Account" asp-action="Login" class="auth-back">
                <span class="material-symbols-outlined" style="font-size:1.1rem;">arrow_back</span>
                กลับสู่หน้าเข้าสู่ระบบ
            </a>

            <h1>สมัครสมาชิก</h1>
            <p class="sub">สร้างบัญชีเพื่อเริ่มจองคลังสินค้า</p>

            @if (ViewBag.Error != null)
            {
                <div class="auth-msg err">
                    <span class="material-symbols-outlined" style="font-size:1.1rem;">error</span>
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="Register" method="post">
                <div class="mb-3">
                    <label class="form-label" asp-for="Username">ชื่อผู้ใช้งาน</label>
                    <div class="auth-input">
                        <span class="material-symbols-outlined">person</span>
                        <input type="text" asp-for="Username" class="form-control"
                               placeholder="ใช้สำหรับเข้าสู่ระบบ" autocomplete="username" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Fullname">ชื่อ - นามสกุล</label>
                    <div class="auth-input">
                        <span class="material-symbols-outlined">badge</span>
                        <input type="text" asp-for="Fullname" class="form-control"
                               placeholder="ชื่อและนามสกุลจริง" autocomplete="name" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Phone">เบอร์โทรศัพท์</label>
                    <div class="auth-input">
                        <span class="material-symbols-outlined">call</span>
                        <input type="tel" asp-for="Phone" class="form-control"
                               placeholder="08x-xxx-xxxx" autocomplete="tel" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Password">รหัสผ่าน</label>
                    <div class="auth-input">
                        <span class="material-symbols-outlined">lock</span>
                        <input type="password" asp-for="Password" class="form-control"
                               placeholder="กำหนดรหัสผ่าน" autocomplete="new-password" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="ConfirmPassword">ยืนยันรหัสผ่าน</label>
                    <div class="auth-input">
                        <span class="material-symbols-outlined">lock</span>
                        <input type="password" asp-for="ConfirmPassword" class="form-control"
                               placeholder="กรอกรหัสผ่านอีกครั้ง" autocomplete="new-password" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary auth-submit">
                    ลงทะเบียน
                    <span class="material-symbols-outlined" style="font-size:1.15rem;">arrow_forward</span>
                </button>
            </form>

            <div class="auth-alt">
                มีบัญชีผู้ใช้อยู่แล้ว?
                <a asp-controller="Account" asp-action="Login">เข้าสู่ระบบ</a>
            </div>
        </div>
    </main>

</div>
