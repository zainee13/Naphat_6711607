@{
    ViewData["Title"] = "ภาพรวม CS";
    Layout = "_Layout";
}

<div class="page-header">
    <h1><span class="material-symbols-outlined align-middle me-2" style="color:#f59e0b;">support_agent</span>ภาพรวมฝ่ายบริการลูกค้า</h1>
    <p>ประสานงานและแก้ไขปัญหาให้ลูกค้า</p>
</div>

<!-- KPIs -->
<div class="row g-3 mb-4">
    @foreach (var k in new[] {
        ("confirmation_number","Ticket ทั้งหมด","32","เดือนนี้","#f59e0b"),
        ("pending","รอดำเนินการ","8","ใหม่ 3 ใบ","#ef4444"),
        ("cached","กำลังดำเนินการ","12","ต่อเนื่อง","#3b82f6"),
        ("check_circle","แก้ไขสำเร็จ","12","92% ใน 24 ชม.","#10b981"),
    })
    {
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:@k.Item5;">
                    <span class="material-symbols-outlined">@k.Item1</span>
                </div>
                <div class="kpi-value">@k.Item3</div>
                <div class="kpi-label">@k.Item2</div>
                <div class="kpi-change" style="color:@k.Item5;">@k.Item4</div>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <!-- Quick Access -->
    <div class="col-12 col-lg-4">
        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined" style="color:#f59e0b;">bolt</span> ดำเนินการด่วน</h2>
            </div>
            <div class="d-flex flex-column gap-2">
                @foreach (var a in new[] {
                    ("accounting","ส่งต่อฝ่ายบัญชี","10b981"),("inventory_2","ส่งต่อฝ่ายคลัง","8b5cf6"),
                    ("manage_accounts","ส่งต่อ Manager","ef4444"),("email","ส่งอีเมลลูกค้า","3b82f6"),
                })
                {
                    <button class="btn btn-sm d-flex align-items-center gap-2 text-start"
                            style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:10px; padding:0.75rem 1rem;"
                            onclick="alert('ส่งต่อ: @a.Item2')">
                        <span class="material-symbols-outlined" style="font-size:1.1rem; color:#@a.Item3;">@a.Item1</span>
                        <span style="font-size:0.85rem; font-weight:500; color:#374151;">@a.Item2</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Recent Tickets -->
    <div class="col-12 col-lg-8">
        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined" style="color:#f59e0b;">confirmation_number</span> Ticket ล่าสุด</h2>
                <a asp-controller="CustomerService" asp-action="Tickets"
                   style="font-size:0.78rem; color:#f59e0b; text-decoration:none;">ดูทั้งหมด →</a>
            </div>
            @foreach (var t in new[] {
                ("TK-032","นภัส นาวาหัสดินกุล","BK-2026-002","ปัญหาการชำระเงิน","กำลังดำเนินการ","in-progress","13 ก.ย. 13:00"),
                ("TK-031","บริษัท ABC","BK-2026-001","ขอเปลี่ยนห้อง","รอดำเนินการ","open","13 ก.ย. 11:30"),
                ("TK-030","คุณสมชาย","BK-2025-018","ต้องการใบเสร็จ","แก้ไขแล้ว","resolved","12 ก.ย. 16:00"),
                ("TK-029","ร้าน XYZ","BK-2025-009","คำถามเกี่ยวกับคืนเงิน","รอดำเนินการ","open","12 ก.ย. 14:20"),
            })
            {
                <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                    <div style="flex:1;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-semibold" style="font-size:0.78rem; color:#f59e0b;">@t.Item1</span>
                            <span class="badge-status badge-@t.Item6" style="font-size:0.68rem;">@t.Item5</span>
                        </div>
                        <div class="fw-semibold" style="font-size:0.875rem; margin-top:0.1rem;">@t.Item4</div>
                        <div style="font-size:0.75rem; color:#9ca3af;">@t.Item2 • @t.Item3 • @t.Item7</div>
                    </div>
                    <a asp-controller="CustomerService" asp-action="TicketDetail" asp-route-id="@t.Item1"
                       class="btn btn-sm" style="background:#fef3c7; color:#92400e; border:none; border-radius:8px; font-size:0.72rem; white-space:nowrap;">
                        ดูรายละเอียด
                    </a>
                </div>
            }
        </div>
    </div>
</div>
