@model List<Naphat_6507_L005.ViewModels.TicketViewModel>
@using Naphat_6507_L005.Controllers
@{
    ViewData["Title"] = "รายการ Ticket";
    Layout = "_Layout";
    var filter = ViewBag.FilterStatus as string;
}

<div class="page-header">
    <div>
        <h1><span class="material-symbols-outlined align-middle me-2" style="color:#f59e0b;">confirmation_number</span>รายการ Ticket</h1>
        <p>เรียงตั๋วที่ยังไม่ปิดก่อน ด่วนมากก่อน และใหม่สุดก่อน</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="section-card">
    <div class="section-card-header">
        <h2><span class="material-symbols-outlined" style="color:#f59e0b;">list_alt</span> ตั๋ว (@Model.Count)</h2>
        <!-- กรองตามสถานะ -->
        <div class="d-flex gap-1 flex-wrap">
            <a asp-controller="CustomerService" asp-action="Tickets"
               class="btn btn-sm @(filter == null ? "btn-dark" : "btn-outline-secondary")" style="border-radius:8px;">ทั้งหมด</a>
            @foreach (var s in CustomerServiceController.StatusText)
            {
                <a asp-controller="CustomerService" asp-action="Tickets" asp-route-status="@s.Key"
                   class="btn btn-sm @(filter == s.Key ? "btn-dark" : "btn-outline-secondary")" style="border-radius:8px;">@s.Value</a>
            }
        </div>
    </div>
    <partial name="_TicketTable" model="Model" />
</div>
