@{
    var ticketId = ViewBag.TicketId as string ?? "TK-032";
    ViewData["Title"] = $"Ticket {ticketId}";
    Layout = "_Layout";
}

<div class="page-header">
    <a asp-controller="CustomerService" asp-action="Tickets" class="btn btn-sm btn-outline-secondary mb-3" style="border-radius:8px;">
        <span class="material-symbols-outlined align-middle" style="font-size:0.9rem;">arrow_back</span> กลับ
    </a>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><span class="material-symbols-outlined align-middle me-2" style="color:#f59e0b;">confirmation_number</span>@ticketId — ปัญหาการชำระเงิน</h1>
            <div class="d-flex gap-2 mt-1">
                <span class="badge-status badge-in-progress">กำลังดำเนินการ</span>
                <span class="badge" style="background:#fee2e2; color:#991b1b; font-size:0.75rem;">🔴 Priority สูง</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm" style="width:auto; border-radius:8px;"
                    onchange="alert('เปลี่ยนสถานะ: '+this.value)">
                <option>กำลังดำเนินการ</option>
                <option>รอดำเนินการ</option>
                <option>แก้ไขแล้ว</option>
                <option>ปิด Ticket</option>
            </select>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- Ticket Detail -->
    <div class="col-12 col-lg-8">

        <!-- Info -->
        <div class="section-card mb-4">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined" style="color:#f59e0b;">info</span> ข้อมูล Ticket</h2>
            </div>
            <div class="row g-3" style="font-size:0.875rem;">
                <div class="col-md-6">
                    <div class="text-secondary small mb-1">ลูกค้า</div>
                    <div class="fw-semibold">นภัส นาวาหัสดินกุล</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small mb-1">การจองที่เกี่ยวข้อง</div>
                    <div class="fw-semibold" style="color:#3b82f6;">BK-2026-002</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small mb-1">วันที่แจ้งปัญหา</div>
                    <div>13 ก.ย. 2569 13:00 น.</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small mb-1">ผู้รับผิดชอบ (CS)</div>
                    <div class="fw-semibold">วรรณิสา บริการ</div>
                </div>
                <div class="col-12">
                    <div class="text-secondary small mb-1">รายละเอียดปัญหา</div>
                    <div class="p-3" style="background:#f8f9fa; border-radius:10px; line-height:1.7;">
                        ลูกค้าแจ้งว่าโอนเงินค่าเช่า ฿642,000 สำหรับห้อง WN-B12 เรียบร้อยแล้ว
                        เมื่อวันที่ 13 ก.ย. 2569 เวลา 09:00 น. แต่ระบบยังแสดงสถานะ "รอชำระเงิน"
                        และไม่ได้รับการยืนยันจากทีมงาน ขอให้ตรวจสอบด่วน
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline / Chat -->
        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined" style="color:#f59e0b;">forum</span> บันทึกการดำเนินการ</h2>
            </div>

            <div class="timeline mb-4">
                @foreach (var log in new[] {
                    ("นภัส นาวาหัสดินกุล","customer","ลูกค้า","แจ้งปัญหา: โอนเงินแล้วแต่ระบบไม่อัปเดต","13 ก.ย. 13:00","#3b82f6"),
                    ("วรรณิสา บริการ","cs","CS","รับเรื่องแล้ว กำลังประสานงานกับฝ่ายบัญชี","13 ก.ย. 13:15","#f59e0b"),
                    ("สมหญิง บัญชีดี","accounting","บัญชี","ตรวจสอบสลิปแล้ว พบว่าโอนเงินจริง กำลังอัปเดตระบบ","13 ก.ย. 13:45","#10b981"),
                })
                {
                    <div class="timeline-item">
                        <div class="timeline-dot" style="background:@log.Item6;"></div>
                        <div class="p-3 mb-2" style="background:@(log.Item2=="customer"?"#eff6ff":"#f8f9fa"); border-radius:10px; margin-left:0.25rem;">
                            <div class="d-flex justify-content-between mb-1">
                                <div>
                                    <strong style="font-size:0.82rem; color:@log.Item6;">@log.Item1</strong>
                                    <span class="badge ms-1" style="background:rgba(0,0,0,0.06); color:#6c757d; font-size:0.65rem;">@log.Item3</span>
                                </div>
                                <span style="font-size:0.72rem; color:#9ca3af;">@log.Item5</span>
                            </div>
                            <div style="font-size:0.85rem; color:#374151;">@log.Item4</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Reply Box -->
            <div class="border-top pt-3">
                <label class="form-label small fw-semibold">เพิ่มบันทึก / ส่งข้อความ</label>
                <textarea class="form-control mb-2" rows="3" placeholder="พิมพ์ข้อความ..."></textarea>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" style="width:auto; border-radius:8px;">
                        <option>บันทึกภายใน (CS)</option>
                        <option>ส่งหาลูกค้า</option>
                        <option>ส่งต่อบัญชี</option>
                        <option>ส่งต่อคลังสินค้า</option>
                        <option>ส่งต่อ Manager</option>
                    </select>
                    <button class="btn btn-sm"
                            style="background:#f59e0b; color:#fff; border:none; border-radius:8px; padding:0.4rem 1rem; font-weight:600;"
                            onclick="alert('ส่งข้อความสำเร็จ')">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.9rem;">send</span>
                        ส่ง
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Side Panel -->
    <div class="col-12 col-lg-4">
        <div class="section-card mb-4">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined" style="color:#f59e0b;">link</span> ส่งต่อแผนก</h2>
            </div>
            <div class="d-flex flex-column gap-2">
                @foreach (var dept in new[] {
                    ("accounting","ฝ่ายบัญชี","10b981"),("inventory_2","ฝ่ายคลัง","8b5cf6"),("insights","Manager","ef4444"),
                })
                {
                    <button class="btn btn-sm d-flex align-items-center gap-2 text-start"
                            style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:10px; padding:0.65rem 1rem;"
                            onclick="alert('ส่งต่อ: @dept.Item2')">
                        <span class="material-symbols-outlined" style="font-size:1rem; color:#@dept.Item3;">@dept.Item1</span>
                        <span style="font-size:0.82rem; font-weight:500;">@dept.Item2</span>
                    </button>
                }
            </div>
        </div>
        <div class="section-card">
            <div class="section-card-header">
                <h2><span class="material-symbols-outlined" style="color:#f59e0b;">person</span> ข้อมูลลูกค้า</h2>
            </div>
            <div style="font-size:0.82rem; line-height:2;">
                <div><strong>ชื่อ:</strong> นภัส นาวาหัสดินกุล</div>
                <div><strong>โทร:</strong> 081-234-5678</div>
                <div><strong>อีเมล:</strong> naphat@email.com</div>
                <div><strong>การจองปัจจุบัน:</strong> <span style="color:#3b82f6;">2 รายการ</span></div>
            </div>
            <button class="btn btn-sm w-100 mt-2" style="background:#eff6ff; color:#1d4ed8; border:none; border-radius:8px;"
                    onclick="alert('ดูประวัติลูกค้า')">
                ดูประวัติทั้งหมด
            </button>
        </div>
    </div>

</div>
