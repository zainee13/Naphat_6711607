@{
    ViewData["Title"] = "Inventory";
    Layout = "_AdminLayout";
}

<div class="inventory-page">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">จัดการสต็อก (Inventory/Stock)</h1>
            <p class="text-secondary mb-0">ตรวจสอบและจัดการข้อมูลสินค้าคงคลังแบบเรียลไทม์</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-light border d-flex align-items-center gap-2"><span class="material-symbols-outlined">sync</span>อัปเดตสต็อก</button>
            <button type="button" class="btn btn-primary d-flex align-items-center gap-2"><span class="material-symbols-outlined">add_box</span>บันทึกสินค้าเข้า</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4"><div class="card inventory-card h-100"><div class="card-body d-flex flex-column justify-content-between"><div class="d-flex justify-content-between align-items-start mb-4"><span class="inventory-icon inventory-icon-blue material-symbols-outlined">inventory_2</span><span class="font-monospace text-secondary">+12%</span></div><div><p class="small text-secondary mb-1">สินค้าทั้งหมด</p><p class="h3 fw-bold mb-0">14,250</p></div></div></div></div>
        <div class="col-12 col-md-4"><div class="card inventory-card h-100"><div class="card-body d-flex flex-column justify-content-between"><div class="d-flex justify-content-between align-items-start mb-4"><span class="inventory-icon inventory-icon-light material-symbols-outlined">warehouse</span><span class="font-monospace text-secondary">85% Cap</span></div><div><p class="small text-secondary mb-1">ห้องที่ใช้งานอยู่</p><p class="h3 fw-bold mb-0">34 / 40</p></div></div></div></div>
        <div class="col-12 col-md-4"><div class="card inventory-card inventory-card-alert h-100"><div class="card-body d-flex flex-column justify-content-between"><div class="d-flex justify-content-between align-items-start mb-4"><span class="inventory-icon inventory-icon-red material-symbols-outlined">warning</span><span class="font-monospace text-danger">ด่วน</span></div><div><p class="small text-secondary mb-1">สต็อกต่ำ (Low Stock)</p><p class="h3 fw-bold text-danger mb-0">12 รายการ</p></div></div></div></div>
    </div>

    <div class="card inventory-card mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3"><h2 class="h5 mb-0 d-flex align-items-center gap-2"><span class="material-symbols-outlined text-secondary">notifications_active</span>การแจ้งเตือน</h2><button type="button" class="btn btn-link btn-sm text-decoration-none">ดูทั้งหมด</button></div>
        <div class="card-body"><div class="row g-3">
            <div class="col-12 col-lg-4"><div class="alert alert-danger d-flex gap-2 align-items-start mb-0"><span class="material-symbols-outlined">error</span><div><strong>SKU-A001 ใกล้หมด</strong><br><small>เหลือเพียง 15 ชิ้นในโซน A1</small></div></div></div>
            <div class="col-12 col-lg-4"><div class="alert alert-danger d-flex gap-2 align-items-start mb-0"><span class="material-symbols-outlined">error</span><div><strong>SKU-C142 ใกล้หมด</strong><br><small>เหลือเพียง 5 ชิ้นในโซน C4</small></div></div></div>
            <div class="col-12 col-lg-4"><div class="alert alert-secondary d-flex gap-2 align-items-start mb-0"><span class="material-symbols-outlined">info</span><div><strong>รับสินค้าเข้า: Lot #492</strong><br><small>เสร็จสิ้นเมื่อ 2 ชม. ที่แล้ว</small></div></div></div>
        </div></div>
    </div>

    <div class="card inventory-card overflow-hidden">
        <div class="card-header bg-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 py-3"><h2 class="h5 mb-0">ตารางจัดการสต็อกแบบเรียลไทม์</h2><div class="input-group inventory-search"><span class="input-group-text bg-white"><span class="material-symbols-outlined">search</span></span><input type="search" class="form-control" placeholder="ค้นหารหัส หรือ ชื่อสินค้า..." aria-label="ค้นหาสินค้า"></div></div>
        <div class="table-responsive"><table class="table align-middle mb-0 inventory-table"><thead><tr><th>รหัสสินค้า (SKU)</th><th>ชื่อสินค้า</th><th class="text-end">จำนวน</th><th>ตำแหน่งจัดเก็บ</th><th>สถานะ</th><th class="text-center">จัดการ</th></tr></thead><tbody>
            <tr><td class="fw-semibold">SKU-A001</td><td>มอเตอร์อุตสาหกรรม Type X</td><td class="text-end fw-bold text-danger">15</td><td><span class="location-tag">โซน A1 - R2 - S1</span></td><td><span class="badge text-bg-danger">ใกล้หมด</span></td><td class="text-center"><button class="btn btn-sm btn-outline-primary" title="แก้ไข"><span class="material-symbols-outlined">edit</span></button></td></tr>
            <tr><td class="fw-semibold">SKU-B045</td><td>แผงวงจรควบคุมหลัก V2</td><td class="text-end">450</td><td><span class="location-tag">โซน B2 - R1 - S4</span></td><td><span class="badge text-bg-success">ปกติ</span></td><td class="text-center"><button class="btn btn-sm btn-outline-primary" title="แก้ไข"><span class="material-symbols-outlined">edit</span></button></td></tr>
            <tr><td class="fw-semibold">SKU-C142</td><td>น็อตสแตนเลส M8 (กล่อง)</td><td class="text-end fw-bold text-danger">5</td><td><span class="location-tag">โซน C4 - R5 - S2</span></td><td><span class="badge text-bg-danger">วิกฤต</span></td><td class="text-center"><button class="btn btn-sm btn-outline-primary" title="แก้ไข"><span class="material-symbols-outlined">edit</span></button></td></tr>
            <tr><td class="fw-semibold">SKU-D099</td><td>สายพานลำเลียง 5M</td><td class="text-end">120</td><td><span class="location-tag">โซน D1 - R1 - S1</span></td><td><span class="badge text-bg-success">ปกติ</span></td><td class="text-center"><button class="btn btn-sm btn-outline-primary" title="แก้ไข"><span class="material-symbols-outlined">edit</span></button></td></tr>
            <tr><td class="fw-semibold">SKU-E210</td><td>เซ็นเซอร์ตรวจจับระยะ</td><td class="text-end fw-bold text-warning">45</td><td><span class="location-tag">โซน E3 - R2 - S3</span></td><td><span class="badge text-bg-warning">เฝ้าระวัง</span></td><td class="text-center"><button class="btn btn-sm btn-outline-primary" title="แก้ไข"><span class="material-symbols-outlined">edit</span></button></td></tr>
        </tbody></table></div>
        <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 py-3"><small class="text-secondary">แสดง 1 ถึง 5 จาก 14,250 รายการ</small><div class="btn-group"><button type="button" class="btn btn-outline-secondary btn-sm" disabled>ก่อนหน้า</button><button type="button" class="btn btn-outline-primary btn-sm">ถัดไป</button></div></div>
    </div>
</div>

