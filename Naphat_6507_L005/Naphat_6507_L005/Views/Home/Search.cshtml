@section Scripts {
<script>
let currentSize = 'all';

function filterBySize(size, btn) {
    currentSize = size;
    document.querySelectorAll('.filter-pill').forEach(b => {
        b.classList.remove('btn-primary', 'active');
        b.classList.add('btn-outline-secondary');
    });
    btn.classList.remove('btn-outline-secondary');
    btn.classList.add('btn-primary', 'active');
    document.getElementById('selectSize').value = size;
    applyFilter();
}

function filterRooms() {
    currentSize = document.getElementById('selectSize').value;
    document.querySelectorAll('.filter-pill').forEach(b => {
        b.classList.remove('btn-primary', 'active');
        b.classList.add('btn-outline-secondary');
    });
    applyFilter();
}

function applyFilter() {
    const size = currentSize;
    const price = document.getElementById('selectPrice').value;
    const cards = document.querySelectorAll('.room-card-item');

    cards.forEach(card => {
        const itemSize = card.getAttribute('data-size');
        const itemPrice = parseInt(card.getAttribute('data-price'));

        let matchSize = (size === 'all' || itemSize === size);
        let matchPrice = true;
        if (price === 'under20k') matchPrice = itemPrice < 20000;
        else if (price === '20k-50k') matchPrice = itemPrice >= 20000 && itemPrice <= 50000;
        else if (price === '50k-100k') matchPrice = itemPrice > 50000 && itemPrice <= 100000;
        else if (price === 'over100k') matchPrice = itemPrice > 100000;

        if (matchSize && matchPrice) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });
}
</script>
}
