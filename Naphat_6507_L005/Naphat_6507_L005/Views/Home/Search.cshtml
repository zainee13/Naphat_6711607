                        <div class="col-6"><small class="text-secondary d-block">ราคาเช่า/เดือน</small><strong class="text-primary">฿38,000</strong></div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Home" asp-action="Secirity" class="btn btn-primary flex-fill" style="border-radius:8px;">จองทันที</a>
