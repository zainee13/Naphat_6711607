@{
    ViewData["Title"] = "เลือกเช่าห้องตามขนาด — คลังสินค้าของเรา";
    Layout = "_Layout";
}

<div class="customer-page">
    <div class="mb-4">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <div>
                <h1 class="h2 fw-bold text-primary mb-1">
                    <span class="material-symbols-outlined align-middle me-2">view_cozy</span>
                    เลือกเช่าห้องคลังสินค้าตามขนาด
                </h1>
                <p class="text-secondary mb-0">คลังสินค้าโครงการของเราเอง — เลือกขนาดพื้นที่จัดเก็บตามความต้องการของธุรกิจคุณ พร้อมเข้าใช้งานได้ทันที</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined">local_offer</span>
                    โปรโมชั่น
                </a>
                <a asp-controller="Home" asp-action="Secirity" class="btn btn-primary d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined">login</span>
                    เข้าสู่ระบบ
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Size Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-sm btn-primary px-3 filter-pill active" onclick="filterBySize('all', this)" style="border-radius:20px;">
            ทุกขนาดห้อง
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary px-3 filter-pill" onclick="filterBySize('s', this)" style="border-radius:20px;">
            📦 ไซส์ S (30 - 80 ตร.ม.)
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary px-3 filter-pill" onclick="filterBySize('m', this)" style="border-radius:20px;">
            🏭 ไซส์ M (100 - 250 ตร.ม.)
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary px-3 filter-pill" onclick="filterBySize('l', this)" style="border-radius:20px;">
            🚚 ไซส์ L (300 - 500 ตร.ม.)
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary px-3 filter-pill" onclick="filterBySize('xl', this)" style="border-radius:20px;">
            ⚡ ไซส์ XL (600+ ตร.ม.)
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary px-3 filter-pill" onclick="filterBySize('cold', this)" style="border-radius:20px;">
            ❄️ ห้องเย็น / ปรับอุณหภูมิ
        </button>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-semibold text-secondary">
                        <span class="material-symbols-outlined align-middle" style="font-size:1rem;">square_foot</span>
                        ระดับขนาดห้อง
                    </label>
                    <select class="form-select" id="selectSize" onchange="filterRooms()">
                        <option value="all">ทุกขนาดห้อง</option>
                        <option value="s">ไซส์ S (30 - 80 ตร.ม.) สำหรับ SME / สต็อกย่อย</option>
                        <option value="m">ไซส์ M (100 - 250 ตร.ม.) วางพาเลทมาตรฐาน</option>
                        <option value="l">ไซส์ L (300 - 500 ตร.ม.) คลังใหญ่ มี Dock</option>
                        <option value="xl">ไซส์ XL (600 - 1,200 ตร.ม.) เมกะแวร์เฮ้าส์</option>
                        <option value="cold">ห้องเย็นควบคุมอุณหภูมิ (-18°C ถึง +5°C)</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-semibold text-secondary">
                        <span class="material-symbols-outlined align-middle" style="font-size:1rem;">payments</span>
                        ช่วงราคาเช่า / เดือน
                    </label>
                    <select class="form-select" id="selectPrice" onchange="filterRooms()">
                        <option value="all">ทุกช่วงราคา</option>
                        <option value="under20k">น้อยกว่า 20,000 บาท</option>
                        <option value="20k-50k">20,000 - 50,000 บาท</option>
                        <option value="50k-100k">50,000 - 100,000 บาท</option>
                        <option value="over100k">มากกว่า 100,000 บาท</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <button type="button" class="btn btn-primary w-100 d-flex justify-content-center align-items-center gap-2" onclick="filterRooms()" style="border-radius:8px; height:38px;">
                        <span class="material-symbols-outlined">filter_list</span>
                        กรองห้องว่าง
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Units Cards -->
    <div class="row g-4" id="roomGrid">
        <!-- Room S-01 -->
        <div class="col-12 col-md-6 col-xl-4 room-card-item" data-size="s" data-price="12000">
            <div class="card h-100 border-0 shadow-sm overflow-hidden" style="border-radius:14px;">
                <div style="position:relative; height:200px;">
                    <img style="width:100%; height:100%; object-fit:cover;" src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=600&q=80" alt="Unit S-01">
                    <span class="badge bg-primary position-absolute top-0 start-0 m-2 px-2 py-1">📦 ไซส์ S</span>
                </div>
                <div class="card-body d-flex flex-column">
                    <span class="badge text-bg-success align-self-start mb-2"><span class="material-symbols-outlined align-middle small">check_circle</span> ว่างพร้อมใช้</span>
                    <h2 class="h5 text-primary mb-1">Unit S-01 (ห้องขนาดกะทัดรัด)</h2>
                    <p class="text-secondary small">เหมาะสำหรับธุรกิจออนไลน์ SME หรือจัดเก็บเอกสารและสต็อกย่อย โซน A1</p>
